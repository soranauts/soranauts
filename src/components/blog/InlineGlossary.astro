---
// Inline Glossary Component
// Simple inline tooltip for SORA terms within articles

import { getGlossaryTerm } from '~/data/sora-glossary';

export interface Props {
  term: string;
  class?: string;
}

const { term, class: className = '' } = Astro.props;

const glossaryData = getGlossaryTerm(term);

if (!glossaryData) {
  // If term not found, just return the term as plain text
  console.warn(`Glossary term "${term}" not found in SORA glossary`);
  ---
  <span class={className}>{term}</span>
  ---
} else {
  const { definition, category, relatedTerms } = glossaryData;
  
  // Category styling
  const categoryStyles = {
    token: 'border-blue-200 dark:border-blue-800',
    technology: 'border-green-200 dark:border-green-800',
    governance: 'border-purple-200 dark:border-purple-800',
    defi: 'border-orange-200 dark:border-orange-800',
    network: 'border-indigo-200 dark:border-indigo-800',
    economics: 'border-pink-200 dark:border-pink-800'
  };

  const categoryStyle = categoryStyles[category] || categoryStyles.technology;
  ---
  <span 
    class={`inline-glossary-term inline-block cursor-help border-b border-dotted border-gray-400 dark:border-gray-500 hover:border-gray-600 dark:hover:border-gray-400 transition-colors duration-200 ${categoryStyle} ${className}`}
    data-glossary-term={term}
    data-glossary-definition={definition}
    data-glossary-category={category}
    data-glossary-related={relatedTerms.join(',')}
    title={`${term} - Click for definition`}
  >
    {term}
  </span>

  <style>
    .inline-glossary-term {
      position: relative;
    }

    .inline-glossary-term:hover::after {
      content: attr(data-glossary-definition);
      position: absolute;
      bottom: 100%;
      left: 50%;
      transform: translateX(-50%);
      background: white;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      padding: 12px 16px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
      z-index: 1000;
      min-width: 200px;
      max-width: 300px;
      font-size: 14px;
      line-height: 1.4;
      color: #374151;
      white-space: normal;
      word-wrap: break-word;
      pointer-events: none;
      opacity: 0;
      animation: fadeInTooltip 0.2s ease-in-out forwards;
    }

    .dark .inline-glossary-term:hover::after {
      background: #1f2937;
      border-color: #374151;
      color: #f9fafb;
    }

    @keyframes fadeInTooltip {
      from {
        opacity: 0;
        transform: translateX(-50%) translateY(5px);
      }
      to {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
      }
    }

    /* Category-specific styling */
    .inline-glossary-term[data-glossary-category="token"]:hover::after {
      border-left: 4px solid #3b82f6;
    }

    .inline-glossary-term[data-glossary-category="technology"]:hover::after {
      border-left: 4px solid #10b981;
    }

    .inline-glossary-term[data-glossary-category="governance"]:hover::after {
      border-left: 4px solid #8b5cf6;
    }

    .inline-glossary-term[data-glossary-category="defi"]:hover::after {
      border-left: 4px solid #f59e0b;
    }

    .inline-glossary-term[data-glossary-category="network"]:hover::after {
      border-left: 4px solid #6366f1;
    }

    .inline-glossary-term[data-glossary-category="economics"]:hover::after {
      border-left: 4px solid #ec4899;
    }
  </style>
  ---
}
