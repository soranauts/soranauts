---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import Announcement from '~/components/widgets/Announcement.astro';
import SchemaMarkup from '~/components/SEO/SchemaMarkup.astro';
import { SITE } from '~/utils/config';

import { headerData, footerData } from '~/navigation';

import type { MetaData, Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
  metadata?: MetaData;
}

const { post, url, metadata = {} } = Astro.props;

// Calculate word count (rough estimate)
const wordCount = post.content ? post.content.split(/\s+/).filter(word => word.length > 0).length : 100;

// Create enhanced metadata for the blog post
const enhancedMetadata = {
  ...metadata,
  title: post.title,
  description: post.excerpt,
  image: post.image,
  url: String(url),
  type: 'article',
  publishedTime: post.publishDate.toISOString(),
  modifiedTime: post.updateDate?.toISOString(),
  author: "Soranauts",
  category: post.category,
  tags: post.tags,
  readingTime: post.readingTime,
  wordCount: wordCount
};
---

<Layout metadata={enhancedMetadata}>
  <!-- Article Schema Markup -->
  <SchemaMarkup
    type="article"
    data={{
      title: post.title,
      description: post.excerpt,
      image: typeof post.image === 'string' ? post.image : (post.image?.src || post.image),
      url: String(url),
      publishedTime: post.publishDate.toISOString(),
      modifiedTime: post.updateDate?.toISOString(),
      author: "Soranauts",
      category: post.category,
      tags: post.tags,
      wordCount: wordCount,
      readingTime: post.readingTime
    }}
  />

  <!-- Twitter Image Meta Tag for Blog Posts -->
  <meta name="twitter:image" content={typeof post.image === 'string' ? (post.image.startsWith('http') ? post.image : (post.image.startsWith('~/assets/images/') ? `${SITE.site}${post.image.replace('~/assets/images/', '/assets/images/')}` : `${SITE.site}${post.image}`)) : (post.image?.src ? `${SITE.site}${post.image.src}` : `${SITE.site}/assets/images/soranauts-social-share.jpg`)} />

  <!-- Breadcrumb Schema -->
  <SchemaMarkup
    type="breadcrumb"
    data={{ breadcrumbs: [{ name: 'Blog', url: '/blog' }] }}
  />

  <slot name="announcement">
    <Announcement />
  </slot>
  <slot name="header">
    <Header {...headerData} isSticky showRssFeed showToggleTheme />
  </slot>
  <main>
    <slot />
  </main>
  <slot name="footer">
    <Footer {...footerData} />
  </slot>
</Layout>
