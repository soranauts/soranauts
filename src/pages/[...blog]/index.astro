---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import merge from 'lodash.merge';
import type { ImageMetadata } from 'astro';
import Layout from '~/layouts/BlogPostLayout.astro';
import SinglePost from '~/components/blog/SinglePost.astro';
import ToBlogLink from '~/components/blog/ToBlogLink.astro';

import { getCanonical, getPermalink } from '~/utils/permalinks';
import { getStaticPathsBlogPost, blogPostRobots } from '~/utils/blog';
import { findImage } from '~/utils/images';
import { SITE } from '~/utils/config';
import type { MetaData } from '~/types';

export const prerender = true;

export const getStaticPaths = (async () => {
  return await getStaticPathsBlogPost();
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props as Props;

const url = getCanonical(getPermalink(post.permalink || post.slug, 'post'));
const image = (await findImage(post.image)) as ImageMetadata | string | undefined;

// Convert processed image to direct URL for Open Graph
const getDirectImageUrl = (): string => {
  // Use the original post.image path directly, not the processed findImage result
  if (!post.image) return `${SITE.site}/soranauts-social-share.jpg`;
  if (typeof post.image === 'string') {
    if (post.image.startsWith('http')) return post.image;
    if (post.image.startsWith('~/assets/images/')) {
      return `${SITE.site}${post.image.replace('~/assets/images/', '/')}`;
    }
    return `${SITE.site}${post.image}`;
  }
  // Fallback to social share image
  return `${SITE.site}/soranauts-social-share.jpg`;
};

const directImageUrl = getDirectImageUrl();

const metadata = merge(
  {
    title: post.title,
    description: post.excerpt,
    canonical: url, // Always use the correct canonical URL
    robots: {
      index: blogPostRobots?.index,
      follow: blogPostRobots?.follow,
    },
    openGraph: {
      type: 'article',
      ...(directImageUrl ? { images: [{ url: directImageUrl, width: 1200, height: 630 }] } : {}),
    },
  },
  { ...(post?.metadata ? { ...post.metadata } : {}) }
) as MetaData;
---

<Layout post={{ ...post, image: image, originalImage: post.image }} url={url} metadata={metadata}>
  <SinglePost post={{ ...post, image: image }} url={url} />
  <ToBlogLink />
</Layout>
