<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SEO Testing Tool - Soranauts</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 40px; line-height: 1.6; }
    .test-result { margin: 10px 0; padding: 10px; border-radius: 5px; }
    .pass { background-color: #d4edda; border: 1px solid #c3e6cb; }
    .fail { background-color: #f8d7da; border: 1px solid #f5c6cb; }
    .score { font-size: 24px; font-weight: bold; margin: 20px 0; }
    .recommendations { background-color: #fff3cd; border: 1px solid #ffeaa7; padding: 15px; border-radius: 5px; margin: 20px 0; }
    button { background-color: #007bff; color: white; padding: 10px 20px; border: none; border-radius: 5px; cursor: pointer; margin: 10px 0; }
    button:hover { background-color: #0056b3; }
  </style>
</head>
<body>
  <h1>🔍 SEO Testing Tool</h1>
  <p>This tool helps you test the SEO of your pages. Click the button below to run an audit on the current page.</p>
  
  <button onclick="runSEOAudit()">Run SEO Audit</button>
  
  <div id="results"></div>
  
  <h2>📋 Manual SEO Checklist</h2>
  <ul>
    <li>✅ Title tag (30-60 characters)</li>
    <li>✅ Meta description (120-160 characters)</li>
    <li>✅ H1 heading (one per page)</li>
    <li>✅ Image alt text</li>
    <li>✅ Internal links</li>
    <li>✅ Schema markup</li>
    <li>✅ Open Graph tags</li>
    <li>✅ Twitter Card tags</li>
    <li>✅ Canonical URL</li>
    <li>✅ Mobile-friendly</li>
  </ul>
  
  <h2>🛠️ Testing Tools</h2>
  <ul>
    <li><a href="https://search.google.com/test/rich-results" target="_blank">Google Rich Results Test</a></li>
    <li><a href="https://developers.google.com/speed/pagespeed/insights/" target="_blank">PageSpeed Insights</a></li>
    <li><a href="https://validator.w3.org/" target="_blank">W3C Markup Validator</a></li>
    <li><a href="https://www.screamingfrog.co.uk/seo-spider/" target="_blank">Screaming Frog SEO Spider</a></li>
  </ul>

  <script>
    // SEO Testing Functions
    function testTitleTag() {
      const title = document.querySelector('title')?.textContent || '';
      if (!title) return { passed: false, message: "Missing title tag" };
      if (title.length < 30) return { passed: false, message: "Title too short" };
      if (title.length > 60) return { passed: false, message: "Title too long" };
      return { passed: true, message: "Title tag is optimal" };
    }

    function testMetaDescription() {
      const metaDescription = document.querySelector('meta[name="description"]')?.getAttribute('content') || '';
      if (!metaDescription) return { passed: false, message: "Missing meta description" };
      if (metaDescription.length < 120) return { passed: false, message: "Meta description too short" };
      if (metaDescription.length > 160) return { passed: false, message: "Meta description too long" };
      return { passed: true, message: "Meta description is optimal" };
    }

    function testHeadingStructure() {
      const headings = Array.from(document.querySelectorAll('h1, h2, h3, h4, h5, h6'));
      if (headings.length === 0) return { passed: false, message: "No headings found" };
      
      const h1Count = headings.filter(h => h.tagName === 'H1').length;
      if (h1Count === 0) return { passed: false, message: "No H1 heading found" };
      if (h1Count > 1) return { passed: false, message: "Multiple H1 headings found" };
      
      return { passed: true, message: "Heading structure is good" };
    }

    function testImageAltText() {
      const images = Array.from(document.querySelectorAll('img'));
      const imagesWithoutAlt = images.filter(img => !img.alt);
      
      if (imagesWithoutAlt.length > 0) {
        return { passed: false, message: `${imagesWithoutAlt.length} images missing alt text` };
      }
      
      return { passed: true, message: "All images have alt text" };
    }

    function testSchemaMarkup() {
      const schemaScripts = document.querySelectorAll('script[type="application/ld+json"]');
      if (schemaScripts.length === 0) return { passed: false, message: "No schema markup found" };
      
      return { passed: true, message: `${schemaScripts.length} schema markup(s) found` };
    }

    function runSEOAudit() {
      const results = [
        testTitleTag(),
        testMetaDescription(),
        testHeadingStructure(),
        testImageAltText(),
        testSchemaMarkup()
      ];
      
      const passedTests = results.filter(r => r.passed).length;
      const score = Math.round((passedTests / results.length) * 100);
      
      const resultsDiv = document.getElementById('results');
      resultsDiv.innerHTML = `
        <div class="score">SEO Score: ${score}/100</div>
        <h3>Test Results:</h3>
        ${results.map((result, index) => `
          <div class="test-result ${result.passed ? 'pass' : 'fail'}">
            ${result.passed ? '✅' : '❌'} ${index + 1}. ${result.message}
          </div>
        `).join('')}
        
        <div class="recommendations">
          <h3>💡 Recommendations:</h3>
          <ul>
            ${results.filter(r => !r.passed).map(r => `<li>${r.message}</li>`).join('')}
            ${results.filter(r => !r.passed).length === 0 ? '<li>All tests passed! Great job! 🎉</li>' : ''}
          </ul>
        </div>
      `;
    }
  </script>
</body>
</html>
