---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
/** import Features2 from '~/components/widgets/Features2.astro'; **/
import Steps from '~/components/widgets/Steps.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Soranauts | SORA Blockchain & Polkaswap Onboarding Initiative',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Try Polkaswap',
        href: 'https://polkaswap.io/',
        target: '_blank',
      },
      { text: 'Learn More', href: '#features' },
    ]}
    image={{ src: '~/assets/images/polkaswap-sora-blockchain.jpg', alt: 'Unlock the Future of Interoperability with SORA and Polkaswap' }}
  >
    <Fragment slot="title">
      Unlock the Future of Interoperability with SORA and Polkaswap
    </Fragment>

    <Fragment slot="subtitle">
      Step into a new era of financial technology with SORA and Polkaswap, your dynamic duo for seamless crypto interoperability. 
      This isn’t just about bridging gaps between digital currencies; it’s about unifying an entire ecosystem under one, user-centric platform. 
      It’s about a vision for a future where financial freedom is in the hands of the many, not the few.
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="Features"
    title="What You Get with the SORA Economic Model"
    subtitle="SORA is building a next-generation blockchain ecosystem designed specifically for decentralized applications in finance, economics, and beyond."
    items={[
      {
        title: 'Supranational Economic System',
        description:
          'The SORA <a href="https://wiki.sora.org/sora-economy.html" class="font-medium text-indigo-500 dark:text-indigo-400 hover:underline">economic model</a> is built with the intention to create a supranational world economic system. The concept was ratified by the SORA community under an upgrade named "SORA: The New Economic Order".',
        icon: 'tabler:building-bank',
      },
      {
        title: 'Token Bonding Curve',
        description:
          'The SORA economic system uses a <a href="https://soranauts.com/soras-token-bonding-curve-dollar-tbcd-explained" class="font-medium text-indigo-500 dark:text-indigo-400 hover:underline">token bonding curve</a> to regulate the issuance and de-issuance of XOR tokens. This approach ensures a rational way of managing the token supply, promoting stability in the token\'s value over time.',
        icon: 'tabler:chart-bar',
      },
      {
        title: 'On-chain Governance',
        description:
          'SORA is building an on-chain <a href="https://wiki.sora.org/sora-governance.html" class=\"font-medium text-indigo-500 dark:text-indigo-400 hover:underline\">governance</a> system based on the XOR token. This system empowers token holders to decide on the allocation of XOR for the creation of goods and services, thereby democratizing the economic decision-making process.',
        icon: 'tabler:file-invoice',
      },
      {
        title: 'Financial Inclusion',
        description:
          'SORA envisions an economic order that offers <a href="https://wiki.sora.org/introduction.html" class="font-medium text-indigo-500 dark:text-indigo-400 hover:underline">financial inclusion</a> to all. The decentralized and democratic structure of the model allows for broad participation, ensuring that every participant has a say in the economic decision-making.',
        icon: 'tabler:building-monument',
      },
      {
        title: 'Credit Creation',
        description: 'The SORA economic model believes in credit creation for producing new goods or services. This approach adheres to the Disaggregated General Quantity <a href="https://www.youtube.com/watch?v=KEfdlctvHH4https://twitter.com/polkaswap/status/1730182491074630048https://twitter.com/polkaswap/status/1730182491074630048" class="font-medium text-indigo-500 dark:text-indigo-400 hover:underline">Theory of Credit</a> in macroeconomics, which posits that money supply has a direct impact on price levels. By creating credit for production, SORA aims to stimulate economic growth and development.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'XOR as Legal Tender',
        description:
          'XOR, the native token of the SORA network, is positioned as a supranational currency. The use of <a href="https://wiki.sora.org/introduction.html#the-case-for-xor" class="font-medium text-indigo-500 dark:text-indigo-400 hover:underline">XOR as legal tender</a> can lead to increased economic growth without the burden of debt. This feature makes XOR a viable funding option for productive investments, facilitated through an open governance process.',
        icon: 'tabler:wallet',
      },
    ]}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    title="Seamlessly Bridge Assets from Ethereum to Polkaswap Using HASHI Technology"
    items={[
      {
        title: 'Step 1: <span class="font-medium">Set Up Connection</span>',
        description:
          'First, you need to <a href="https://polkaswap.io/#/wallet" class=\"font-medium text-indigo-500 dark:text-indigo-400 hover:underline\">connect</a> your Ethereum wallet (or other wallets in the list) that holds your tokens to the Polkaswap site. Click \"Connect Wallet\" and select the wallet provider you used on Ethereum like MetaMask. Make sure it has the assets you want to bridge over.',
        icon: 'tabler:network',
      },
      {
        title: 'Step 2: <span class="font-medium">Initiate Bridge Transfer</em>',
        description:
          'After connecting, click \"Bridge\" and select the asset & amount you want to bridge from Ethereum to Polkaswap. Enter the Polkadot address you want the tokens bridged to. Approve the transaction in your connected Ethereum wallet. For more information, check out this <a href="https://medium.com/polkaswap-community-collective/how-to-use-the-hashi-bridge-eb69e88bc87" class="font-medium text-indigo-500 dark:text-indigo-400 hover:underline">detailed guide</a>.',
        icon: 'tabler:building-bridge-2',
      },
      {
        title: 'Step 3: <span class="font-medium">Track Bridge Status</span>',
        description:
          'Once initiated, you can track the progress of your asset bridge by viewing your recent Polkaswap <a href="https://twitter.com/polkaswap/status/1730182491074630048" class="font-medium text-indigo-500 dark:text-indigo-400 hover:underline">transactions</a>. It may take a few minutes to reflect. After it processes successfully, your chosen ERC-20 tokens will become available in your Polkadot wallet!',
        icon: 'tabler:status-change',
      },
      {
        title: 'Ready!',
        description:
          'And that\'s it! In just 3 steps - connect wallet, initiate bridge, track transfer - you can seamlessly bring assets from Ethereum over to the interoperable Polkaswap DEX. <a href="https://t.me/polkaswap" class="font-medium text-indigo-500 dark:text-indigo-400 hover:underline">Let us know</a> if you need any clarification or have additional questions!',
        icon: 'tabler:circle-check',
      },
    ]}
    image={{
      src: '~/assets/images/polkaswap-HASHI-bridge.jpg',
      alt: 'Seamlessly Bridge Assets from Ethereum to Polkaswap Using HASHI Technology',
    }}
  />
  
  <!-- Features2 Widget
  
  ************** -->
  
  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts
    title="Expand expertise on SORA, Polkaswap and web3 in our crypto education blog"
    information={`Our blog serves as an ever-growing knowledge hub focused on building literacy across core concepts and tools in the decentralized space. Read up on the latest deep dives explaining how SORA's innovations like cross-chain liquidity and XOR staking work under the hood.
                `}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Frequently Asked Questions"
    subtitle="SORA's Next-Generation Cryptoeconomy"
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'What is the relationship between SORA and Polkadot networks?',
        description:
          "SORA utilizes Polkadot's Substrate framework to build its blockchain technology. It's designed to eventually integrate (very soon) with the Polkadot ecosystem using bridges and other cross-chain features.",
      },
      {
        title: 'What is Polkaswap?',
        description:
          'Polkaswap is a decentralized exchange (DEX) built on the SORA network. It allows for trading cryptocurrency token pairs in a permissionless manner through liquidity pools rather than traditional order books.',
      },
      {
        title: 'What fee structure does trading on Polkaswap have?',
        description:
          "Trading fees on Polkaswap use the PSWAP token. Fees are 0.3% per trade for takers, while maker trades earn a 0.15% rebate on fees. 4% of fees are burned and others go towards incentives and operations.",
      },
      {
        title: "How can I store and access SORA tokens?",
        description:
          "SORA tokens can be stored in wallets like the SORA Wallet or Fearless Wallet. These wallets provide easy access to SORA's network and DeFi tools.",
      },
      {
        title: 'What types of staking rewards are available with SORA?',
        description:
          "There are validation, liquidity mining, and fixed APY locking options for yields. Validators also earn some transaction fees from the network.",
      },
      {
        title: 'Does Polkaswap support integration with hardware wallets?',
        description:
          "At this time, Polkaswap does not offer direct integration with popular hardware wallets like Ledger or Trezor. There is currently no option to connect those devices to Polkaswap.",
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get Started',
        href: 'https://wiki.sora.org/polkaswap.html',
        target: '_blank',
        icon: 'tabler:outbound',
      },
    ]}
  >
    <Fragment slot="title">
      Try Polkaswap Today
    </Fragment>

    <Fragment slot="subtitle">
      Tap into the revolutionary convenience of a genuinely decentralized exchange where you alone control your assets, directly access unique crypto opportunities, and partake in the next-gen ecosystem reshaping finance.
    </Fragment>
  </CallToAction>
</Layout>
