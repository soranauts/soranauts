{
  "name": "@soranauts/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4321 --host",
    "build:static": "astro build",
    "build": "pnpm run build:static && tsx scripts/check-dist-no-aliases.ts",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "generate:glossary": "tsx scripts/generate-glossary-json.ts",
    "index:glossary": "pnpm generate:glossary",
    "glossary:typesense": "node scripts/switch-glossary.js typesense",
    "glossary:fallback": "node scripts/switch-glossary.js fallback",
    "prebuild": "pnpm generate:glossary && pnpm web:glossary:redirects && pnpm web:tags:build && tsx scripts/validate-taxonomy.ts && pnpm og:build && pnpm og:manifest && (node -e \"if(process.env.SKIP_OG_VALIDATION) process.exit(0)\" || true) && pnpm og:validate",
    "sitemap:glossary": "tsx scripts/generate-glossary-sitemaps.ts",
    "verify:og": "tsx scripts/validate-og.ts",
    "verify:nexus": "bash ../../tools/verify_nexus_glossary.sh https://soranauts.com",
    "verify:nexus:preview": "bash ../../tools/verify_nexus_glossary.sh $PREVIEW_URL",
    "og:build": "tsx scripts/build-og.ts",
    "og:build-glossary": "tsx scripts/build-og-glossary.ts",
    "og:manifest": "tsx scripts/build-og-manifest.ts",
    "og:validate": "tsx scripts/validate-og.ts",
    "check:redirects": "bash scripts/check-redirects.sh",
    "check:canonical": "node scripts/check-canonical.js",
    "test": "vitest",
    "test:unit": "vitest run",
    "pretest:e2e": "tsx scripts/prep-e2e-tag-hub.ts",
    "test:e2e": "playwright test --reporter=line",
    "e2e": "playwright test --reporter=line",
    "e2e:glossary": "playwright test tests/e2e/glossary*.spec.ts --reporter=line",
    "e2e:explorer": "playwright test tests/e2e/explorer*.spec.ts --reporter=line",
    "e2e:quickview": "playwright test tests/e2e/glossary.quickview.spec.ts --reporter=line",
    "e2e:routing": "playwright test tests/e2e/glossary.routing.spec.ts --reporter=line",
    "e2e:all": "playwright test tests/e2e/glossary*.spec.ts tests/e2e/explorer*.spec.ts --reporter=line",
    "e2e:perf": "playwright test tests/e2e/perf.budgets.spec.ts --reporter=line",
    "test:glossary": "vitest tests/unit/glossary",
    "test:cross": "vitest --run --config vitest.config.ts --dir tests/cross",
    "web:taxonomy:validate": "tsx scripts/validate-taxonomy.ts",
    "update:canonical-tags": "tsx scripts/update-canonical-tags.ts --write --expect 52 --include-related",
    "update:canonical-tags:dry": "tsx scripts/update-canonical-tags.ts --dry-run --expect 52 --include-related",
    "taxonomy:consistency": "tsx scripts/taxonomy-consistency-report.ts",
    "taxonomy:update-articles": "tsx scripts/update-article-tags.ts",
    "taxonomy:update-articles:apply": "tsx scripts/update-article-tags.ts --apply",
    "links:report": "tsx scripts/link-hygiene-report.ts",
