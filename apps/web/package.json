    "web:glossary:redirects": "tsx scripts/glossary-redirects.ts",
    "web:glossary:index": "pnpm generate:glossary",
    "web:tags:build": "tsx scripts/build-tag-stats.ts",
    "web:tags:test": "vitest run tests/unit/tags",
    "web:glossary:determinism": "tsx scripts/check-glossary-determinism.ts",
    "glossary:autolink:check": "tsx scripts/glossary-autolink-check.ts",
    "glossary:relations:build": "tsx scripts/rebuild-article-tag-relations.ts",
    "web:related:suggest": "tsx scripts/related-tags-suggest.ts",
    "web:test:related": "vitest run -t related",
    "kb:ingest": "cd ../.. && tsx knowledge_base/scripts/ingest.ts",
    "kb:update": "cd ../.. && bash knowledge_base/scripts/update-kb.sh",
    "kb:retrieve": "cd ../.. && tsx knowledge_base/scripts/retrieve.ts",
    "kb:backtest": "cd ../.. && tsx knowledge_base/scripts/backtest.ts",
    "kb:sync:medium": "cd ../.. && tsx knowledge_base/scripts/medium_import.ts",
    "kb:sync:medium:archive": "cd ../.. && tsx knowledge_base/scripts/medium_import.ts --archive",
    "kb:sync:polkaswap": "cd ../.. && tsx knowledge_base/scripts/medium_import.ts --publication polkaswap",
    "kb:sync:fearless": "cd ../.. && tsx knowledge_base/scripts/medium_import.ts --publication fearless",
    "kb:sync:fearless:github": "cd ../.. && tsx knowledge_base/scripts/fearless_github_sync.ts",
    "kb:check:medium": "cd ../.. && tsx knowledge_base/scripts/check_medium_status.ts",
    "kb:sync:wiki": "cd ../.. && tsx knowledge_base/scripts/sora_wiki_sync.ts",
    "kb:sync:iroha": "cd ../.. && tsx knowledge_base/scripts/iroha_docs_sync.ts",
    "kb:sync:soramitsu": "cd ../.. && tsx knowledge_base/scripts/soramitsu_scrape.ts",
    "kb:sync:tonswap": "cd ../.. && tsx knowledge_base/scripts/tonswap_scrape.ts",
    "kb:sync:tonswap:medium": "cd ../.. && tsx knowledge_base/scripts/medium_import.ts --publication tonswap",
    "kb:sync:updates": "cd ../.. && tsx knowledge_base/scripts/sync_updates.ts",
    "kb:sync:updates:dry": "cd ../.. && tsx knowledge_base/scripts/sync_updates.ts --dry-run",
    "kb:sync:updates:report": "cd ../.. && tsx knowledge_base/scripts/sync_updates.ts --report",
    "kb:verify": "cd ../.. && tsx knowledge_base/scripts/retrieve.ts --selftest",
    "kb:lint": "cd ../.. && biome check knowledge_base --write",
    "kb:backtest:pr": "cd ../.. && tsx knowledge_base/scripts/backtest.ts --pr-diff --sarif",
    "kb:test:determinism": "cd ../.. && bash knowledge_base/scripts/tests/determinism.sh",
    "kb:test:retrieval": "cd ../.. && tsx knowledge_base/scripts/tests/test-retrieval-golden.ts",
    "kb:bm25:build": "cd ../.. && tsx knowledge_base/scripts/bm25.ts --build",
    "kb:hero": "cd ../.. && tsx knowledge_base/scripts/image_wide_hero.ts",
    "kb:pdf:import": "cd ../.. && tsx knowledge_base/scripts/pdf_import.ts",
    "kb:bck24:import": "node ../../knowledge_base/scripts/bck24_import_node.cjs",
    "kb:migrate": "node ../../knowledge_base/scripts/run-migrate.cjs",
    "kb:validate": "node ../../knowledge_base/scripts/run-validate.cjs"
  },
