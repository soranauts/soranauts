---
import { twMerge } from 'tailwind-merge';
import type { ItemGrid } from '~/types';
import Button from './Button.astro';
import { Icon } from 'astro-icon/components';

const { items = [], columns, defaultIcon = '', classes = {} } = Astro.props as ItemGrid;
const {
  container: containerClass = '',
  panel: panelClass = '',
  title: titleClass = '',
  description: descriptionClass = '',
  icon: defaultIconClass = 'text-primary',
  action: actionClass = '',
  body: bodyClass = '',
} = classes;
---

{
  items && (
    <div
      class={twMerge(
        `grid mx-auto gap-8 md:gap-y-12 ${
          columns === 4
            ? 'lg:grid-cols-4 md:grid-cols-3 sm:grid-cols-2'
            : columns === 3
            ? 'lg:grid-cols-3 sm:grid-cols-2'
            : columns === 2
            ? 'sm:grid-cols-2 '
            : ''
        }`,
        containerClass
      )}
    >
      {items.map(({ title, description, icon, callToAction, classes: itemClasses = {} }) => {
        const callToActionProps = callToAction ?? {};
        const {
          text: actionText,
          icon: actionIcon,
          class: actionClassName = '',
          variant: actionVariant = 'link',
          isCardLink,
          labelClass: actionLabelClass = '',
          ...actionRest
        } = callToActionProps;
        const isExternal = actionRest?.target === '_blank';
        const isCardLinkEnabled = Boolean(isCardLink && actionRest?.href);
        const panelClasses = twMerge(
          'flex flex-row max-w-md',
          panelClass,
          itemClasses?.panel,
          isCardLinkEnabled ? 'group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400' : ''
        );
        const needsRel = (!('rel' in actionRest) || actionRest.rel === undefined) && isExternal;
        const relProps = needsRel ? { rel: 'noopener noreferrer' } : {};

        const content = (
          <>
            <div class="flex justify-center">
              {(icon || defaultIcon) && (
                <Icon
                  name={icon || defaultIcon}
                  class={twMerge('w-7 h-7 mr-2 rtl:mr-0 rtl:ml-2', defaultIconClass, itemClasses?.icon)}
                />
              )}
            </div>
            <div class={twMerge('mt-0.5 flex flex-col h-full', bodyClass, itemClasses?.body)}>
              {title && <h3 class={twMerge('text-xl font-bold', titleClass, itemClasses?.title)}>{title}</h3>}
              {description && (
                <p
                  class={twMerge(`${title ? 'mt-3' : ''} text-muted flex-1`, descriptionClass, itemClasses?.description)}
                  set:html={description}
                />
              )}
              {callToAction && actionText && (
                <div
                  class={twMerge(
                    `${title || description ? 'mt-3' : ''}`,
                    actionClass,
                    itemClasses?.actionClass
                  )}
                >
                  {isCardLinkEnabled ? (
                    <span
                      class={twMerge(
                        'inline-flex items-center gap-2 text-sm font-semibold text-link group-hover:text-link-hover',
                        actionLabelClass
                      )}
                    >
                      <span set:html={actionText} />
                      {actionIcon && <Icon name={actionIcon} class="h-4 w-4" />}
                    </span>
                  ) : (
                    <Button
                      {...{
                        ...actionRest,
                        ...relProps,
                        text: actionText,
                        icon: actionIcon,
                        class: actionClassName,
                        variant: actionVariant,
                      }}
                    />
                  )}
                </div>
              )}
            </div>
          </>
        );

        return (
          <div>
            {isCardLinkEnabled ? (
              <a
                class={twMerge(panelClasses, actionClassName)}
                {...actionRest}
                {...relProps}
              >
                {content}
              </a>
            ) : (
              <div class={panelClasses}>
                {content}
              </div>
            )}
          </div>
        );
      })}
    </div>
  )
}
