---
import { SITE } from '~/utils/config';

export interface Props {
  items: Array<{
    name: string;
    url: string;
  }>;
}

const { items } = Astro.props;

// Add home as first item if not present, and remove the last item (current page)
const allItems = items[0]?.name === 'Home' ? items : [
  { name: 'Home', url: '/' },
  ...items
];
// Remove the last item (current page) to avoid redundancy
const breadcrumbItems = allItems.slice(0, -1);
---

<nav aria-label="Breadcrumb" class="mb-6 px-4 sm:px-6 max-w-3xl mx-auto">
  <ol class="flex flex-wrap items-center space-x-1 sm:space-x-2 text-sm text-gray-600 dark:text-gray-400 overflow-hidden">
    {breadcrumbItems.map((item, index) => (
      <li class="flex items-center min-w-0 flex-shrink-0">
        {index > 0 && (
          <svg class="w-3 h-3 sm:w-4 sm:h-4 mx-1 sm:mx-2 text-gray-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
          </svg>
        )}
        <a
          href={item.url}
          class="text-text-muted hover:text-link dark:hover:text-link-hover transition-colors duration-200 truncate no-underline"
        >
          {item.name}
        </a>
      </li>
    ))}
  </ol>
</nav>
