---
// SearchModal.astro - Beautiful search modal component
---

<div id="search-modal" class="search-modal">
  <!-- Backdrop -->
  <div class="search-modal__backdrop" id="search-backdrop"></div>
  
  <!-- Modal -->
  <div class="search-modal__dialog">
    <div class="search-modal__panel">
      <!-- Header -->
      <div class="search-modal__header">
        <div class="flex items-center justify-between">
          <h3>
            Search Soranauts
          </h3>
          <button
            id="search-close"
            class="search-modal__close"
            aria-label="Close search"
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>
      
      <!-- Search Input -->
      <div class="search-modal__input">
        <div class="relative">
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
            <svg class="h-5 w-5 text-text-soft" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            type="text"
            id="search-input"
            class="search-modal__input-field"
            placeholder="Search articles, guides, and more..."
            autocomplete="off"
            spellcheck="false"
          />
        </div>
      </div>
      
      <!-- Search Results -->
      <div id="search-results" class="search-modal__results">
        <!-- Loading state -->
        <div id="search-loading" class="hidden py-8 text-center">
          <div class="inline-block h-8 w-8 animate-spin rounded-full border-4 border-solid border-brand-500 border-r-transparent"></div>
          <p class="mt-2 text-sm text-text-soft">Searching...</p>
        </div>
        
        <!-- No results -->
        <div id="search-no-results" class="hidden py-8 text-center">
          <svg class="mx-auto h-12 w-12 text-text-soft" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 12h6m-6-4h6m2 5.291A7.962 7.962 0 0112 15c-2.34 0-4.29-1.009-5.824-2.709M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <h3 class="mt-2 text-sm font-medium text-text-main">No results found</h3>
          <p class="mt-1 text-sm text-text-soft">Try different keywords or check your spelling.</p>
        </div>
        
        <!-- Initial state -->
        <div id="search-initial" class="py-8 text-center">
          <svg class="mx-auto h-12 w-12 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <h3 class="mt-2 text-sm font-medium text-text-main">Search Soranauts</h3>
          <p class="mt-1 text-sm text-text-soft">Type to search through our content</p>
        </div>
        
        <!-- Results container -->
        <div id="search-results-list" class="space-y-2"></div>
      </div>
      
      <!-- Footer -->
      <div class="border-t border-border-subtle px-6 py-3">
        <div class="search-modal__badges">
          <div class="flex items-center space-x-4">
            <span class="flex items-center">
              <kbd class="rounded bg-soft px-2 py-1 font-mono">⌘K</kbd>
              <span class="ml-1">to search</span>
            </span>
            <span class="flex items-center">
              <kbd class="rounded bg-soft px-2 py-1 font-mono">Esc</kbd>
              <span class="ml-1">to close</span>
            </span>
          </div>
          <div class="text-right">
            <span id="search-count" class="font-medium text-text-soft">0 results</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  class SearchModal {
    modal: HTMLElement | null;
    backdrop: HTMLElement | null;
    input: HTMLInputElement | null;
    closeBtn: HTMLElement | null;
    results: HTMLElement | null;
    loading: HTMLElement | null;
    noResults: HTMLElement | null;
    initial: HTMLElement | null;
    count: HTMLElement | null;
    pagefind: any;
    isOpen: boolean;
    currentQuery: string;
    debounceTimer: number | null;
    
    constructor() {
      this.modal = document.getElementById('search-modal');
      this.backdrop = document.getElementById('search-backdrop');
      this.input = document.getElementById('search-input') as HTMLInputElement;
      this.closeBtn = document.getElementById('search-close');
      this.results = document.getElementById('search-results-list');
      this.loading = document.getElementById('search-loading');
      this.noResults = document.getElementById('search-no-results');
      this.initial = document.getElementById('search-initial');
      this.count = document.getElementById('search-count');
      
      this.pagefind = null;
      this.isOpen = false;
      this.currentQuery = '';
      this.debounceTimer = null;
      
      this.init();
    }
    
    async init() {
      // Load Pagefind - check if we're in development vs production
      // Only disable search in dev server (port 3000), not in preview server (port 4321)
      const isDevServer = (window.location.hostname === 'localhost' || 
                          window.location.hostname === '127.0.0.1') && 
                         window.location.port === '3000';
      
      if (!isDevServer) {
        try {
          // Use eval to prevent Vite from trying to resolve the import at build time
          const pagefindModule = await eval('import("/pagefind/pagefind.js")');
          if (pagefindModule) {
            this.pagefind = pagefindModule;
            console.log('✅ Pagefind loaded successfully');
          }
        } catch (error) {
          console.error('Failed to load Pagefind:', error);
        }
      } else {
        // In development, show a message that search is only available in production
        console.log('Search is only available in production builds. Run "npm run build && npm run preview" to test search functionality.');
      }
      
      this.bindEvents();
    }
    
    bindEvents() {
      // Open modal
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          this.open();
        }
      });
      
      // Search trigger button
      const searchTrigger = document.getElementById('search-trigger');
      if (searchTrigger) {
        searchTrigger.addEventListener('click', () => this.open());
      }
      
      // Close modal
      this.closeBtn?.addEventListener('click', () => this.close());
      this.backdrop?.addEventListener('click', () => this.close());
      
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && this.isOpen) {
          this.close();
        }
      });
      
      // Search input
      this.input?.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        this.debounceSearch(target.value);
      });
      
      // Focus management
      this.input?.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          this.close();
        }
      });
    }
    
    open() {
      this.modal?.classList.remove('hidden');
      this.isOpen = true;
      this.input?.focus();
      document.body.style.overflow = 'hidden';
      
      // Clear previous results
      this.clearResults();
    }
    
    close() {
      this.modal?.classList.add('hidden');
      this.isOpen = false;
      if (this.input) this.input.value = '';
      this.currentQuery = '';
      document.body.style.overflow = '';
      this.clearResults();
    }
    
    debounceSearch(query: string) {
      if (this.debounceTimer) {
        clearTimeout(this.debounceTimer);
      }
      this.debounceTimer = window.setTimeout(() => {
        this.search(query);
      }, 300);
    }
    
    async search(query: string) {
      if (!this.pagefind) {
        this.showDevelopmentMessage();
        return;
      }
      
      if (!query.trim()) {
        this.clearResults();
        return;
      }
      
      this.currentQuery = query;
      this.showLoading();
      
      try {
        // Search both articles and glossary using Pagefind
        const [articlesResults, glossaryResults] = await Promise.all([
          this.searchArticles(query),
          this.searchGlossary(query)
        ]);
        
        await this.displayCombinedResults(articlesResults, glossaryResults, query);
      } catch (error) {
        console.error('Search error:', error);
        this.showError();
      }
    }
    
    async searchArticles(query: string) {
      if (!this.pagefind) {
        return [];
      }
      
      try {
        const search = await this.pagefind.search(query, {
          excerptLength: 24
        });
        
        const results = search.results || [];
        console.log('Total search results for articles:', results.length);

        // Helper to fetch data() for all results (it's async per item)
        const withData = await Promise.all(
          results.map(async r => ({ r, d: await r.data() }))
        );

        // Now split by filters/meta.type - only include non-glossary content
        const articleResults = [];

        for (const { r, d } of withData) {
          const filters = d.filters || {};
          const meta = d.meta || {};

          const types = Array.isArray(filters.type) ? filters.type : (filters.type ? [filters.type] : []);
          const typeFromFilters = types.includes('glossary') ? 'glossary'
                                : types.includes('article') ? 'article'
                                : null;

          const t = typeFromFilters || meta.type || null;

          // Include as article if it's explicitly marked as article, or if it's not glossary
          if (t !== 'glossary') {
            articleResults.push({ result: r, data: d });
          }
        }
        
        console.log('Article results found:', articleResults.length);
        
        return await Promise.all(
          articleResults.slice(0, 8).map(async ({ result, data }) => {
            // Pagefind should provide the URL directly
            let url = result.url;
            
            // If no URL, try alternative approaches
            if (!url) {
              if (data.url) {
                url = data.url;
              } else if (data.meta?.url) {
                url = data.meta.url;
              } else if (result.id) {
                url = result.id;
              }
            }
            
            // Ensure URL is properly formatted
            if (url) {
              if (url.endsWith('.html')) {
                url = url.replace('.html', '');
              }
              if (url.endsWith('/index')) {
                url = url.replace('/index', '');
              }
              if (url.endsWith('/') && url !== '/') {
                url = url.slice(0, -1);
              }
              if (!url.startsWith('http') && !url.startsWith('/')) {
                url = '/' + url;
              }
              // Fix double slashes
              url = url.replace(/\/+/g, '/');
            }
            
            // Extract title from various possible locations
            let title = 'Untitled';
            if (data.meta?.title) {
              title = data.meta.title;
            } else if (data.title) {
              title = data.title;
            } else if (result.title) {
              title = result.title;
            } else if (data.meta?.term) {
              title = data.meta.term;
            } else if (data.content) {
              // Try to extract title from content if it starts with a heading
              const headingMatch = data.content.match(/^#\s+(.+)$/m);
              if (headingMatch) {
                title = headingMatch[1];
              }
            }
            
            return {
              url: url || '#',
              title: title,
              excerpt: data.excerpt || '',
              content: data.content || ''
            };
          })
        );
      } catch (error) {
        console.error('Pagefind search error:', error);
        return [];
      }
    }
    
    async searchGlossary(query: string) {
      if (!this.pagefind) {
        return [];
      }
      
      try {
        // Search all content
        const search = await this.pagefind.search(query, {
          excerptLength: 24
        });
        
        const results = search.results || [];
        console.log('Total search results:', results.length);

        // Helper to fetch data() for all results (it's async per item)
        const withData = await Promise.all(
          results.map(async r => ({ r, d: await r.data() }))
        );

        // Now split by filters/meta.type
        const glossaryResults = [];

        for (const { r, d } of withData) {
          const filters = d.filters || {};
          const meta = d.meta || {};

          // Debug logging
          console.log('Checking result:', { 
            url: r.url, 
            id: r.id, 
            score: r.score,
            title: r.title,
            filters,
            meta
          });

          const types = Array.isArray(filters.type) ? filters.type : (filters.type ? [filters.type] : []);
          const typeFromFilters = types.includes('glossary') ? 'glossary'
                                : types.includes('article') ? 'article'
                                : null;

          const t = typeFromFilters || meta.type || null;

          if (t === 'glossary') {
            glossaryResults.push({ result: r, data: d });
            console.log('Found glossary result:', { url: r.url, title: r.title, type: t });
          }
        }
        
        console.log('Glossary results found:', glossaryResults.length);
        
        return await Promise.all(
          glossaryResults.slice(0, 5).map(async ({ result, data }) => {
            // Use the URL directly from Pagefind data (now properly set with data-pagefind-url)
            let url = data.url || result.url;
            
            // Fallback to constructing URL if not provided
            if (!url) {
              // Extract slug from the result URL or ID
              let slug = '';
              if (result.url) {
                slug = result.url.replace('/glossary/', '').replace(/\/$/, '');
              } else if (result.id) {
                // Extract slug from ID if it contains glossary info
                const idMatch = result.id.match(/glossary[\/\\]([^\/\\]+)/);
                if (idMatch) {
                  slug = idMatch[1];
                }
              }
              url = slug ? `/glossary/${slug}/` : '#';
            }
            
            // Ensure URL is properly formatted
            if (url && url !== '#') {
              if (url.endsWith('.html')) {
                url = url.replace('.html', '');
              }
              if (url.endsWith('/index')) {
                url = url.replace('/index', '');
              }
              if (url.endsWith('/') && url !== '/') {
                url = url.slice(0, -1);
              }
              if (!url.startsWith('http') && !url.startsWith('/')) {
                url = '/' + url;
              }
              // Fix double slashes
              url = url.replace(/\/+/g, '/');
            }
            
            // Extract title from various possible locations
            let term = 'Untitled';
            if (data.meta?.term) {
              term = data.meta.term;
            } else if (data.title) {
              term = data.title;
            } else if (result.title) {
              term = result.title;
            } else if (data.meta?.title) {
              term = data.meta.title;
            } else if (data.content) {
              // Try to extract title from content if it starts with a heading
              const headingMatch = data.content.match(/^#\s+(.+)$/m);
              if (headingMatch) {
                term = headingMatch[1];
              }
            }
            
            // Extract slug from URL for the displayCombinedResults method
            const slug = url?.replace('/glossary/', '').replace(/\/$/, '') || '';
            
            return {
              url: url || '#',
              term: term,
              definition: data.excerpt || '',
              category: data.meta?.category || '',
              slug: slug,
              snippet: data.excerpt || ''
            };
          })
        );
      } catch (error) {
        console.error('Pagefind glossary search error:', error);
        return [];
      }
    }
    
    showLoading() {
      this.loading?.classList.remove('hidden');
      this.noResults?.classList.add('hidden');
      if (this.results) this.results.innerHTML = '';
    }
    
    clearResults() {
      this.loading?.classList.add('hidden');
      this.noResults?.classList.add('hidden');
      this.initial?.classList.remove('hidden');
      if (this.results) this.results.innerHTML = '';
      if (this.count) this.count.textContent = '0 results';
    }
    
    async displayCombinedResults(articles: any[], glossary: any[], query: string) {
      this.loading?.classList.add('hidden');
      this.initial?.classList.add('hidden');
      
      const totalResults = articles.length + glossary.length;
      
      if (totalResults === 0) {
        this.noResults?.classList.remove('hidden');
        if (this.count) this.count.textContent = '0 results';
        return;
      }
      
      this.noResults?.classList.add('hidden');
      if (this.count) this.count.textContent = `${totalResults} result${totalResults !== 1 ? 's' : ''}`;
      
      if (this.results) {
        let html = '';
        
        // Simple prioritization logic
        const showGlossaryFirst = this.shouldPrioritizeGlossary(query, glossary);
        
        // Glossary section
        if (glossary.length > 0) {
          html += `
            <div class="mb-6">
              <div class="mb-3 flex items-center justify-between">
                <h3 class="text-xs font-semibold uppercase tracking-wide text-text-soft">Glossary</h3>
                <a href="/glossary?q=${encodeURIComponent(query)}" class="text-xs font-medium text-link hover:text-link-hover">
                  View all glossary →
                </a>
              </div>
              <div class="space-y-2">
                ${glossary.map(item => `
                  <a href="/glossary/${item.slug}" class="search-modal__result search-modal__result--glossary">
                    <h4 class="search-modal__result-title">${this.highlightText(item.term, query)}</h4>
                    <p class="search-modal__result-body">${this.highlightText(item.snippet || item.definition, query)}</p>
                  </a>
                `).join('')}
              </div>
            </div>
          `;
        }
        
        // Articles section
        if (articles.length > 0) {
          html += `
            <div class="${glossary.length > 0 ? 'mt-6' : ''}">
              <h3 class="mb-3 text-xs font-semibold uppercase tracking-wide text-text-soft">Articles</h3>
              <div class="space-y-2">
                ${articles.map(result => `
                  <a href="${result.url}" class="search-modal__result search-modal__result--article">
                    <h4 class="search-modal__result-title">${this.highlightText(result.title, query)}</h4>
                    <p class="search-modal__result-body">${this.highlightText(result.excerpt, query)}</p>
                  </a>
                `).join('')}
              </div>
            </div>
          `;
        }
        
        this.results.innerHTML = html;
      }
    }
    
    highlightText(text: string, query: string) {
      if (!query) return text;
      const regex = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
      return text.replace(regex, '<mark class="rounded bg-brand-soft px-1 text-text-main">$1</mark>');
    }
    
    shouldPrioritizeGlossary(query: string, glossaryResults: any[]) {
      if (!glossaryResults?.length) return false;
      
      // Exact term match
      const exact = glossaryResults.some(item => 
        item.term?.toLowerCase() === query.toLowerCase()
      );
      
      // Short queries (likely looking for definitions)
      const isShort = query.length <= 5 && /^[a-zA-Z0-9]+$/.test(query);
      
      // Contains common crypto/DeFi terms
      const cryptoTerms = ['xor', 'val', 'pswap', 'kusd', 'defi', 'dex', 'swap', 'token', 'crypto'];
      const isCryptoTerm = cryptoTerms.some(term => 
        query.toLowerCase().includes(term)
      );
      
      return exact || isShort || isCryptoTerm;
    }
    
    showError() {
      this.loading?.classList.add('hidden');
      this.noResults?.classList.remove('hidden');
      if (this.noResults) {
        this.noResults.innerHTML = `
          <svg class="mx-auto h-12 w-12 text-status-error" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z" />
          </svg>
          <h3 class="mt-2 text-sm font-medium text-text-main">Search Error</h3>
          <p class="mt-1 text-sm text-text-soft">Unable to search. Please try again later.</p>
        `;
      }
    }
    
    showDevelopmentMessage() {
      this.loading?.classList.add('hidden');
      this.noResults?.classList.remove('hidden');
      if (this.noResults) {
        this.noResults.innerHTML = `
          <svg class="mx-auto h-12 w-12 text-status-warning" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <h3 class="mt-2 text-sm font-medium text-text-main">Search in Development</h3>
          <p class="mt-1 text-sm text-text-soft">Search is only available in production builds. Run <code class="rounded bg-soft px-1">npm run build</code> to test search functionality.</p>
        `;
      }
      if (this.count) this.count.textContent = 'Development mode';
    }
  }
  
  // Initialize search modal when DOM is loaded
  document.addEventListener('DOMContentLoaded', () => {
    new SearchModal();
  });
</script>
