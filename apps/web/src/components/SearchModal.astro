---
// SearchModal.astro - Beautiful search modal component
---

<div id="search-modal" class="search-modal hidden">
  <!-- Backdrop -->
  <div class="search-modal__backdrop" id="search-backdrop"></div>
  
  <!-- Modal -->
  <div class="search-modal__dialog">
    <div class="search-modal__panel">
      <!-- Header -->
      <div class="search-modal__header">
        <div class="flex items-center justify-between">
          <h3>
            Search Soranauts
          </h3>
          <button
            id="search-close"
            class="search-modal__close"
            aria-label="Close search"
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>
      
      <!-- Search Input -->
      <div class="search-modal__input">
        <div class="relative">
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
            <svg class="h-5 w-5 text-text-soft" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            type="text"
            id="search-input"
            class="search-modal__input-field"
            placeholder="Search articles, guides, and more..."
            autocomplete="off"
            spellcheck="false"
          />
        </div>
      </div>
      
      <!-- Search Results -->
      <div id="search-results" class="search-modal__results">
        <!-- Filter controls -->
        <div id="search-filters" class="hidden search-modal__filters">
          <div
            id="search-filter-type"
            class="search-modal__filter-group"
            role="group"
            aria-label="Filter by content type"
          ></div>
          <div
            id="search-filter-category"
            class="search-modal__filter-group hidden"
            role="group"
            aria-label="Filter by category"
          ></div>
        </div>

        <!-- Loading state -->
        <div id="search-loading" class="hidden py-8 text-center">
          <div class="inline-block h-8 w-8 animate-spin rounded-full border-4 border-solid border-brand-500 border-r-transparent"></div>
          <p class="mt-2 text-sm text-text-soft">Searching...</p>
        </div>
        
        <!-- No results -->
        <div id="search-no-results" class="hidden py-8 text-center">
          <svg class="mx-auto h-12 w-12 text-text-soft" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 12h6m-6-4h6m2 5.291A7.962 7.962 0 0112 15c-2.34 0-4.29-1.009-5.824-2.709M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <h3 class="mt-2 text-sm font-medium text-text-main">No results found</h3>
          <p class="mt-1 text-sm text-text-soft">Try different keywords or check your spelling.</p>
        </div>
        
        <!-- Initial state -->
        <div id="search-initial" class="py-8 text-center">
          <svg class="mx-auto h-12 w-12 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <h3 class="mt-2 text-sm font-medium text-text-main">Search Soranauts</h3>
          <p class="mt-1 text-sm text-text-soft">Type to search through our content</p>
        </div>
        
        <!-- Results container -->
        <div id="search-results-list" class="space-y-2"></div>
      </div>
      
      <!-- Footer -->
      <div class="border-t border-border-subtle px-6 py-3">
        <div class="search-modal__badges">
          <div class="flex items-center space-x-4">
            <span class="flex items-center">
              <kbd class="rounded bg-soft px-2 py-1 font-mono">⌘K</kbd>
              <span class="ml-1">to search</span>
            </span>
            <span class="flex items-center">
              <kbd class="rounded bg-soft px-2 py-1 font-mono">Esc</kbd>
              <span class="ml-1">to close</span>
            </span>
          </div>
          <div class="text-right">
            <span id="search-count" class="font-medium text-text-soft">0 results</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // @ts-nocheck
  declare global {
    interface Window {
      pagefind?: any;
      __pagefindLoadPromise?: Promise<any>;
    }
  }

  const TYPE_FILTERS = [
    { id: 'all', label: 'All' },
    { id: 'glossary', label: 'Glossary' },
    { id: 'articles', label: 'Articles' },
  ] as const;

  const MAX_INITIAL_GLOSSARY = 3;
  const MAX_INITIAL_ARTICLES = 5;

  const SYNONYM_MAP: Record<string, string[]> = {
    sora: ['soramitsu', 'xor', 'sora-network'],
    xor: ['sora'],
    dex: ['exchange', 'decentralized-exchange', 'polkaswap', 'tonswap'],
    cbdc: ['central-bank-digital-currency', 'central-bank'],
    polkaswap: ['dex', 'exchange'],
    polkadot: ['kusama', 'parachain'],
    governance: ['democracy', 'council'],
  };

  const RANKING_WEIGHTS = {
    termSimilarity: 1.25,
    termFrequency: 1.15,
    termSaturation: 1.0,
    pageLength: 0.5,
  };

  const CATEGORY_LABEL_OVERRIDES: Record<string, string> = {
    defi: 'DeFi',
    dex: 'DEX',
    cbdc: 'CBDC',
    nft: 'NFT',
    web3: 'Web3',
    xor: 'XOR',
  };

  class SearchModal {
    modal: HTMLElement | null;
    backdrop: HTMLElement | null;
    input: HTMLInputElement | null;
    closeBtn: HTMLElement | null;
    results: HTMLElement | null;
    loading: HTMLElement | null;
    noResults: HTMLElement | null;
    initial: HTMLElement | null;
    count: HTMLElement | null;
    pagefind: any;
    pagefindPromise: Promise<any> | null;
    isDevServer: boolean;
    preloadedQueries: Set<string>;
    isOpen: boolean;
    currentQuery: string;
    debounceTimer: number | null;
    filtersContainer: HTMLElement | null;
    typeFilterContainer: HTMLElement | null;
    categoryFilterContainer: HTMLElement | null;
    activeFilters: {
      type: 'all' | 'glossary' | 'articles';
      glossaryCategory: string;
      articleCategory: string;
    };
    availableCategories: {
      glossary: Array<{ label: string; count: number }>;
      article: Array<{ label: string; count: number }>;
    };
    showAllGlossary: boolean;
    showAllArticles: boolean;
    cachedResults: {
      query: string;
      expandedQuery: string;
      articles: any[];
      glossary: any[];
    } | null;
    focusedResultIndex: number;
    locale: string;
    dateFormatter: Intl.DateTimeFormat;
    lastUserQuery: string;
    resultAnchors: HTMLAnchorElement[];
    
    constructor() {
      this.modal = document.getElementById('search-modal');
      this.backdrop = document.getElementById('search-backdrop');
      this.input = document.getElementById('search-input') as HTMLInputElement;
      this.closeBtn = document.getElementById('search-close');
      this.results = document.getElementById('search-results-list');
      this.loading = document.getElementById('search-loading');
      this.noResults = document.getElementById('search-no-results');
      this.initial = document.getElementById('search-initial');
      this.count = document.getElementById('search-count');
      this.filtersContainer = document.getElementById('search-filters');
      this.typeFilterContainer = document.getElementById('search-filter-type');
      this.categoryFilterContainer = document.getElementById('search-filter-category');
      
      this.pagefind = null;
      this.pagefindPromise = null;
      this.isDevServer = false;
      this.preloadedQueries = new Set();
      this.isOpen = false;
      this.currentQuery = '';
      this.debounceTimer = null;
      this.showAllArticles = false;
      this.showAllGlossary = false;
      this.cachedResults = null;
      this.focusedResultIndex = -1;
      this.locale = document.documentElement.lang || 'en';
      this.dateFormatter = new Intl.DateTimeFormat(this.locale, {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
      });
      this.lastUserQuery = '';
      this.resultAnchors = [];
      this.activeFilters = {
        type: 'all',
        glossaryCategory: 'all',
        articleCategory: 'all',
      };
      this.availableCategories = {
        glossary: [],
        article: [],
      };
      
      this.init();
    }
    
    async init() {
      // Load Pagefind - check if we're in development vs production
      // Only disable search in dev server (port 3000), not in preview server (port 4321)
      const isDevServer = (window.location.hostname === 'localhost' || 
                          window.location.hostname === '127.0.0.1') && 
                         window.location.port === '3000';

      this.isDevServer = isDevServer;
      
      if (!isDevServer) {
        try {
          await this.loadPagefind();
        } catch (error) {
          // Errors are logged within loadPagefind; continue with UI bindings.
        }
      } else {
        // In development, show a message that search is only available in production
        console.log('Search is only available in production builds. Run "npm run build && npm run preview" to test search functionality.');
      }
      
      this.bindEvents();
    }

    async loadPagefind() {
      if (this.pagefind) {
        return this.pagefind;
      }

      if (this.pagefindPromise) {
        return this.pagefindPromise;
      }

      if (this.isDevServer || typeof window === 'undefined') {
        return null;
      }

      if (window.pagefind) {
        this.pagefind = window.pagefind;
        return this.pagefind;
      }

      if (window.__pagefindLoadPromise) {
        this.pagefindPromise = window.__pagefindLoadPromise.then((module) => {
          this.pagefind = module;
          return module;
        }).catch((error) => {
          this.pagefindPromise = null;
          throw error;
        });
        return this.pagefindPromise;
      }

      const pagefindPath = '/pagefind/pagefind.js';

      const loadModule = async () => {
        const module = await import(/* @vite-ignore */ `${pagefindPath}?module=1`);
        const resolvedModule: any = module?.default ?? module;

        if (!resolvedModule || typeof resolvedModule.search !== 'function') {
          throw new Error('Pagefind module loaded but did not expose the expected API.');
        }

        if (typeof resolvedModule.options === 'function') {
          await resolvedModule.options({
            ranking: RANKING_WEIGHTS,
          });
        }

        window.pagefind = resolvedModule;
        return resolvedModule;
      };

      window.__pagefindLoadPromise = loadModule();

      this.pagefindPromise = window.__pagefindLoadPromise
        .then((module) => {
          this.pagefind = module;
          console.log('✅ Pagefind loaded successfully');
          return module;
        })
        .catch((error) => {
          console.error('Failed to load Pagefind module:', error);
          this.pagefindPromise = null;
          window.__pagefindLoadPromise = undefined;
          throw error;
        });

      return this.pagefindPromise;
    }

    schedulePreload(query: string) {
      const normalized = query.trim().toLowerCase();
      if (!normalized || normalized.length < 2) {
        return;
      }

      const expanded = this.expandQueryWithSynonyms(normalized);
      if (this.preloadedQueries.has(expanded)) {
        return;
      }

      this.preloadedQueries.add(expanded);
      this.loadPagefind()
        .then((pagefind) => {
          if (pagefind?.preload) {
            pagefind.preload(expanded);
          }
        })
        .catch((error) => {
          console.error('Pagefind preload error:', error);
          this.preloadedQueries.delete(expanded);
        });
    }
    
    bindEvents() {
      // Open modal
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          this.open();
        }
      });
      
      // Search trigger button
      const searchTrigger = document.getElementById('search-trigger');
      if (searchTrigger) {
        searchTrigger.addEventListener('click', () => this.open());
      }
      
      // Close modal
      this.closeBtn?.addEventListener('click', () => this.close());
      this.backdrop?.addEventListener('click', () => this.close());
      
      document.addEventListener('keydown', (e) => {
        if (!this.isOpen) {
          return;
        }

        if (e.key === 'Escape') {
          this.close();
          return;
        }

        if (e.key === 'ArrowDown' || e.key === 'ArrowUp' || e.key === 'Enter') {
          this.handleKeyboardNavigation(e);
        }
      });
      
      // Search input
      this.input?.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        this.debounceSearch(target.value);
      });
      
      // Focus management
      this.input?.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          this.close();
        }
      });
    }
    
    open() {
      this.modal?.classList.remove('hidden');
      this.isOpen = true;
      this.clearResults(true);
      this.input?.focus();
      document.body.style.overflow = 'hidden';

      // Begin loading assets needed for search in the background.
      this.loadPagefind().catch(() => {});
    }
    
    close() {
      this.modal?.classList.add('hidden');
      this.isOpen = false;
      if (this.input) this.input.value = '';
      this.currentQuery = '';
      this.lastUserQuery = '';
      document.body.style.overflow = '';
      this.clearResults(true);
    }
    
    debounceSearch(query: string) {
      if (this.debounceTimer) {
        clearTimeout(this.debounceTimer);
      }
      const rawQuery = query ?? '';
      const normalizedQuery = rawQuery.trim();
      this.schedulePreload(rawQuery);
      this.debounceTimer = window.setTimeout(() => {
        this.search(normalizedQuery);
      }, 250);
    }
    
    async search(query: string) {
      const trimmed = query.trim();
      if (!trimmed) {
        this.clearResults(true);
        return;
      }

      if (this.isDevServer) {
        this.showDevelopmentMessage();
        return;
      }

      try {
        await this.loadPagefind();
      } catch (error) {
        this.showError();
        return;
      }

      if (!this.pagefind) {
        this.showError();
        return;
      }
      
      this.lastUserQuery = trimmed;
      this.currentQuery = trimmed;
      this.showLoading();
      this.showAllArticles = false;
      this.showAllGlossary = false;
      this.focusedResultIndex = -1;

      const expandedQuery = this.expandQueryWithSynonyms(trimmed);
      
      try {
        const [articlesResults, glossaryResults] = await Promise.all([
          this.searchArticles(expandedQuery),
          this.searchGlossary(expandedQuery),
        ]);
        
        this.cacheResults(trimmed, expandedQuery, articlesResults, glossaryResults);
      } catch (error) {
        console.error('Search error:', error);
        this.showError();
      }
    }
    
    async searchArticles(query: string) {
      if (!this.pagefind) {
        return [];
      }
      
      try {
        const search = await this.pagefind.search(query, {
          excerptLength: 32
        });
        
        const results = search.results || [];

        const withData = await Promise.all(
          results.map(async (r) => ({ r, d: await r.data() }))
        );

        const articleResults = [];

        for (const { r, d } of withData) {
          const filters = d.filters || {};
          const meta = d.meta || {};

          const types = Array.isArray(filters.type) ? filters.type : (filters.type ? [filters.type] : []);
          const typeFromFilters = types.includes('glossary') ? 'glossary'
                                : types.includes('article') ? 'article'
                                : null;

          const t = typeFromFilters || meta.type || null;

          if (t === 'glossary') {
            continue;
          }

          let url = r.url || d.url || meta.url || r.id || '#';
              if (url.endsWith('.html')) {
                url = url.replace('.html', '');
              }
              if (url.endsWith('/index')) {
                url = url.replace('/index', '');
              }
              if (url.endsWith('/') && url !== '/') {
                url = url.slice(0, -1);
              }
              if (!url.startsWith('http') && !url.startsWith('/')) {
                url = '/' + url;
              }
              url = url.replace(/\/+/g, '/');

          let title = meta.title || d.title || r.title || meta.term || 'Untitled';
          if (!meta.title && !d.title && !r.title && d.content) {
            const headingMatch = d.content.match(/^#\s+(.+)$/m);
              if (headingMatch) {
                title = headingMatch[1];
              }
            }
            
          const tags = this.parseTags(meta.tags);
          const readingTime = this.normalizeReadingTime(meta.readingTime);
          const publishedAt = meta.date || meta.publishedTime || null;
          const categoryRaw = meta.category || '';

          articleResults.push({
            url,
            title,
            excerpt: d.excerpt || meta.description || '',
            content: d.content || '',
            summary: meta.description || d.excerpt || '',
            category: this.formatCategoryLabel(categoryRaw),
            categoryRaw,
            tags,
            readingTime,
            publishedAt,
            score: r.score ?? 0,
          });
        }
        
        return articleResults;
      } catch (error) {
        console.error('Pagefind search error:', error);
        return [];
      }
    }
    
    async searchGlossary(query: string) {
      if (!this.pagefind) {
        return [];
      }
      
      try {
        const search = await this.pagefind.search(query, {
          excerptLength: 32
        });
        
        const results = search.results || [];

        const withData = await Promise.all(
          results.map(async (r) => ({ r, d: await r.data() }))
        );

        const glossaryResults = [];

        for (const { r, d } of withData) {
          const filters = d.filters || {};
          const meta = d.meta || {};

          const types = Array.isArray(filters.type) ? filters.type : (filters.type ? [filters.type] : []);
          const typeFromFilters = types.includes('glossary') ? 'glossary'
                                : types.includes('article') ? 'article'
                                : null;

          const t = typeFromFilters || meta.type || null;

          if (t !== 'glossary') {
            continue;
          }

          let url = d.url || r.url || meta.url || '#';
              if (url.endsWith('.html')) {
                url = url.replace('.html', '');
              }
              if (url.endsWith('/index')) {
                url = url.replace('/index', '');
              }
              if (url.endsWith('/') && url !== '/') {
                url = url.slice(0, -1);
              }
              if (!url.startsWith('http') && !url.startsWith('/')) {
                url = '/' + url;
              }
              url = url.replace(/\/+/g, '/');

          let term = meta.term || d.title || r.title || meta.title || 'Untitled';
          if (!meta.term && !d.title && !r.title && d.content) {
            const headingMatch = d.content.match(/^#\s+(.+)$/m);
              if (headingMatch) {
                term = headingMatch[1];
              }
            }
            
          const categoryRaw = meta.category || '';
          const aliases = Array.isArray(meta.aliases) ? meta.aliases : [];
          const summary = meta.summary || d.excerpt || d.content?.slice(0, 200) || '';

          glossaryResults.push({
            url,
            term,
            definition: d.excerpt || meta.definition || '',
            snippet: d.excerpt || summary,
            category: this.formatCategoryLabel(categoryRaw),
            categoryRaw,
            aliases,
            summary,
            score: r.score ?? 0,
          });
        }
        
        return glossaryResults;
      } catch (error) {
        console.error('Pagefind glossary search error:', error);
        return [];
      }
    }
    
    showLoading() {
      this.loading?.classList.remove('hidden');
      this.noResults?.classList.add('hidden');
      this.initial?.classList.add('hidden');
      this.filtersContainer?.classList.add('hidden');
      if (this.results) this.results.innerHTML = '';
    }
    
    clearResults(showInitial = false) {
      this.loading?.classList.add('hidden');
      this.noResults?.classList.add('hidden');
      if (showInitial) {
      this.initial?.classList.remove('hidden');
      } else {
        this.initial?.classList.add('hidden');
      }
      if (this.results) this.results.innerHTML = '';
      if (this.count) this.count.textContent = '0 results';
      this.filtersContainer?.classList.add('hidden');
      if (this.typeFilterContainer) this.typeFilterContainer.innerHTML = '';
      if (this.categoryFilterContainer) this.categoryFilterContainer.innerHTML = '';
      this.activeFilters = {
        type: 'all',
        glossaryCategory: 'all',
        articleCategory: 'all',
      };
      this.availableCategories = {
        glossary: [],
        article: [],
      };
      this.showAllGlossary = false;
      this.showAllArticles = false;
      this.cachedResults = null;
      this.resultAnchors = [];
      this.focusedResultIndex = -1;
    }
    
    cacheResults(query: string, expandedQuery: string, articles: any[], glossary: any[]) {
      this.cachedResults = { query, expandedQuery, articles, glossary };
      this.availableCategories.glossary = this.collectCategories(glossary);
      this.availableCategories.article = this.collectCategories(articles);
      const hasResults = articles.length + glossary.length > 0;
      this.filtersContainer?.classList.toggle('hidden', !hasResults);
      this.renderTypeFilters(this.getCurrentCounts());
      this.renderCategoryFilters();
      this.renderResults();
      this.emitAnalyticsEvent('soranauts:search', {
        query,
        expandedQuery,
        counts: this.getCurrentCounts(),
        filters: {
          type: this.activeFilters.type,
          glossaryCategory: this.activeFilters.glossaryCategory,
          articleCategory: this.activeFilters.articleCategory,
        },
      });
    }

    collectCategories(list: any[]) {
      const counts = new Map<string, { label: string; count: number }>();
      for (const item of list) {
        const raw = (item?.categoryRaw || item?.category || '').trim();
        if (!raw) continue;
        const key = raw.toLowerCase();
        if (counts.has(key)) {
          counts.get(key)!.count += 1;
        } else {
          counts.set(key, {
            label: this.formatCategoryLabel(raw),
            count: 1,
          });
        }
      }
      return Array.from(counts.values()).sort((a, b) => b.count - a.count).slice(0, 8);
    }

    getCurrentCounts() {
      if (!this.cachedResults) {
        return { glossary: 0, articles: 0 };
      }
      return {
        glossary: this.cachedResults.glossary.length,
        articles: this.cachedResults.articles.length,
      };
    }

    renderTypeFilters(counts: { glossary: number; articles: number }) {
      if (!this.typeFilterContainer) {
        return;
      }

      const total = counts.glossary + counts.articles;
      const buttons = TYPE_FILTERS.map((filter) => {
        const count = filter.id === 'glossary'
          ? counts.glossary
          : filter.id === 'articles'
          ? counts.articles
          : total;
        const isActive = this.activeFilters.type === filter.id;
        const disabled = count === 0 && filter.id !== 'all';
        return `
          <button
            type="button"
            class="search-filter-chip${isActive ? ' search-filter-chip--active' : ''}${disabled ? ' search-filter-chip--disabled' : ''}"
            data-filter-type="${filter.id}"
            aria-pressed="${isActive}"
            ${disabled ? 'disabled' : ''}
          >
            <span class="search-filter-chip__label">${filter.label}</span>
            <span class="search-filter-chip__count">${count}</span>
          </button>
        `;
      }).join('');

      this.typeFilterContainer.innerHTML = buttons;
      this.typeFilterContainer.querySelectorAll<HTMLButtonElement>('button[data-filter-type]').forEach((button) => {
        button.addEventListener('click', (event) => {
          const type = (event.currentTarget as HTMLButtonElement).dataset.filterType as 'all' | 'glossary' | 'articles';
          if (type) {
            this.handleTypeFilterChange(type);
          }
        });
      });
    }

    renderCategoryFilters() {
      if (!this.categoryFilterContainer) {
        return;
      }

      if (this.activeFilters.type === 'all') {
        this.categoryFilterContainer.classList.add('hidden');
        this.categoryFilterContainer.innerHTML = '';
        return;
      }

      const categories = this.activeFilters.type === 'glossary'
        ? this.availableCategories.glossary
        : this.availableCategories.article;

      if (!categories.length) {
        this.categoryFilterContainer.classList.add('hidden');
        this.categoryFilterContainer.innerHTML = '';
        return;
      }

      const activeCategory = this.activeFilters.type === 'glossary'
        ? this.activeFilters.glossaryCategory
        : this.activeFilters.articleCategory;

      const total = categories.reduce((sum, item) => sum + item.count, 0);
      const allLabel = this.activeFilters.type === 'glossary' ? 'All glossary' : 'All articles';

      const chips = [
        `
          <button
            type="button"
            class="search-filter-chip${activeCategory === 'all' ? ' search-filter-chip--active' : ''}"
            data-filter-group="category"
            data-filter-value="all"
            aria-pressed="${activeCategory === 'all'}"
          >
            <span class="search-filter-chip__label">${allLabel}</span>
            <span class="search-filter-chip__count">${total}</span>
          </button>
        `,
        ...categories.map((category) => {
          const value = category.label.toLowerCase();
          const isActive = activeCategory.toLowerCase() === value;
          return `
            <button
              type="button"
              class="search-filter-chip${isActive ? ' search-filter-chip--active' : ''}"
              data-filter-group="category"
              data-filter-value="${value}"
              aria-pressed="${isActive}"
            >
              <span class="search-filter-chip__label">${category.label}</span>
              <span class="search-filter-chip__count">${category.count}</span>
            </button>
          `;
        }),
      ].join('');

      this.categoryFilterContainer.innerHTML = chips;
      this.categoryFilterContainer.classList.remove('hidden');
      this.categoryFilterContainer.querySelectorAll<HTMLButtonElement>('button[data-filter-group="category"]').forEach((button) => {
        button.addEventListener('click', (event) => {
          const value = (event.currentTarget as HTMLButtonElement).dataset.filterValue || 'all';
          this.handleCategoryFilterChange(value);
        });
      });
    }

    applyCategoryFilter(list: any[], type: 'glossary' | 'articles') {
      const active = type === 'glossary' ? this.activeFilters.glossaryCategory : this.activeFilters.articleCategory;
      if (active === 'all') {
        return list;
      }
      return list.filter((item) => {
        const category = (item?.categoryRaw || item?.category || '').toLowerCase();
        return category === active.toLowerCase();
      });
    }

    renderResults() {
      if (!this.results || !this.cachedResults) {
        return;
      }

      const { query, articles, glossary } = this.cachedResults;

      let filteredGlossary = this.applyCategoryFilter(glossary, 'glossary');
      let filteredArticles = this.applyCategoryFilter(articles, 'articles');

      if (this.activeFilters.type === 'glossary') {
        filteredArticles = [];
      } else if (this.activeFilters.type === 'articles') {
        filteredGlossary = [];
      }

      const showGlossaryAll = this.activeFilters.type === 'glossary' || this.showAllGlossary;
      const showArticlesAll = this.activeFilters.type === 'articles' || this.showAllArticles;

      const visibleGlossary = showGlossaryAll
        ? filteredGlossary
        : filteredGlossary.slice(0, MAX_INITIAL_GLOSSARY);
      const visibleArticles = showArticlesAll
        ? filteredArticles
        : filteredArticles.slice(0, MAX_INITIAL_ARTICLES);

      const totalVisible = filteredGlossary.length + filteredArticles.length;
      const totalAvailable = articles.length + glossary.length;

      this.loading?.classList.add('hidden');
      this.initial?.classList.add('hidden');
      
      if (totalAvailable === 0) {
        this.results.innerHTML = '';
        this.noResults?.classList.remove('hidden');
        this.updateResultCount(0);
        return;
      }

      if (totalVisible === 0) {
        this.results.innerHTML = '';
        this.noResults?.classList.remove('hidden');
        this.updateResultCount(0);
        return;
      }
      
      this.noResults?.classList.add('hidden');

      const sections: string[] = [];
      const showGlossaryFirst = this.shouldPrioritizeGlossary(query, filteredGlossary);

      const glossarySection = this.buildGlossarySection(filteredGlossary, visibleGlossary, showGlossaryAll);
      const articleSection = this.buildArticleSection(filteredArticles, visibleArticles, showArticlesAll);

      if (showGlossaryFirst) {
        if (glossarySection) sections.push(glossarySection);
        if (articleSection) sections.push(articleSection);
      } else {
        if (articleSection) sections.push(articleSection);
        if (glossarySection) sections.push(glossarySection);
      }

      this.results.innerHTML = sections.join('');
      this.updateResultCount(filteredGlossary.length + filteredArticles.length);
      this.attachResultHandlers();
    }

    updateResultCount(total: number) {
      if (this.count) {
        this.count.textContent = `${total} result${total === 1 ? '' : 's'}`;
      }
    }

    buildGlossarySection(allResults: any[], visibleResults: any[], showAll: boolean) {
      if (!visibleResults.length) {
        return '';
      }

      const remaining = allResults.length - visibleResults.length;
      const queryLink = encodeURIComponent(this.lastUserQuery || this.currentQuery);

      return `
        <section class="search-modal__section">
          <div class="search-modal__section-heading">
            <div>
              <h3 class="search-modal__section-title">Glossary</h3>
              <p class="search-modal__section-subtitle">${allResults.length} definition${allResults.length === 1 ? '' : 's'}</p>
            </div>
            <a href="/glossary?q=${queryLink}" class="search-modal__section-link">
                  View all glossary →
                </a>
              </div>
              <div class="space-y-2">
            ${visibleResults.map((item) => this.buildGlossaryCard(item, allResults.indexOf(item))).join('')}
              </div>
          ${allResults.length > MAX_INITIAL_GLOSSARY ? `
            <div class="search-modal__section-footer">
              <button
                type="button"
                class="search-modal__more-button"
                data-toggle="glossary"
              >
                ${showAll ? 'Show fewer glossary definitions' : `Show ${remaining} more glossary definitions`}
              </button>
            </div>
          ` : ''}
        </section>
      `;
    }

    buildArticleSection(allResults: any[], visibleResults: any[], showAll: boolean) {
      if (!visibleResults.length) {
        return '';
      }

      const remaining = allResults.length - visibleResults.length;
      const queryLink = encodeURIComponent(this.lastUserQuery || this.currentQuery);

      return `
        <section class="search-modal__section">
          <div class="search-modal__section-heading">
            <div>
              <h3 class="search-modal__section-title">Articles</h3>
              <p class="search-modal__section-subtitle">${allResults.length} article${allResults.length === 1 ? '' : 's'}</p>
            </div>
            <a href="/blog?q=${queryLink}" class="search-modal__section-link">
              View all articles →
            </a>
              </div>
          <div class="space-y-2">
            ${visibleResults.map((item) => this.buildArticleCard(item, allResults.indexOf(item))).join('')}
            </div>
          ${allResults.length > MAX_INITIAL_ARTICLES ? `
            <div class="search-modal__section-footer">
              <button
                type="button"
                class="search-modal__more-button"
                data-toggle="articles"
              >
                ${showAll ? 'Show fewer articles' : `Show ${remaining} more article${remaining === 1 ? '' : 's'}`}
              </button>
            </div>
          ` : ''}
        </section>
      `;
    }

    buildGlossaryCard(item: any, index: number) {
      const snippetSource = item.snippet || item.summary || item.definition || '';
      const snippet = this.highlightText(this.trimSnippet(this.cleanSnippet(snippetSource)), this.currentQuery);
      const aliases = Array.isArray(item.aliases) ? item.aliases.filter(Boolean) : [];
      const aliasChips = aliases.slice(0, 3).map((alias: string) => `<span class="search-modal__meta-badge">${alias}</span>`).join('');

      return `
        <a
          href="${item.url}"
          class="search-modal__result search-modal__result--glossary"
          data-result-type="glossary"
          data-result-rank="${index + 1}"
          data-result-category="${item.categoryRaw || ''}"
        >
          <div class="search-modal__result-kicker">${item.category || 'Glossary'}</div>
          <h4 class="search-modal__result-title">${this.highlightText(item.term, this.currentQuery)}</h4>
          <p class="search-modal__result-body">${snippet}</p>
          ${aliasChips ? `<div class="search-modal__result-meta">${aliasChips}</div>` : ''}
        </a>
      `;
    }

    buildArticleCard(item: any, index: number) {
      const snippetSource = item.excerpt || item.summary || item.content || '';
      const snippet = this.highlightText(this.trimSnippet(this.cleanSnippet(snippetSource)), this.currentQuery);
      const metaParts: string[] = [];
      const formattedDate = this.formatDate(item.publishedAt || null);
      if (formattedDate) {
        metaParts.push(formattedDate);
      }
      const readingTimeLabel = this.formatReadingTime(item.readingTime);
      if (readingTimeLabel) {
        metaParts.push(readingTimeLabel);
      }

      const tags = (Array.isArray(item.tags) ? item.tags : []).slice(0, 2);

      return `
        <a
          href="${item.url}"
          class="search-modal__result search-modal__result--article"
          data-result-type="article"
          data-result-rank="${index + 1}"
          data-result-category="${item.categoryRaw || ''}"
        >
          <div class="search-modal__result-kicker">${item.category || 'Article'}</div>
          <h4 class="search-modal__result-title">${this.highlightText(item.title, this.currentQuery)}</h4>
          ${metaParts.length || tags.length ? `
            <div class="search-modal__result-meta">
              ${metaParts.length ? `<span>${metaParts.join(' • ')}</span>` : ''}
              ${tags.length ? `<span class="search-modal__meta-badge">${tags.join(' • ')}</span>` : ''}
            </div>
          ` : ''}
          <p class="search-modal__result-body">${snippet}</p>
        </a>
      `;
    }

    trimSnippet(text: string, limit = 220) {
      if (!text) return '';
      if (text.length <= limit) return text;
      const truncated = text.slice(0, limit);
      const lastSpace = truncated.lastIndexOf(' ');
      const safeSlice = lastSpace > limit * 0.6 ? truncated.slice(0, lastSpace) : truncated;
      return `${safeSlice.trim()}…`;
    }

    cleanSnippet(text: string) {
      if (!text) return '';
      return text
        .replace(/<\/?mark[^>]*>/gi, '')
        .replace(/<\/?em[^>]*>/gi, '')
        .replace(/<\/?strong[^>]*>/gi, '')
        .replace(/<[^>]+>/g, ' ')
        .replace(/\s+/g, ' ')
        .replace(/\b([A-Za-z0-9]+)\b(?:\s+\1\b){1,}/gi, '$1')
        .trim();
    }
    
    highlightText(text: string, query: string) {
      if (!query || !text) return text;
      const tokens = this.getHighlightTokens(query);
      if (!tokens.length) {
        return text;
      }
      const pattern = tokens.map((token) => this.escapeRegExp(token)).join('|');
      const regex = new RegExp(`(${pattern})`, 'gi');
      const ranges: Array<[number, number]> = [];

      let match: RegExpExecArray | null;
      while ((match = regex.exec(text)) !== null) {
        const start = match.index;
        const end = start + match[0].length;
        ranges.push(this.expandHighlightRange(text, start, end));

        if (match[0].length === 0) {
          regex.lastIndex += 1;
        }
      }

      if (!ranges.length) {
        return text;
      }

      const merged = this.mergeHighlightRanges(ranges);

      let result = '';
      let lastIndex = 0;
      for (const [start, end] of merged) {
        result += text.slice(lastIndex, start);
        result += `<mark class="search-highlight">${text.slice(start, end)}</mark>`;
        lastIndex = end;
      }
      result += text.slice(lastIndex);
      return result;
    }

    getHighlightTokens(query: string) {
      return Array.from(new Set(
        query
          .split(/\s+/)
          .map((token) => token.trim())
          .filter(Boolean)
      )).slice(0, 6);
    }

    escapeRegExp(value: string) {
      return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    expandHighlightRange(text: string, start: number, end: number): [number, number] {
      let rangeStart = start;
      let rangeEnd = end;

      while (rangeStart > 0 && this.isWordChar(text.charAt(rangeStart - 1))) {
        rangeStart -= 1;
      }

      while (rangeEnd < text.length && this.isWordChar(text.charAt(rangeEnd))) {
        rangeEnd += 1;
      }

      return [rangeStart, rangeEnd];
    }

    mergeHighlightRanges(ranges: Array<[number, number]>) {
      const sorted = ranges
        .map(([start, end]) => [start, end] as [number, number])
        .sort((a, b) => a[0] - b[0]);

      const merged: Array<[number, number]> = [];
      if (!sorted.length) {
        return merged;
      }

      let [currentStart, currentEnd] = sorted[0];
      for (let i = 1; i < sorted.length; i += 1) {
        const [start, end] = sorted[i];
        if (start <= currentEnd) {
          currentEnd = Math.max(currentEnd, end);
        } else {
          merged.push([currentStart, currentEnd]);
          currentStart = start;
          currentEnd = end;
        }
      }
      merged.push([currentStart, currentEnd]);
      return merged;
    }

    isWordChar(value: string) {
      if (!value) {
        return false;
      }
      return /[A-Za-z0-9]/.test(value) || value === '-' || value === '_' || value === '\'' || value === '’';
    }

    attachResultHandlers() {
      if (!this.results) {
        return;
      }

      this.results.querySelectorAll<HTMLButtonElement>('[data-toggle]').forEach((button) => {
        button.addEventListener('click', () => {
          const target = button.dataset.toggle === 'glossary' ? 'glossary' : 'articles';
          this.handleMoreToggle(target);
        });
      });

      this.resultAnchors = Array.from(this.results.querySelectorAll<HTMLAnchorElement>('a.search-modal__result'));
      this.focusedResultIndex = -1;

      this.resultAnchors.forEach((link, index) => {
        link.addEventListener('click', (event) => this.handleResultClick(event, index));
        link.addEventListener('mouseenter', () => this.setFocusedResultIndex(index, false));
        link.addEventListener('focus', () => this.setFocusedResultIndex(index, false));
      });
    }

    handleMoreToggle(target: 'glossary' | 'articles') {
      if (target === 'glossary') {
        this.showAllGlossary = !this.showAllGlossary;
      } else {
        this.showAllArticles = !this.showAllArticles;
      }
      this.renderResults();
      this.emitAnalyticsEvent('soranauts:search-toggle', {
        target,
        state: target === 'glossary' ? (this.showAllGlossary ? 'expanded' : 'collapsed') : (this.showAllArticles ? 'expanded' : 'collapsed'),
        query: this.lastUserQuery,
      });
    }

    handleTypeFilterChange(type: 'all' | 'glossary' | 'articles') {
      if (this.activeFilters.type === type) {
        return;
      }
      this.activeFilters.type = type;
      if (type !== 'glossary') {
        this.activeFilters.glossaryCategory = 'all';
        this.showAllGlossary = false;
      }
      if (type !== 'articles') {
        this.activeFilters.articleCategory = 'all';
        this.showAllArticles = false;
      }
      this.renderTypeFilters(this.getCurrentCounts());
      this.renderCategoryFilters();
      this.renderResults();
      this.emitAnalyticsEvent('soranauts:search-filter', {
        filter: 'type',
        value: type,
        query: this.lastUserQuery,
      });
    }

    handleCategoryFilterChange(value: string) {
      if (this.activeFilters.type === 'glossary') {
        this.activeFilters.glossaryCategory = value === 'all' ? 'all' : value;
        this.showAllGlossary = false;
      } else if (this.activeFilters.type === 'articles') {
        this.activeFilters.articleCategory = value === 'all' ? 'all' : value;
        this.showAllArticles = false;
      }
      this.renderCategoryFilters();
      this.renderResults();
      this.emitAnalyticsEvent('soranauts:search-filter', {
        filter: 'category',
        value,
        type: this.activeFilters.type,
        query: this.lastUserQuery,
      });
    }

    setFocusedResultIndex(index: number, shouldFocus = true) {
      if (index < 0 || index >= this.resultAnchors.length) {
        this.focusedResultIndex = -1;
        this.updateResultFocus(false);
        return;
      }
      this.focusedResultIndex = index;
      this.updateResultFocus(shouldFocus);
    }

    updateResultFocus(shouldFocus = true) {
      this.resultAnchors.forEach((link, idx) => {
        if (idx === this.focusedResultIndex) {
          link.classList.add('search-modal__result--active');
          if (shouldFocus) {
            link.focus({ preventScroll: true });
          }
        } else {
          link.classList.remove('search-modal__result--active');
        }
      });
    }

    handleResultClick(event: Event, index: number) {
      const link = event.currentTarget as HTMLAnchorElement;
      this.setFocusedResultIndex(index, false);
      this.emitAnalyticsEvent('soranauts:search-result-click', {
        query: this.lastUserQuery,
        url: link.getAttribute('href'),
        rank: Number(link.dataset.resultRank) || index + 1,
        type: link.dataset.resultType || 'unknown',
        category: link.dataset.resultCategory || null,
      });
    }

    handleKeyboardNavigation(event: KeyboardEvent) {
      if (!this.resultAnchors.length) {
        return;
      }
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        const nextIndex = (this.focusedResultIndex + 1 + this.resultAnchors.length) % this.resultAnchors.length;
        this.setFocusedResultIndex(nextIndex);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        const prevIndex = (this.focusedResultIndex - 1 + this.resultAnchors.length) % this.resultAnchors.length;
        this.setFocusedResultIndex(prevIndex);
      } else if (event.key === 'Enter' && this.focusedResultIndex >= 0) {
        event.preventDefault();
        this.resultAnchors[this.focusedResultIndex].click();
      }
    }

    parseTags(raw: any) {
      if (!raw) return [];
      if (Array.isArray(raw)) {
        return raw.map((tag) => String(tag)).filter(Boolean);
      }
      if (typeof raw === 'string') {
        return raw
          .split(',')
          .map((tag) => tag.trim())
          .filter(Boolean);
      }
      return [];
    }

    normalizeReadingTime(value: any) {
      if (value === null || value === undefined) {
        return null;
      }
      const minutes = Number(value);
      if (Number.isNaN(minutes) || minutes <= 0) {
        return null;
      }
      return Math.max(1, Math.round(minutes));
    }

    formatReadingTime(minutes: number | null) {
      if (!minutes) {
        return null;
      }
      return `${minutes} min read`;
    }

    formatDate(value: string | null) {
      if (!value) {
        return null;
      }
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) {
        return null;
      }
      try {
        return this.dateFormatter.format(date);
      } catch (error) {
        return date.toISOString().split('T')[0];
      }
    }

    formatCategoryLabel(value: string) {
      if (!value) return 'General';
      const normalized = value.toLowerCase();
      if (CATEGORY_LABEL_OVERRIDES[normalized]) {
        return CATEGORY_LABEL_OVERRIDES[normalized];
      }
      return value
        .replace(/[-_]/g, ' ')
        .replace(/\b\w/g, (char) => char.toUpperCase());
    }

    expandQueryWithSynonyms(query: string) {
      const tokens = query.split(/\s+/).filter(Boolean);
      const expansions = new Set<string>();
      tokens.forEach((token) => {
        expansions.add(token);
        const synonyms = SYNONYM_MAP[token.toLowerCase()];
        synonyms?.forEach((syn) => expansions.add(syn));
      });
      return Array.from(expansions).join(' ');
    }

    emitAnalyticsEvent(name: string, detail: Record<string, unknown>) {
      try {
        document.dispatchEvent(new CustomEvent(name, { detail }));
        if (typeof window !== 'undefined' && (window as any).posthog?.capture) {
          (window as any).posthog.capture(name, detail);
        }
      } catch (error) {
        console.debug('Analytics event skipped', error);
      }
    }
    
    shouldPrioritizeGlossary(query: string, glossaryResults: any[]) {
      if (!glossaryResults?.length) return false;
      
      // Exact term match
      const exact = glossaryResults.some(item => 
        item.term?.toLowerCase() === query.toLowerCase()
      );
      
      // Short queries (likely looking for definitions)
      const isShort = query.length <= 5 && /^[a-zA-Z0-9]+$/.test(query);
      
      // Contains common crypto/DeFi terms
      const cryptoTerms = ['xor', 'val', 'pswap', 'kusd', 'defi', 'dex', 'swap', 'token', 'crypto'];
      const isCryptoTerm = cryptoTerms.some(term => 
        query.toLowerCase().includes(term)
      );
      
      return exact || isShort || isCryptoTerm;
    }
    
    showError() {
      this.loading?.classList.add('hidden');
      this.noResults?.classList.remove('hidden');
      if (this.noResults) {
        this.noResults.innerHTML = `
          <svg class="mx-auto h-12 w-12 text-status-error" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z" />
          </svg>
          <h3 class="mt-2 text-sm font-medium text-text-main">Search Error</h3>
          <p class="mt-1 text-sm text-text-soft">Unable to search. Please try again later.</p>
        `;
      }
    }
    
    showDevelopmentMessage() {
      this.loading?.classList.add('hidden');
      this.noResults?.classList.remove('hidden');
      if (this.noResults) {
        this.noResults.innerHTML = `
          <svg class="mx-auto h-12 w-12 text-status-warning" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <h3 class="mt-2 text-sm font-medium text-text-main">Search in Development</h3>
          <p class="mt-1 text-sm text-text-soft">Search is only available in production builds. Run <code class="rounded bg-soft px-1">npm run build</code> to test search functionality.</p>
        `;
      }
      if (this.count) this.count.textContent = 'Development mode';
    }
  }
  
  // Initialize search modal when DOM is loaded
  document.addEventListener('DOMContentLoaded', () => {
    new SearchModal();
  });
</script>
