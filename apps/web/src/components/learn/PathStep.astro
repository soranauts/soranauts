---
/**
 * PathStep.astro
 * 
 * Individual step in a learning path.
 * Uses <details> for no-JS expand/collapse support.
 */
interface Props {
  step: {
    type: 'tag' | 'glossary';
    slug: string;
    title: string;
    summary?: string;
  };
  stepNumber: number;
  isActive: boolean;
  isCompleted: boolean;
}

const { step, stepNumber, isActive, isCompleted } = Astro.props;

// Determine step state for styling
const state = isCompleted ? 'completed' : isActive ? 'active' : 'upcoming';

// Build the link to the full content
const contentUrl = step.type === 'glossary' 
  ? `/glossary/${step.slug}` 
  : `/tag/${step.slug}`;
---

<details 
  class="path-step" 
  data-state={state}
  open={isActive}
>
  <summary class="path-step__header">
    <span class="path-step__number" aria-label={`Step ${stepNumber}`}>
      {isCompleted ? (
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M3 7L6 10L11 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      ) : (
        stepNumber
      )}
    </span>
    <span class="path-step__title">{step.title}</span>
    <span class="path-step__type">{step.type}</span>
    <svg class="path-step__chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </summary>

  <div class="path-step__content">
    {step.summary ? (
      <p class="path-step__summary">{step.summary}</p>
    ) : (
      <p class="path-step__summary path-step__summary--placeholder">
        Click "Learn More" to explore this topic in detail.
      </p>
    )}

    <div class="path-step__actions">
      <a href={contentUrl} class="path-step__link" target="_blank" rel="noopener">
        Learn More
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M2 10L10 2M10 2H4M10 2V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</details>

<style>
  .path-step {
    --step-color: var(--color-text-muted);
    --step-bg: transparent;
    --step-border: var(--color-border);
    
    border: 1px solid var(--step-border);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-3);
    overflow: hidden;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  /* State: Upcoming (default) */
  .path-step[data-state="upcoming"] {
    --step-color: var(--color-text-muted);
    --step-bg: transparent;
  }

  /* State: Active */
  .path-step[data-state="active"] {
    --step-color: var(--red-600);
    --step-bg: color-mix(in srgb, var(--red-600) 5%, transparent 95%);
    --step-border: var(--red-600);
    box-shadow: var(--shadow-sm);
  }

  /* State: Completed */
  .path-step[data-state="completed"] {
    --step-color: #22c55e;
    --step-bg: color-mix(in srgb, #22c55e 5%, transparent 95%);
    --step-border: color-mix(in srgb, #22c55e 30%, var(--color-border) 70%);
  }

  .path-step__header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    cursor: pointer;
    list-style: none;
    background: var(--step-bg);
    transition: background 0.15s ease;
  }

  .path-step__header::-webkit-details-marker {
    display: none;
  }

  .path-step__header:hover {
    background: var(--color-surface-hover);
  }

  .path-step__number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    font-size: var(--text-sm);
    font-weight: 700;
    color: white;
    background: var(--step-color);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .path-step[data-state="upcoming"] .path-step__number {
    background: var(--color-border);
    color: var(--color-text-muted);
  }

  .path-step__title {
    flex-grow: 1;
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text);
  }

  .path-step__type {
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    padding: var(--space-1) var(--space-2);
    background: var(--color-surface);
    border-radius: var(--radius-sm);
  }

  .path-step__chevron {
    color: var(--color-text-muted);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .path-step[open] .path-step__chevron {
    transform: rotate(180deg);
  }

  .path-step__content {
    padding: 0 var(--space-4) var(--space-4);
    padding-left: calc(var(--space-4) + 28px + var(--space-3));
  }

  .path-step__summary {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0 0 var(--space-4);
  }

  .path-step__summary--placeholder {
    font-style: italic;
  }

  .path-step__actions {
    display: flex;
    gap: var(--space-3);
  }

  .path-step__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--red-600);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .path-step__link:hover {
    color: var(--red-700);
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: reduce) {
    .path-step,
    .path-step__header,
    .path-step__chevron {
      transition: none;
    }
  }
</style>
