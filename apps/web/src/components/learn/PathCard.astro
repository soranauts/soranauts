---
/**
 * PathCard.astro
 * 
 * Card component for displaying a learning path in the index grid.
 * Links to the full path page at /learn/[path.id]
 */
import type { LearningPath } from '~/data/learning-paths.config';

interface Props {
  path: LearningPath;
}

const { path } = Astro.props;

// Difficulty configuration
const difficultyConfig = {
  beginner: { color: '#22c55e', label: 'Beginner' },
  intermediate: { color: '#eab308', label: 'Intermediate' },
  advanced: { color: '#ef4444', label: 'Advanced' },
};

// Category icons
const categoryIcons = {
  ecosystem: '🌐',
  architecture: '🏗️',
  defi: '💰',
};

const difficulty = difficultyConfig[path.difficulty];
const categoryIcon = categoryIcons[path.category];
---

<a href={`/learn/${path.id}`} class="path-card" style={`--accent-color: ${difficulty.color}`}>
  <header class="path-card__header">
    <span class="path-card__category" aria-label={`Category: ${path.category}`}>
      {categoryIcon}
    </span>
    <span class="path-card__difficulty">
      <span class="path-card__difficulty-dot" aria-hidden="true"></span>
      {difficulty.label}
    </span>
  </header>

  <h3 class="path-card__title">{path.title}</h3>
  
  <p class="path-card__description">{path.description}</p>

  <footer class="path-card__footer">
    <span class="path-card__meta">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <rect x="2" y="4" width="10" height="8" rx="1" stroke="currentColor" stroke-width="1.5"/>
        <path d="M5 4V2.5C5 1.67 5.67 1 6.5 1H7.5C8.33 1 9 1.67 9 2.5V4" stroke="currentColor" stroke-width="1.5"/>
        <line x1="2" y1="7" x2="12" y2="7" stroke="currentColor" stroke-width="1.5"/>
      </svg>
      {path.steps.length} steps
    </span>
    <span class="path-card__meta">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.5"/>
        <path d="M7 4V7L9 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      {path.estimatedMinutes} min
    </span>
  </footer>

  {path.cta && (
    <span class="path-card__cta-hint">
      Includes: {path.cta.label}
    </span>
  )}
</a>

<style>
  .path-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--accent-color, var(--color-accent));
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }

  .path-card:hover {
    border-color: var(--accent-color, var(--color-accent));
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .path-card:focus-visible {
    outline: 2px solid var(--accent-color, var(--color-accent));
    outline-offset: 2px;
  }

  .path-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .path-card__category {
    font-size: var(--text-lg);
  }

  .path-card__difficulty {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .path-card__difficulty-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-color);
  }

  .path-card__title {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 var(--space-2);
    line-height: 1.3;
  }

  .path-card__description {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0 0 var(--space-4);
    flex-grow: 1;
    /* Truncate to ~2 lines */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .path-card__footer {
    display: flex;
    gap: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .path-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .path-card__cta-hint {
    display: block;
    margin-top: var(--space-3);
    padding-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--accent-color);
    font-weight: 500;
  }

  @media (prefers-reduced-motion: reduce) {
    .path-card {
      transition: none;
    }

    .path-card:hover {
      transform: none;
    }
  }
</style>
