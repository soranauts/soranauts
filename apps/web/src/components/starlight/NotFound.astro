---
/**
 * Custom Starlight 404 component
 * Uses Starlight's default layout but with Soranauts-branded content
 */
import Default from '@astrojs/starlight/components/NotFound.astro';
---

<div class="custom-404">
  <div class="custom-404__content">
    <h1 class="custom-404__code">404</h1>
    <h2 class="custom-404__title">Page Not Found</h2>
    <p class="custom-404__message">
      Sorry, we couldn't find this page. But don't worry, you can find plenty of other things on our site.
    </p>
    <div class="custom-404__actions">
      <a href="/" class="custom-404__btn custom-404__btn--primary">
        Back to Homepage
      </a>
      <a href="/glossary" class="custom-404__btn custom-404__btn--secondary">
        Browse Glossary
      </a>
      <a href="/docs" class="custom-404__btn custom-404__btn--secondary">
        Explore Docs
      </a>
    </div>
  </div>
</div>

<style>
  .custom-404 {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 50vh;
    padding: 2rem;
    text-align: center;
  }

  .custom-404__content {
    max-width: 500px;
  }

  .custom-404__code {
    font-size: 6rem;
    font-weight: 800;
    color: var(--sl-color-accent);
    margin: 0;
    line-height: 1;
  }

  .custom-404__title {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--sl-color-white);
    margin: 0.5rem 0 1rem;
  }

  .custom-404__message {
    font-size: 1rem;
    color: var(--sl-color-gray-3);
    margin: 0 0 2rem;
    line-height: 1.6;
  }

  .custom-404__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .custom-404__btn {
    display: inline-flex;
    align-items: center;
    padding: 0.625rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: 0.5rem;
    transition: all 0.15s ease;
  }

  .custom-404__btn--primary {
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
  }

  .custom-404__btn--primary:hover {
    filter: brightness(1.1);
  }

  .custom-404__btn--secondary {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
    border: 1px solid var(--sl-color-gray-5);
  }

  .custom-404__btn--secondary:hover {
    background: var(--sl-color-gray-5);
  }
</style>
