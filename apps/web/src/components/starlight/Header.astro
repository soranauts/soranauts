---
/**
 * Custom Starlight Header
 * 
 * Completely replaces Starlight header to add Soranauts navigation.
 * Adds links to /glossary, /blog, and home for cross-site navigation.
 */
import type { Props } from '@astrojs/starlight/props';
import Search from './Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
---

<div class="header sl-flex">
  <div class="header-left sl-flex">
    <SiteTitle {...Astro.props} />
  </div>
  
  <div class="header-center sl-flex">
    <Search {...Astro.props} />
  </div>
  
  <div class="header-right sl-flex">
    <nav class="soranauts-nav">
      <a href="/glossary" class="nav-link" data-nav="glossary">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path>
        </svg>
        <span>Glossary</span>
      </a>
      <a href="/blog" class="nav-link" data-nav="blog">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 19l7-7 3 3-7 7-3-3z"></path>
          <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path>
          <path d="M2 2l7.586 7.586"></path>
          <circle cx="11" cy="11" r="2"></circle>
        </svg>
        <span>Blog</span>
      </a>
      <a href="/" class="nav-link nav-link-home" data-nav="home">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        <span>Home</span>
      </a>
    </nav>
    <div class="sl-hidden md:sl-flex right-group">
      <SocialIcons {...Astro.props} />
      <ThemeSelect {...Astro.props} />
    </div>
  </div>
</div>

<style>
  .header {
    gap: var(--sl-nav-gap);
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }

  .header-left,
  .header-center,
  .header-right {
    align-items: center;
    gap: 0.5rem;
  }

  .header-right {
    gap: 1rem;
  }

  .right-group {
    gap: 0.5rem;
    align-items: center;
  }

  .soranauts-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.65rem;
    border-radius: 0.375rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: rgb(var(--sl-color-gray-2));
    text-decoration: none;
    transition: color 150ms ease, background-color 150ms ease;
  }

  .nav-link:hover {
    color: rgb(var(--sl-color-white));
    background-color: rgba(var(--sl-color-gray-5), 0.5);
  }

  .nav-link svg {
    flex-shrink: 0;
    opacity: 0.7;
  }

  .nav-link:hover svg {
    opacity: 1;
  }

  /* Highlight active section */
  .nav-link[data-nav="glossary"][aria-current="page"],
  .nav-link[data-nav="blog"][aria-current="page"] {
    color: rgb(227, 36, 45); /* SORA Red */
  }

  /* Hide text on small screens, show icons only */
  @media (max-width: 50rem) {
    .nav-link span {
      display: none;
    }
    
    .nav-link {
      padding: 0.5rem;
    }
    
    .soranauts-nav {
      gap: 0.125rem;
    }
  }

  /* Light mode adjustments */
  :root[data-theme='light'] .nav-link {
    color: rgb(var(--sl-color-gray-2));
  }

  :root[data-theme='light'] .nav-link:hover {
    color: rgb(var(--sl-color-gray-1));
    background-color: rgba(0, 0, 0, 0.05);
  }
</style>

