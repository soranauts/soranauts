---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { getHomePermalink } from '~/utils/permalinks';
import soranautsLogo from '~/assets/images/new-logo-250x80.png';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote = '', theme = 'light' } = Astro.props;

// Helper function to check if a link is external
const isExternalLink = (href?: string): boolean => {
  if (!href) return false;
  return href.startsWith('http://') || href.startsWith('https://');
};
---

<footer class:list={[{ dark: theme === 'dark' }, 'relative border-t border-border-subtle bg-soft dark:bg-page not-prose']}>
  <div class="absolute inset-0 pointer-events-none bg-soft/60 dark:bg-page/80" aria-hidden="true"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 text-text-soft">
    <div class="grid grid-cols-12 gap-4 gap-y-8 sm:gap-8 py-8 md:py-12">
      <div class="col-span-12 lg:col-span-4">
        <div>
          <a class="inline-block" href={getHomePermalink()}>
            <Image
              src={soranautsLogo}
              alt="Soranauts"
              class="image-rendering-crisp-edges w-[225px] h-[72px] object-contain"
            />
          </a>
        </div>
        {
          secondaryLinks.length ? (
            <nav class="mt-4 text-sm text-text-soft" aria-label="Footer secondary links">
              <ul class="flex flex-wrap items-center gap-y-2">
                {
                  secondaryLinks.map(({ text, href, ariaLabel }, index) => {
                    const isExternal = isExternalLink(href);
                    return (
                      <li class="flex items-center">
                        {index > 0 && (
                          <span class="mx-2 text-text-soft/70" aria-hidden="true">|</span>
                        )}
                        <a
                          class="inline-flex items-center gap-1.5 text-text-soft hover:text-link hover:underline focus-visible:outline-none focus-visible:text-link focus-visible:underline transition duration-150 ease-in-out"
                          href={href}
                          aria-label={ariaLabel ?? text}
                          {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                        >
                          {text ? <span set:html={text}></span> : null}
                          {isExternal && (
                            <Icon name="tabler:external-link" class="w-3 h-3 flex-shrink-0 opacity-70" aria-hidden="true" />
                          )}
                        </a>
                      </li>
                    );
                  })
                }
              </ul>
            </nav>
          ) : null
        }
      </div>
      <nav aria-label="Footer navigation" class="contents">
        {
          links.map(({ title, links: sectionLinks }) => (
            <div class="col-span-6 md:col-span-3 lg:col-span-2">
              {title ? (
                <h3 class="text-xs font-semibold tracking-wide text-text-main uppercase mb-3">
                  {title}
                </h3>
              ) : null}
              {sectionLinks && Array.isArray(sectionLinks) && sectionLinks.length > 0 && (
                <ul class="text-sm space-y-2.5">
                  {sectionLinks.map(({ text, href, ariaLabel, icon }) => {
                    const isExternal = isExternalLink(href);
                    return (
                      <li>
                        <a
                          class="inline-flex items-center gap-1.5 text-text-soft hover:text-link hover:underline focus-visible:outline-none focus-visible:text-link focus-visible:underline transition duration-150 ease-in-out"
                          href={href}
                          aria-label={ariaLabel ?? text}
                          {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                        >
                          {text ? <span set:html={text}></span> : null}
                          {icon ? (
                            <Icon name={icon} class="w-3.5 h-3.5 flex-shrink-0" aria-hidden="true" />
                          ) : isExternal ? (
                            <Icon name="tabler:external-link" class="w-3.5 h-3.5 flex-shrink-0 opacity-70" aria-hidden="true" />
                          ) : null}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              )}
            </div>
          ))
        }
      </nav>
    </div>
    <div class="flex flex-col gap-4 py-6 md:py-8 md:flex-row md:items-center md:justify-between">
      <div class="text-sm text-text-soft">
        {footNote ? <span set:html={footNote}></span> : null}
      </div>
      {
        socialLinks?.length ? (
          <ul class="flex flex-wrap items-center gap-2 md:justify-end">
            {socialLinks.map(({ ariaLabel, href, text, icon }) => (
              <li>
                <a
                  class="text-text-soft hover:text-link hover:bg-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 focus-visible:ring-offset-surface rounded-lg text-sm p-2.5 inline-flex items-center transition-colors duration-200"
                  aria-label={ariaLabel ?? text}
                  href={href}
                  title={ariaLabel ?? text ?? undefined}
                >
                  {icon && <Icon name={icon} class="w-5 h-5" />}
                  {text ? <span class="ml-2" set:html={text}></span> : null}
                </a>
              </li>
            ))}
          </ul>
        ) : null
      }
    </div>
  </div>
</footer>
