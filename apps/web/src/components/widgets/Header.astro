---
import { Icon } from "astro-icon/components";
import Logo from "~/components/Logo.astro";
import ToggleTheme from "~/components/common/ToggleTheme.astro";
import ToggleMenu from "~/components/common/ToggleMenu.astro";
import Button from "~/components/ui/Button.astro"

import { getHomePermalink } from "~/utils/permalinks";
import { trimSlash, getAsset } from "~/utils/permalinks";
import type { CallToAction } from "~/types";

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface ActionLink extends CallToAction {}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<ActionLink>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = "header",
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = "center",
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`

const primaryLinkLabels = new Set(['Blog', 'Explore', 'SORA Explorer', 'Glossary', 'Docs']);
const primaryLinks = links.filter(({ text }) => text && primaryLinkLabels.has(text));
const secondaryLinks = links.filter(({ text }) => !text || !primaryLinkLabels.has(text));
const showLayeredLogo = import.meta.env.NAV_LOGO_LAYERED === 'true';

const linkMap = new Map<string, MenuLink>(links.map((link) => [link.text ?? '', link]));

const desktopNavOrder = ['Explore', 'Docs', 'Blog', 'Glossary', 'Features', 'About', 'Donate'];
const desktopNavLinks = desktopNavOrder
  .map((label) => linkMap.get(label))
  .filter((link): link is MenuLink => Boolean(link));

const wikiButtonClass = 'sora-wiki-pill';
const iconButtonClass =
  'inline-flex h-11 w-11 lg:h-12 lg:w-12 items-center justify-center rounded-full text-text-muted transition-colors duration-200 hover:text-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 focus-visible:ring-offset-surface';
---

<header
  class:list={[
    { dark: isDark },
    "site-header fixed inset-x-0 top-0 z-50 w-full transition-[opacity] ease-in-out",
  ]}
  {...isSticky ? { "data-aw-sticky-header":  true } : {}}
  {...id ? { id } : {}}
>
  <div class="header-surface absolute inset-0"></div>
  <div
    class="mobile-nav-overlay absolute inset-0 lg:hidden"
    aria-hidden="true"
    data-aw-mobile-overlay
  ></div>
  <div
    class:list={[
      "header-inner text-text-main",
      {
        "max-w-7xl": !isFullWidth,
      },
    ]}
  >
    <div
      class:list={[
        { "mr-auto rtl:mr-0 rtl:ml-auto": position === "right" },
        "flex w-full items-center justify-between lg:hidden",
      ]}
    >
      <a class="flex items-center" href={getHomePermalink()}>
        <Logo />
      </a>
      <div class="ml-2 flex items-center">
        <ToggleMenu />
      </div>
    </div>

    <div class="hidden w-full items-center justify-between gap-4 lg:flex lg:gap-8">
      <div class="flex items-center">
        <a class="flex items-center" href={getHomePermalink()}>
          <Logo />
        </a>
      </div>
      <nav class="flex flex-1 justify-center" aria-label="Primary navigation">
        <ul class="flex items-center gap-4 lg:gap-6 text-xs lg:text-sm font-medium">
          {desktopNavLinks.map((link) => {
            const isActive = link.href === currentPath;
            return (
              <li>
                <a
                  class:list={[
                    "nav-link text-xs lg:text-sm font-medium tracking-tight hover:underline decoration-2 underline-offset-8",
                    { active: isActive },
                  ]}
                  href={link.href}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {link.text}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
      <div class="flex items-center gap-2 lg:gap-3">
        {showToggleTheme && (
          <ToggleTheme
            class={iconButtonClass}
            iconClass="w-5 h-5"
          />
        )}
        <button
          type="button"
          id="search-trigger"
          data-aw-search-trigger
          class={iconButtonClass}
          aria-label="Search"
          title="Search (⌘K)"
        >
          <Icon name="tabler:search" class="h-5 w-5" />
        </button>
        {showRssFeed && (
          <a
            class={iconButtonClass}
            aria-label="RSS Feed"
            href={getAsset('/rss.xml')}
          >
            <Icon name="tabler:rss" class="h-5 w-5" />
          </a>
        )}
        {actions?.length ? (
          <span class="flex items-center">
            {actions.map((btnProps) => (
              <Button {...btnProps} class={wikiButtonClass} />
            ))}
          </span>
        ) : null}
      </div>
    </div>

    <nav
      data-aw-mobile-nav
      class:list={["mobile-nav lg:hidden text-text-main"]}
      aria-label="Main navigation"
      aria-hidden="true"
    >
      {showLayeredLogo && (
        <div class="drawer-logo-top">
          <Logo class="drawer-logo-top__logo" />
        </div>
      )}
      <div
        class:list={[
          "lg:hidden flex h-full flex-col gap-10 pb-6",
          showLayeredLogo ? "pt-20" : "",
        ]}
      >
        <div class="space-y-8 pb-6 grow">
          <div class="flex items-center justify-between px-6 pt-6 pb-2">
            <div class="flex flex-col gap-1">
              <a class="flex items-center gap-3" href={getHomePermalink()}>
                <Logo />
              </a>
              <p class="mb-4 text-sm tracking-wide text-text-secondary opacity-90">Chart the Network</p>
            </div>
            <button
              type="button"
              class="flex h-12 w-12 min-h-[44px] min-w-[44px] items-center justify-center rounded-full border border-border-subtle bg-surface/80 text-text-muted transition-colors duration-200 hover:text-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
              aria-label="Close menu"
              aria-expanded="false"
              data-aw-toggle-menu
            >
              <Icon name="tabler:x" class="h-5 w-5" />
            </button>
          </div>

          {primaryLinks.length ? (
            <div class="px-6">
              <ul class="space-y-4">
                {primaryLinks.map(({ text, href, links: nestedLinks = [] }) => {
                  const isActive = href === currentPath;
                  return (
                    <li>
                      {href ? (
                        <a
                          data-mobile-link
                          data-active={isActive ? 'true' : 'false'}
                          class="mobile-primary-link"
                          href={href}
                          aria-current={isActive ? 'page' : undefined}
                        >
                          <span>{text}</span>
                          <Icon name="tabler:arrow-up-right" class="h-4 w-4 text-brand-400" />
                        </a>
                      ) : (
                        <div class="mobile-primary-link" data-active="false">
                          {text}
                        </div>
                      )}
                      {nestedLinks.length ? (
                        <ul class="mobile-sub-list">
                          {nestedLinks.map(({ text: childText, href: childHref }) => {
                            const childActive = childHref === currentPath;
                            return (
                              <li>
                                <a
                                  data-mobile-link
                                  class="mobile-secondary-link"
                                  data-active={childActive ? 'true' : 'false'}
                                  href={childHref}
                                  aria-current={childActive ? 'page' : undefined}
                                >
                                  {childText}
                                </a>
                              </li>
                            );
                          })}
                        </ul>
                      ) : null}
                    </li>
                  );
                })}
              </ul>
            </div>
          ) : null}

          {secondaryLinks.length ? (
            <div class="px-6 mt-8 space-y-3">
              <p class="text-xs uppercase tracking-wide text-text-soft">More</p>
              <ul class="space-y-3">
                {secondaryLinks.map(({ text, href }) => {
                  const isActive = href === currentPath;
                  return (
                    <li>
                      {href ? (
                        <a
                          data-mobile-link
                          class="mobile-secondary-link"
                          data-active={isActive ? 'true' : 'false'}
                          href={href}
                          aria-current={isActive ? 'page' : undefined}
                        >
                          {text}
                        </a>
                      ) : (
                        <span class="mobile-secondary-link" data-active="false">
                          {text}
                        </span>
                      )}
                    </li>
                  );
                })}
              </ul>
            </div>
          ) : null}
        </div>

        <div data-aw-mobile-utilities class="mobile-utility-bar mt-auto px-6 pb-6">
          <div class="mobile-utility-surface">
            <div class="flex items-center gap-2">
              {showToggleTheme && (
                <ToggleTheme
                  class="rounded-xl px-3 py-3 min-h-[44px] min-w-[44px] text-text-muted transition-colors duration-200 hover:text-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
                  iconClass="w-6 h-6"
                />
              )}
              <button
                data-aw-search-trigger
                class="rounded-xl px-3 py-3 min-h-[44px] min-w-[44px] text-text-muted transition-colors duration-200 hover:text-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
                aria-label="Search"
                title="Search (⌘K)"
              >
                <Icon name="tabler:search" class="w-5 h-5" />
              </button>
              {
                showRssFeed && (
                  <a
                    class="rounded-xl px-3 py-3 min-h-[44px] min-w-[44px] text-text-muted transition-colors duration-200 hover:text-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
                    aria-label="RSS Feed"
                    href={getAsset('/rss.xml')}
                  >
                    <Icon name="tabler:rss" class="w-5 h-5" />
                  </a>
                )
              }
            </div>
            {
              actions?.length ? (
                <span class="flex items-center gap-2">
                  {actions.map((btnProps) => (
                    <Button {...btnProps} class={wikiButtonClass} />
                  ))}
                </span>
              ) : null
            }
          </div>
        </div>
      </div>
    </nav>
  </div>
  <script is:inline>
    !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys onSessionId".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
    posthog.init('phc_f7RRplJvzImoDey54XnTdwgXGg2ffeoNiPAkTF7yJXQ',{api_host:'https://app.posthog.com',opt_out_capturing_by_default:true})
  </script>
</header>
<div aria-hidden="true" class="header-offset"></div>
