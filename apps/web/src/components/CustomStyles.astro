---
import '@fontsource-variable/inter';
---

<style is:inline is:global>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: var(--aw-font-sans);
    --aw-font-heading: var(--aw-font-sans);

    /* Brand */
    --color-brand-500: #E3242D;
    --color-brand-400: #F13D46;
    --color-brand-600: #BF1F26;
    --color-brand-soft: rgba(227, 36, 45, 0.12);

    /* Interaction overlays */
    --overlay-subtle: color-mix(in srgb, var(--color-brand-500) 8%, transparent);
    --overlay-strong: color-mix(in srgb, var(--color-brand-500) 16%, transparent);
    --overlay-focus: color-mix(in srgb, var(--color-brand-500) 24%, transparent);

    /* Light mode (default) */
    --color-bg-page: #F4F5F7;
    --color-bg-surface: #FFFFFF;
    --color-bg-soft: #E5E7EB;
    --color-border-subtle: #D1D5DB;
    --color-text-main: #111827;
    --color-text-muted: #4B5563;
    --color-text-soft: #6B7280;

    /* Link colors (light) */
    --color-link: var(--color-brand-500);
    --color-link-hover: var(--color-brand-400);
    --color-link-muted: #9CA3AF;

    /* Status */
    --color-success: #22C55E;
    --color-warning: #FBBF24;
    --color-error: #F97316;
    --color-info: #38BDF8;

    color-scheme: light;

    /* Legacy aliases */
    --aw-color-primary: var(--color-brand-500);
    --aw-color-primary-hover: var(--color-brand-400);
    --aw-color-secondary: var(--color-brand-600);
    --aw-color-accent: var(--color-brand-400);
    --aw-color-text-heading: var(--color-text-main);
    --aw-color-text-default: var(--color-text-main);
    --aw-color-text-muted: var(--color-text-muted);
    --aw-color-bg-page: var(--color-bg-page);
    --aw-color-bg-page-dark: #050609;
    --ph-color-link: var(--color-link);

    ::selection {
      background-color: var(--color-brand-soft);
      color: var(--color-brand-600);
    }
  }

  :root.dark {
    --color-bg-page: #050609;
    --color-bg-surface: #0C0F14;
    --color-bg-soft: #141821;
    --color-border-subtle: #232733;
    --color-text-main: #E5E7EB;
    --color-text-muted: #9CA3AF;
    --color-text-soft: #6B7280;

    --color-link: var(--color-brand-400);
    --color-link-hover: #FF5C6A;
    --color-link-muted: #6B7280;

    --overlay-subtle: color-mix(in srgb, var(--color-brand-400) 12%, transparent);
    --overlay-strong: color-mix(in srgb, var(--color-brand-400) 24%, transparent);
    --overlay-focus: color-mix(in srgb, var(--color-brand-400) 32%, transparent);

    color-scheme: dark;

    --aw-color-text-default: var(--color-text-main);
    --aw-color-text-muted: var(--color-text-muted);

    ::selection {
      background-color: var(--color-brand-600);
      color: var(--color-bg-surface);
  }
  }

  body {
    background-color: var(--color-bg-page);
    color: var(--color-text-main);
  }
</style>