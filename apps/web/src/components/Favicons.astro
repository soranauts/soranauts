<!-- Basic favicon.ico for maximum compatibility -->
<link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />

<!-- Adaptive favicons based on color scheme -->
<link rel="icon" type="image/svg+xml" href="/favicon-light.svg?v=2" media="(prefers-color-scheme: light)" />
<link rel="icon" type="image/svg+xml" href="/favicon-dark.svg?v=2" media="(prefers-color-scheme: dark)" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-light-32x32.png?v=2" media="(prefers-color-scheme: light)" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-dark-32x32.png?v=2" media="(prefers-color-scheme: dark)" />

<!-- Default favicon for browsers that don't support media queries -->
<link rel="icon" type="image/svg+xml" href="/favicon-light.svg?v=2" />

<!-- Apple touch icons with color scheme support -->
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-light.png?v=2" media="(prefers-color-scheme: light)" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-dark.png?v=2" media="(prefers-color-scheme: dark)" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />

<!-- Mask icon for Safari -->
<link rel="mask-icon" href="/favicon-light.svg?v=2" color="#E3242D" />
