---
import { APP_BLOG } from '~/utils/config';
import type { Post } from '~/types';

import Image from '~/components/common/Image.astro';

import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';


export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = (await findImage(post.image));
---

<article class="group flex h-full flex-col rounded-2xl border border-border-subtle bg-surface/80 p-4 shadow-sm transition hover:-translate-y-1 hover:shadow-elevated">
  {
    image && (
      <a href={getPermalink(post.permalink, 'post')} class="block overflow-hidden rounded-2xl border border-border-subtle">
        <Image
          src={image}
          class="h-40 w-full object-cover transition group-hover:scale-[1.02]"
          widths={[400, 900]}
          width={400}
          sizes="(max-width: 900px) 400px, 900px"
          alt={post.title}
          aspectRatio="16:9"
          layout="cover"
          loading="lazy"
          decoding="async"
        />
      </a>
    )
  }
  <div class="mt-4 flex flex-1 flex-col">
    {
      !APP_BLOG?.post?.isEnabled ? (
        <>
          <h3 class="text-lg font-bold text-text-main sm:text-xl">{post.title}</h3>
          <p class="mt-2 text-sm text-text-muted">{post.excerpt}</p>
        </>
      ) : (
        <a href={getPermalink(post.permalink, 'post')} class="mt-auto text-left no-underline">
          <h3 class="text-lg font-bold text-text-main sm:text-xl group-hover:text-brand-500">{post.title}</h3>
          <p class="mt-2 text-sm text-text-muted">{post.excerpt}</p>
        </a>
      )
    }
  </div>
</article>
