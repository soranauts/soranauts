---
// Table of Contents Component
---

<div class="toc-container mb-6">
  <button
    class="toc-toggle"
    aria-expanded="false"
    aria-controls="toc-nav"
  >
    <span class="flex items-center gap-2">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
      </svg>
      Table of Contents
    </span>
    <svg
      class="toc-chevron h-5 w-5 transition-transform duration-200"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>

  <nav id="toc-nav" class="hidden mt-3">
    <ul id="toc-list" class="space-y-1"></ul>
  </nav>
</div>

<script>
  // Completely isolated TOC generation
  (function() {
    'use strict';
    
    let tocInitialized = false;
    let scrollListenerAdded = false;
    let currentTocLinks = [];
    let currentHeadingElements = [];
    
    function updateActiveLink() {
      if (currentTocLinks.length === 0) return;
      
      let current = '';
      const scrollPos = window.scrollY + 100; // Offset for header

      currentHeadingElements.forEach((heading) => {
        if (heading && heading.offsetTop <= scrollPos) {
          current = heading.id;
        }
      });

      currentTocLinks.forEach(link => {
        const targetId = link.getAttribute('data-target-id');
        if (targetId === current) {
          link.classList.add('toc-link--active');
        } else {
          link.classList.remove('toc-link--active');
        }
      });
    }
    
    function generateTOC() {
      const tocList = document.getElementById('toc-list');
      const tocNav = document.getElementById('toc-nav');
      const tocToggle = document.querySelector('.toc-toggle');
      const tocContainer = document.querySelector('.toc-container');

      if (!tocList || !tocNav || !tocToggle || !tocContainer) return;

      // Only look for headings within the article content, not the entire page
      const articleContent = document.querySelector('.prose') || document.querySelector('article') || document.body;
      const headings = articleContent ? articleContent.querySelectorAll('h1, h2, h3, h4, h5, h6') : [];
      
      // Skip the first few headings as they might be from manual TOC
      const skipFirstN = 0; // Skip first 0 headings - no manual TOC in this article
      const headingsArray = Array.from(headings);
      const actualHeadings = headingsArray.slice(skipFirstN);
      
      if (actualHeadings.length === 0) {
        tocContainer.style.display = 'none';
        return;
      }

      let tocHTML = '';

      actualHeadings.forEach((heading) => {
        // Ensure this is actually a heading element
        if (!heading.tagName || !heading.tagName.match(/^H[1-6]$/)) {
          return;
        }

        const level = parseInt(heading.tagName.charAt(1));
        const text = heading.textContent || '';
        const id = heading.id || text.toLowerCase().replace(/[^\w\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-').trim();

        // Skip empty or very short headings
        if (!text || text.trim().length < 3) {
          return;
        }

        // Ensure heading has an ID
        if (!heading.id) {
          heading.id = id;
        }

        // Add indentation based on level
        const indentClass = level > 2 ? 'ml-4' : level > 3 ? 'ml-8' : '';
        const fontClass = level === 1 ? 'font-semibold' : level === 2 ? 'font-medium' : '';

        tocHTML += `
          <li class="${indentClass}">
            <a
              href="#${id}"
              class="toc-link ${fontClass}"
              data-target-id="${id}"
            >
              ${text}
            </a>
          </li>
        `;
      });

      // Clear any existing content first
      tocList.innerHTML = '';
      tocList.innerHTML = tocHTML;

      // Update references for active link tracking
      currentTocLinks = Array.from(tocList.querySelectorAll('.toc-link'));
      currentHeadingElements = Array.from(actualHeadings).map(h => document.getElementById(h.id)).filter(Boolean);

      // Update on scroll and initial load (only add listener once)
      if (!scrollListenerAdded && currentTocLinks.length > 0) {
        window.addEventListener('scroll', updateActiveLink, { passive: true });
        updateActiveLink();
        scrollListenerAdded = true;
      } else if (scrollListenerAdded) {
        // If listener already exists, just update the active link
        updateActiveLink();
      }

      // Auto-expand on mobile
      const isMobile = window.innerWidth < 768;
      if (isMobile) {
        expandTOC();
      }

      // Only add event listener once
      if (!tocInitialized) {
        tocToggle.addEventListener('click', () => {
          const isExpanded = tocNav.classList.contains('hidden');
          if (isExpanded) {
            expandTOC();
          } else {
            collapseTOC();
          }
        });
        tocInitialized = true;
      }
    }

    function expandTOC() {
      const tocNav = document.getElementById('toc-nav');
      const tocToggle = document.querySelector('.toc-toggle');
      const chevron = document.querySelector('.toc-chevron');

      if (tocNav && tocToggle && chevron) {
        tocNav.classList.remove('hidden');
        tocToggle.setAttribute('aria-expanded', 'true');
        chevron.style.transform = 'rotate(180deg)';
      }
    }

    function collapseTOC() {
      const tocNav = document.getElementById('toc-nav');
      const tocToggle = document.querySelector('.toc-toggle');
      const chevron = document.querySelector('.toc-chevron');

      if (tocNav && tocToggle && chevron) {
        tocNav.classList.add('hidden');
        tocToggle.setAttribute('aria-expanded', 'false');
        chevron.style.transform = 'rotate(0deg)';
      }
    }

    // Initialize TOC with multiple attempts
    function initTOC() {
      if (!tocInitialized) {
        generateTOC();
      }
    }

    // Try multiple initialization methods
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTOC);
    } else {
      initTOC();
    }

    // Also try after a delay
    setTimeout(initTOC, 100);
    setTimeout(initTOC, 500);
    setTimeout(initTOC, 1000);
  })();
</script>
