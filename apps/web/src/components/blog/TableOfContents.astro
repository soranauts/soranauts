---
// Table of Contents Component
---

<div class="toc-container mb-6">
  <button
    class="toc-toggle"
    aria-expanded="false"
    aria-controls="toc-nav"
  >
    <span class="flex items-center gap-2">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
      </svg>
      Table of Contents
    </span>
    <svg
      class="toc-chevron h-5 w-5 transition-transform duration-200"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>

  <nav id="toc-nav" class="hidden mt-3">
    <ul id="toc-list" class="space-y-1"></ul>
  </nav>
</div>

<script>
// @ts-nocheck - Legacy inline DOM script pending migration to a typed island
// Completely isolated TOC generation
(function () {
    if (typeof window === 'undefined' || typeof document === 'undefined') {
      return;
    }

    let tocInitialized = false;
    let scrollListenerAdded = false;
    let currentTocLinks = /** @type {any[]} */ ([]);
    let currentHeadingElements = /** @type {any[]} */ ([]);

    function updateActiveLink() {
      if (currentTocLinks.length === 0) return;

      let current = '';
      const scrollPos = window.scrollY + 100; // Offset for header

      currentHeadingElements.forEach((rawHeading) => {
        if (!(rawHeading instanceof HTMLElement)) {
          return;
        }
        const heading = rawHeading;

        if (heading.offsetTop <= scrollPos) {
          current = heading.id;
        }
      });

      currentTocLinks.forEach((rawLink) => {
        if (!(rawLink instanceof HTMLElement)) {
          return;
        }
        const link = rawLink;

        const targetId = link.getAttribute('data-target-id');
        if (targetId === current) {
          link.classList.add('toc-link--active');
        } else {
          link.classList.remove('toc-link--active');
        }
      });
    }

    function generateTOC() {
      const tocListEl = document.getElementById('toc-list');
      const tocNavEl = document.getElementById('toc-nav');
      const tocToggleEl = document.querySelector('.toc-toggle');
      const tocContainerEl = document.querySelector('.toc-container');

      if (!(tocListEl instanceof HTMLElement) || !(tocNavEl instanceof HTMLElement) || !(tocToggleEl instanceof HTMLElement) || !(tocContainerEl instanceof HTMLElement)) {
        return;
      }

      const articleContent = document.querySelector('.prose') || document.querySelector('article') || document.body;
      const headings = articleContent ? articleContent.querySelectorAll('h1, h2, h3, h4, h5, h6') : [];

      const skipFirstN = 0;
      const actualHeadings = Array.from(headings)
        .slice(skipFirstN)
        .filter((heading) => heading instanceof HTMLElement);

      if (actualHeadings.length === 0) {
        tocContainerEl.style.display = 'none';
        return;
      }

      // Build the TOC using DOM APIs to avoid HTML injection sinks.
      tocListEl.textContent = '';

      actualHeadings.forEach((rawHeading) => {
        if (!(rawHeading instanceof HTMLElement)) {
          return;
        }
        const heading = rawHeading;

        const level = parseInt(heading.tagName.charAt(1), 10);
        const text = heading.textContent || '';
        const id =
          heading.id ||
          text
            .toLowerCase()
            .replace(/[^\w\s-]/g, '')
            .replace(/\s+/g, '-')
            .replace(/-+/g, '-')
            .trim();

        if (!text || text.trim().length < 3) {
          return;
        }

        if (!heading.id) {
          heading.id = id;
        }

        const indentClass = level > 3 ? 'ml-8' : level > 2 ? 'ml-4' : '';
        const fontClass = level === 1 ? 'font-semibold' : level === 2 ? 'font-medium' : '';

        const li = document.createElement('li');
        if (indentClass) {
          li.className = indentClass;
        }

        const a = document.createElement('a');
        a.href = `#${id}`;
        a.className = `toc-link${fontClass ? ` ${fontClass}` : ''}`;
        a.setAttribute('data-target-id', id);
        a.textContent = text;

        li.appendChild(a);
        tocListEl.appendChild(li);
      });

      currentTocLinks = Array.from(tocListEl.querySelectorAll('.toc-link'));
      currentHeadingElements = actualHeadings;

      if (!scrollListenerAdded && currentTocLinks.length > 0) {
        window.addEventListener('scroll', updateActiveLink, { passive: true });
        updateActiveLink();
        scrollListenerAdded = true;
      } else if (scrollListenerAdded) {
        updateActiveLink();
      }

      if (window.innerWidth < 768) {
        expandTOC();
      }

      if (!tocInitialized) {
        tocToggleEl.addEventListener('click', () => {
          const nav = document.getElementById('toc-nav');
          if (!(nav instanceof HTMLElement)) return;
          const isCollapsed = nav.classList.contains('hidden');
          if (isCollapsed) {
            expandTOC();
          } else {
            collapseTOC();
          }
        });
        tocInitialized = true;
      }
    }

    function expandTOC() {
      const tocNav = document.getElementById('toc-nav');
      const tocToggle = document.querySelector('.toc-toggle');
      const chevron = document.querySelector('.toc-chevron');

      if (tocNav instanceof HTMLElement && tocToggle instanceof HTMLElement) {
        tocNav.classList.remove('hidden');
        tocToggle.setAttribute('aria-expanded', 'true');
        if (chevron instanceof SVGElement || chevron instanceof HTMLElement) {
          chevron.style.transform = 'rotate(180deg)';
        }
      }
    }

    function collapseTOC() {
      const tocNav = document.getElementById('toc-nav');
      const tocToggle = document.querySelector('.toc-toggle');
      const chevron = document.querySelector('.toc-chevron');

      if (tocNav instanceof HTMLElement && tocToggle instanceof HTMLElement) {
        tocNav.classList.add('hidden');
        tocToggle.setAttribute('aria-expanded', 'false');
        if (chevron instanceof SVGElement || chevron instanceof HTMLElement) {
          chevron.style.transform = 'rotate(0deg)';
        }
      }
    }

    function initTOC() {
      if (!tocInitialized) {
        generateTOC();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTOC);
    } else {
      initTOC();
    }

    setTimeout(initTOC, 100);
    setTimeout(initTOC, 500);
    setTimeout(initTOC, 1000);
  })();
</script>
