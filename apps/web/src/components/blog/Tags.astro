---
import { getPermalink } from '~/utils/permalinks';

import { APP_BLOG } from '~/utils/config';
import { getTagNode, getTaxonomyNode } from '~/lib/taxonomy';
import type { Post } from '~/types';

export interface Props {
  tags: Post['tags'];
  class?: string;  
  title?: string | undefined;
  isCategory?: boolean;
}

const { tags, class: className = 'text-sm', title = undefined, isCategory = false } = Astro.props;

const resolvedTags = Array.isArray(tags)
  ? tags.map((tag) => {
      const node = getTagNode(tag);
      const glossarySlug = node?.glossaryRef
        ? node.glossaryRef.replace(/^\/glossary\//, '').replace(/\/$/, '')
        : undefined;
      const glossaryNode = glossarySlug ? getTaxonomyNode(glossarySlug) : undefined;
      const tooltipSlug = glossaryNode?.slug ?? glossarySlug ?? node?.slug;
      const tooltipCategory = glossaryNode?.category ?? node?.category ?? 'tag';

      return {
        label: tag,
        permalink: getPermalink(tag, isCategory ? 'category' : 'tag'),
        node,
        glossaryNode,
        tooltipSlug,
        tooltipCategory,
      };
    })
  : [];
---

{
  resolvedTags.length > 0 && (
    <>
      <>
        {title !== undefined && <span class="align-super font-normal underline underline-offset-4 decoration-2 dark:text-slate-400">{title}</span>}
      </>
      <ul class={`${className} flex flex-wrap gap-2.5 items-start`}>
        {resolvedTags.slice(0, 3).map((tagData) => (
          <li class="bg-gray-100 dark:bg-slate-700 inline-block py-1 px-3 rounded text-xs font-medium transition-colors duration-200 hover:bg-gray-200 dark:hover:bg-slate-600">
            {!APP_BLOG?.tag?.isEnabled ? (
              tagData.label
            ) : tagData.tooltipSlug ? (
              <a
                href={tagData.permalink}
                class={`text-muted dark:text-slate-300 hover:text-primary dark:hover:text-gray-200 glossary-term glossary-term-${tagData.tooltipCategory}`}
                data-term={tagData.tooltipSlug}
                data-category={tagData.tooltipCategory}
                aria-describedby={`tip-${tagData.tooltipSlug}`}
              >
                {tagData.label}
              </a>
            ) : (
              <a
                href={tagData.permalink}
                class="text-muted dark:text-slate-300 hover:text-primary dark:hover:text-gray-200"
              >
                {tagData.label}
              </a>
            )}
          </li>
        ))}
        {resolvedTags.length > 3 && (
          <>
            <li class="bg-gray-50 dark:bg-slate-800 inline-block py-1 px-3 rounded text-xs font-medium text-gray-500 dark:text-slate-400 cursor-pointer hover:bg-gray-200 dark:hover:bg-slate-700 transition-colors duration-200" 
                onclick="toggleMoreTags(this)" 
                data-show-more="true">
              +{resolvedTags.length - 3} more
            </li>
            {resolvedTags.slice(3).map((tagData) => (
              <li class="bg-gray-100 dark:bg-slate-700 py-1 px-3 rounded text-xs font-medium transition-colors duration-200 hover:bg-gray-200 dark:hover:bg-slate-600 hidden" 
                  data-hidden-tag="true">
                {!APP_BLOG?.tag?.isEnabled ? (
                  tagData.label
                ) : tagData.tooltipSlug ? (
                  <a
                    href={tagData.permalink}
                    class={`text-muted dark:text-slate-300 hover:text-primary dark:hover:text-gray-200 glossary-term glossary-term-${tagData.tooltipCategory}`}
                    data-term={tagData.tooltipSlug}
                    data-category={tagData.tooltipCategory}
                    aria-describedby={`tip-${tagData.tooltipSlug}`}
                  >
                    {tagData.label}
                  </a>
                ) : (
                  <a
                    href={tagData.permalink}
                    class="text-muted dark:text-slate-300 hover:text-primary dark:hover:text-gray-200"
                  >
                    {tagData.label}
                  </a>
                )}
              </li>
            ))}
          </>
        )}
      </ul>
      
      <script is:inline>
        // Simple, direct approach with debugging
        function toggleMoreTags(element) {
          console.log('toggleMoreTags called', element);
          const hiddenTags = element.parentElement.querySelectorAll('[data-hidden-tag="true"]');
          const showMore = element.getAttribute('data-show-more') === 'true';
          
          console.log('Hidden tags found:', hiddenTags.length, 'Show more:', showMore);
          
          hiddenTags.forEach(tag => {
            if (showMore) {
              tag.classList.remove('hidden');
              console.log('Showing tag:', tag.textContent);
            } else {
              tag.classList.add('hidden');
              console.log('Hiding tag:', tag.textContent);
            }
          });
          
          if (showMore) {
            element.textContent = 'Show less';
            element.setAttribute('data-show-more', 'false');
          } else {
            element.textContent = `+${hiddenTags.length} more`;
            element.setAttribute('data-show-more', 'true');
          }
        }
        
        // Make function available globally immediately
        window.toggleMoreTags = toggleMoreTags;
        console.log('toggleMoreTags function defined and available globally');
      </script>
    </>
  )
}
