---
export interface Props {
  currentArticle: {
    slug: string;
    tags: string[];
    category: string;
  };
  allArticles: Array<{
    slug: string;
    title: string;
    excerpt: string;
    tags: string[];
    category: string;
    publishDate: Date;
  }>;
  maxArticles?: number;
}

const { currentArticle, allArticles, maxArticles = 3 } = Astro.props;

// Calculate relevance score based on tag overlap
function calculateRelevance(currentTags: string[], articleTags: string[]): number {
  const matches = currentTags.filter(tag => articleTags.includes(tag)).length;
  return matches;
}

// Find related articles
let relatedArticles = allArticles
  .filter(article => article.slug !== currentArticle.slug)
  .map(article => ({
    ...article,
    relevanceScore: calculateRelevance(currentArticle.tags, article.tags)
  }))
  .filter(article => article.relevanceScore > 0) // Only show articles with matching tags
  .sort((a, b) => b.relevanceScore - a.relevanceScore)
  .slice(0, maxArticles);

// If no related articles found, show recent articles from same category
if (relatedArticles.length === 0) {
  relatedArticles = allArticles
    .filter(article => 
      article.slug !== currentArticle.slug && 
      article.category === currentArticle.category
    )
    .map(article => ({
      ...article,
      relevanceScore: 0
    }))
    .sort((a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime())
    .slice(0, maxArticles);
}
---

{relatedArticles.length > 0 && (
  <section class="related-articles not-prose">
    <h3 class="related-articles__title">
      Related Articles
    </h3>

    <div class="related-articles__list">
      {relatedArticles.map(article => (
        <a href={`/${article.slug}`} class="card-link card-link--block related-link">
          <h4 class="card-link__title">
            {article.title}
          </h4>
          {article.excerpt && (
            <p class="card-link__meta">
              {article.excerpt}
            </p>
          )}
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-articles {
    margin-top: var(--space-7);
  }

  .related-articles__title {
    margin: 0 0 var(--space-3);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .related-articles__list {
    display: grid;
    gap: var(--space-3);
  }

  .related-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-lg);
    background-color: color-mix(in srgb, var(--color-surface) 92%, var(--overlay-subtle) 8%);
    border: 1px solid color-mix(in srgb, var(--color-border-subtle) 70%, transparent);
    color: var(--color-text-main);
    text-decoration: none;
    transition:
      background-color var(--motion-duration-fast, 150ms) cubic-bezier(0.25, 0.1, 0.25, 1),
      border-color var(--motion-duration-fast, 150ms) cubic-bezier(0.25, 0.1, 0.25, 1),
      transform var(--motion-duration-fast, 150ms) cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  .related-link:focus-visible {
    outline: 2px solid var(--overlay-focus);
    outline-offset: 3px;
    border-color: color-mix(in srgb, var(--color-border-subtle) 60%, var(--overlay-focus) 40%);
  }

  .related-link:hover,
  .related-link:focus-visible {
    background-color: var(--overlay-subtle);
    border-color: color-mix(in srgb, var(--color-border-subtle) 65%, var(--overlay-subtle) 35%);
    transform: translateY(-1px);
  }

  .related-link:active {
    background-color: var(--overlay-strong);
    border-color: color-mix(in srgb, var(--color-border-subtle) 55%, var(--overlay-strong) 45%);
  }

  .related-link:hover .card-link__title,
  .related-link:focus-visible .card-link__title {
    color: var(--color-link-hover);
    text-decoration-line: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  .card-link__title {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-text-main);
    transition:
      color var(--motion-duration-fast, 150ms) cubic-bezier(0.25, 0.1, 0.25, 1),
      text-decoration-color var(--motion-duration-fast, 150ms) cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  .card-link__meta {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  @media (min-width: var(--bp-md)) {
    .related-articles__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .related-link {
      padding: var(--space-4);
    }

    .card-link__title {
      font-size: 1rem;
    }

    .card-link__meta {
      font-size: 0.85rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .related-link,
    .related-link:hover,
    .related-link:focus-visible {
      transition: none;
      transform: none;
    }
  }
</style>
