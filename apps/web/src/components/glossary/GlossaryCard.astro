---
export interface Props {
  href: string;
  title: string;
  summary?: string;
  category?: string;
  tags?: string[];
  meta?: string[];
  badge?: string;
}

const { href, title, summary, category, tags = [], meta = [], badge } = Astro.props;

import { formatCategoryLabel } from '~/lib/glossary/format';
const categoryLabel = category ? formatCategoryLabel(category) : undefined;

const seenTags = new Set<string>();
const dedupedTags = tags.filter((tag) => {
  const key = tag.toLowerCase();
  if (seenTags.has(key)) return false;
  seenTags.add(key);
  return Boolean(tag);
});
const tagList = dedupedTags.slice(0, 6);
---

<a class="glossary-card" href={href} role="group">
  {(categoryLabel || badge) && (
    <div class="glossary-card__header">
      {categoryLabel && <span class="chip chip--sm chip--neutral">{categoryLabel}</span>}
      {badge && <span class="chip chip--sm chip--accent">{badge}</span>}
    </div>
  )}
  <h3 class="glossary-card__title">{title}</h3>
  {summary && <p class="glossary-card__summary">{summary}</p>}
  {meta.length > 0 && (
    <div class="glossary-card__meta">
      {meta.map((item) => (
        <span>{item}</span>
      ))}
    </div>
  )}
  {tagList.length > 0 && (
    <div class="glossary-card__tags" aria-label="Related tags">
      {tagList.map((tag) => (
        <span class="chip chip--sm chip--muted">#{formatCategoryLabel(tag)}</span>
      ))}
    </div>
  )}
</a>
