---
const GLOSSARY_V2 = (import.meta.env.GLOSSARY_V2 ?? 'false') === 'true';
---

{GLOSSARY_V2 && (
  <script type="module" is:inline>
    if (typeof window !== 'undefined') {
      import('/src/components/glossary/GlossaryPopover.client.ts').catch(err => console.error('[Glossary] Failed to load:', err));
    }
  </script>
)}






