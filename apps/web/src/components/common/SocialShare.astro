---
import { Icon } from 'astro-icon';

export interface Props {
  text: string;
  url: string | URL;
  class?: string;
}

const { text, url, class: className = 'inline-block' } = Astro.props;
---

<div class={className}>
      <div class="flex items-center gap-2">
    <span class="text-sm font-medium text-gray-500 dark:text-slate-400 mr-3">Share:</span>
    <div class="flex items-center gap-2.5">
      <button class="p-2 rounded-full hover:bg-gray-100 dark:hover:bg-slate-700 transition-colors duration-200" title="Twitter Share" data-aw-social-share="twitter" data-aw-url={url} data-aw-text={text}>
        <Icon
          name="tabler:brand-twitter"
          class="w-5 h-5 text-gray-400 dark:text-slate-500 hover:text-black dark:hover:text-slate-300"
        />
      </button>
      <button class="p-2 rounded-full hover:bg-gray-100 dark:hover:bg-slate-700 transition-colors duration-200" title="Facebook Share" data-aw-social-share="facebook" data-aw-url={url}>
        <Icon
          name="tabler:brand-facebook"
          class="w-5 h-5 text-gray-400 dark:text-slate-500 hover:text-black dark:hover:text-slate-300"
        />
      </button>
      <button class="p-2 rounded-full hover:bg-gray-100 dark:hover:bg-slate-700 transition-colors duration-200" title="Linkedin Share" data-aw-social-share="linkedin" data-aw-url={url} data-aw-text={text}>
        <Icon
          name="tabler:brand-linkedin"
          class="w-5 h-5 text-gray-400 dark:text-slate-500 hover:text-black dark:hover:text-slate-300"
        />
      </button>
      <button class="p-2 rounded-full hover:bg-gray-100 dark:hover:bg-slate-700 transition-colors duration-200" title="Whatsapp Share" data-aw-social-share="whatsapp" data-aw-url={url} data-aw-text={text}>
        <Icon
          name="tabler:brand-whatsapp"
          class="w-5 h-5 text-gray-400 dark:text-slate-500 hover:text-black dark:hover:text-slate-300"
        />
      </button>
      <button class="p-2 rounded-full hover:bg-gray-100 dark:hover:bg-slate-700 transition-colors duration-200" title="Email Share" data-aw-social-share="mail" data-aw-url={url} data-aw-text={text}>
        <Icon
          name="tabler:mail"
          class="w-5 h-5 text-gray-400 dark:text-slate-500 hover:text-black dark:hover:text-slate-300"
        />
      </button>
    </div>
  </div>
</div>
