---
interface Props {
  filePath: string; // e.g., "apps/web/src/content/post/my-article.mdx"
  class?: string;
}

const { filePath, class: className } = Astro.props;
const githubEditUrl = `https://github.com/soranauts/soranauts/edit/main/${filePath}`;
---

<a
  href={githubEditUrl}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    'inline-flex items-center gap-1.5 text-sm text-muted hover:text-default transition-colors',
    className,
  ]}
>
  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
    ></path>
  </svg>
  <span>Edit this page</span>
</a>
