---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import Announcement from '~/components/widgets/Announcement.astro';
import SchemaMarkup from '~/components/SEO/SchemaMarkup.astro';
import RelatedArticles from '~/components/blog/RelatedArticles.astro';
import { SITE } from '~/utils/config';
import { fetchPosts } from '~/utils/blog';

import { headerData, footerData } from '~/navigation';

import type { MetaData, Post } from '~/types';
import fs from 'node:fs';
import path from 'node:path';

export interface Props {
  post: Post;
  url: string | URL;
  metadata?: MetaData;
}

const { post, url, metadata = {} } = Astro.props;
// Default to V2 mode unless explicitly disabled
const GLOSSARY_V2 = import.meta.env.GLOSSARY_V2 !== 'false';

// Fetch all posts for related articles
const allPosts = await fetchPosts();

// Calculate word count (rough estimate)
const wordCount = post.content ? post.content.split(/\s+/).filter(word => word.length > 0).length : 100;

// Calculate reading time if not available
// Calculate reading time with proper rounding (always round up)
let actualReadingTime = post.readingTime || Math.ceil(wordCount / 200);
// Override specific articles with known correct values
if (post.title?.includes('SORAMITSU')) {
  actualReadingTime = 8;
} else if (post.title?.includes('SORA v3 Vision')) {
  actualReadingTime = 4; // 601 words = 4 minutes
} else if (actualReadingTime && actualReadingTime < 4 && wordCount > 500) {
  // For articles with 500+ words showing less than 4 minutes, recalculate
  actualReadingTime = Math.ceil(wordCount / 200);
}


// Resolve the canonical OG image for this post from the /public/og manifest
function getOgManifest(): Record<string, string> {
  const manifestPath = path.join(process.cwd(), 'public', 'og', 'manifest.json');
  const raw = fs.readFileSync(manifestPath, 'utf-8');
  return JSON.parse(raw) as Record<string, string>;
}

const ogManifest = getOgManifest();
const resolvedPathname = new URL(String(url), SITE.site).pathname.replace(/\/+$/, '') || '/';
const ogPath = ogManifest[resolvedPathname] || ogManifest.default || '/og/default.jpg';
const socialImageUrl = `${SITE.site}${ogPath}`;

// Create enhanced metadata for the blog post
const enhancedMetadata = {
  ...metadata,
  title: post.title,
  description: post.excerpt,
  openGraph: {
    ...metadata.openGraph,
    images: [
      {
        url: socialImageUrl,
        width: 1200,
        height: 630,
        alt: post.title
      }
    ]
  },
  url: String(url),
  type: 'article',
  publishedTime: post.publishDate.toISOString(),
  modifiedTime: post.updateDate?.toISOString(),
  author: "Soranauts",
  category: post.category,
  tags: post.tags,
  readingTime: actualReadingTime,
  wordCount: wordCount
};
---

<Layout metadata={enhancedMetadata} isBlogPost={true}>
  <!-- Article Schema Markup -->
  <SchemaMarkup
    type="article"
    data={{
      title: post.title,
      description: post.excerpt,
      image: socialImageUrl,
      url: String(url),
      publishedTime: post.publishDate.toISOString(),
      modifiedTime: post.updateDate?.toISOString(),
      author: "Soranauts",
      category: post.category,
      tags: post.tags,
      wordCount: wordCount,
      readingTime: actualReadingTime
    }}
  />

  <!-- Twitter Image Meta Tag for Blog Posts -->
  <meta name="twitter:image" content={socialImageUrl} />
  <meta property="og:image" content={socialImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={post.title} />

  <!-- Breadcrumb Schema -->
  <SchemaMarkup
    type="breadcrumb"
    data={{ breadcrumbs: [{ name: 'Blog', url: '/blog' }] }}
  />

  <slot name="announcement">
    <Announcement />
  </slot>
  <slot name="header">
    <Header {...headerData} isSticky showRssFeed showToggleTheme />
  </slot>
  <main>
    <article 
      class:list={{ 'article-content': GLOSSARY_V2 }}
      data-pagefind-ignore="all"
    >
      <slot />
    </article>
  
  <!-- Related Articles Section -->
    <div class="container mx-auto px-4 py-8">
      <RelatedArticles 
        currentArticle={{
          slug: post.slug,
          tags: post.tags || [],
          category: post.category || ''
        }}
        allArticles={allPosts.map(p => ({
          slug: p.slug,
          title: p.title,
          excerpt: p.excerpt || '',
          tags: p.tags || [],
          category: p.category || '',
          publishDate: p.publishDate,
          updateDate: p.updateDate
        }))}
        maxArticles={3}
      />
    </div>
  </main>
  <slot name="footer">
    <Footer {...footerData} />
  </slot>

</Layout>
