---
import '~/assets/styles/tailwind.css';
import '~/assets/styles/glossary.css';

import { I18N, SITE } from '~/utils/config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';
import SimpleCookieConsent from '~/components/SimpleCookieConsent.astro';
import SearchModal from '~/components/SearchModal.astro';
import SchemaMarkup from '~/components/SEO/SchemaMarkup.astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { Analytics as VercelAnalytics } from '@vercel/analytics/react';

// Uncomment line below to activate View Transitions
// import { ViewTransitions } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
  isBlogPost?: boolean;
}

const { metadata = {}, isBlogPost = false } = Astro.props;
const { language, textDirection } = I18N;
---

<!doctype html>
<html lang={language} dir={textDirection} class="2xl:text-[20px]">
  <head>
    <CommonMeta />
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    
    <!-- Twitter Image Meta Tag - Use custom image if provided, otherwise default -->
    {!isBlogPost && (
      <meta name="twitter:image" content={metadata.openGraph?.images?.[0]?.url || `${SITE.site}/soranauts-social-share.jpg`} />
    )}
    
    <SiteVerification />
    <Analytics />
    
    <!-- Website Schema Markup -->
    <SchemaMarkup type="website" data={{}} />
    <SchemaMarkup type="organization" data={{}} />

    <!-- Uncomment line below to activate View Transitions -->
    <!-- <ViewTransitions fallback="swap" /> -->
  </head>

  <body class="antialiased text-default bg-page tracking-tight">
    <slot />

    <BasicScripts />
    <SimpleCookieConsent />
    <SearchModal />
    <SpeedInsights />
    <VercelAnalytics />

    <style is:global>
      img {
        content-visibility: auto;
      }
    </style>

    <!-- Remove glossary links from FAQ summaries to fix spacing issues -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        // Find all FAQ summaries and remove glossary links from them
        document.querySelectorAll('details > summary a.glossary-term, details p summary a.glossary-term').forEach(link => {
          // Replace the link with just the text content, preserving any surrounding whitespace
          const textNode = document.createTextNode(link.textContent);
          link.parentNode.replaceChild(textNode, link);
        });
        
        // Ensure proper flex layout for FAQ summaries after link removal
        document.querySelectorAll('details > summary, details p summary').forEach(summary => {
          summary.style.display = 'flex';
          summary.style.alignItems = 'center';
          summary.style.justifyContent = 'space-between';
          summary.style.width = '100%';
        });
      });
    </script>
  </body>
</html>
