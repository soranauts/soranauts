---
import '~/assets/styles/tailwind.css';
import '~/assets/styles/glossary.css';
import '~/assets/styles/glossary-article.css';
import '~/assets/styles/glossary-index.css';
import '~/assets/styles/glossary-popover.css';
import { I18N, SITE } from '~/utils/config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';
import SimpleCookieConsent from '~/components/SimpleCookieConsent.astro';
import SearchModal from '~/components/SearchModal.astro';
import SchemaMarkup from '~/components/SEO/SchemaMarkup.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import SpeedInsights from '@vercel/speed-insights/astro';
// import { Analytics as VercelAnalytics } from '@vercel/analytics/astro';

const GLOSSARY_V2 = (import.meta.env.GLOSSARY_V2 ?? 'false') === 'true';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
  isBlogPost?: boolean;
}

const { metadata = {}, isBlogPost = false } = Astro.props;
const { language, textDirection } = I18N;
---

<!doctype html>
<html lang={language} dir={textDirection} class="2xl:text-[20px]">
  <head>
    <CommonMeta />
    <Favicons />
    <ApplyColorMode />
    <Metadata {...metadata} />
    
    <!-- Twitter Image Meta Tag - Use custom image if provided, otherwise default -->
    {!isBlogPost && (
      <meta name="twitter:image" content={metadata.openGraph?.images?.[0]?.url || `${SITE.site}/soranauts-social-share.jpg`} />
    )}
    
    <SiteVerification />
    <Analytics />
    
    <!-- Website Schema Markup -->
    <SchemaMarkup type="website" data={{}} />
    <SchemaMarkup type="organization" data={{}} />

    <!-- ✅ Canonical Tag -->
    <link rel="canonical" href={new URL(Astro.url.pathname, SITE.site).toString()} />
  </head>
  <body>
    <slot />
    <CustomStyles />
    <BasicScripts />
    <SimpleCookieConsent />
    <SearchModal />
    <SpeedInsights />
    {/* <VercelAnalytics /> */}
  </body>
</html>
