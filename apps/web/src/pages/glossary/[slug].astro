---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/widgets/Header.astro';
import Footer from '../../components/widgets/Footer.astro';
import { AstroSeo } from '@astrolib/seo';
import glossary from '../../../public/glossary.json';
import { headerData, footerData } from '../../navigation';
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import { getRelatedTags, getTaxonomyNode } from '~/lib/taxonomy';
import { SITE, I18N } from '~/utils/config';
import { cleanSlug, getPermalink } from '~/utils/permalinks';

export const prerender = true;

export async function getStaticPaths() {
  return glossary.terms.map(term => ({
    params: { slug: term.slug },
    props: { term }
  }));
}

const { term } = Astro.props;
const GLOSSARY_V2 = import.meta.env.GLOSSARY_V2 === 'true';

if (!term) {
  return Astro.redirect('/glossary');
}

const title = `${term.term} — SORA Glossary`;
const description = term.definition?.length > 160 ? term.definition.slice(0, 157) + '…' : term.definition;
const canonical = `https://soranauts.com/glossary/${term.slug}`;

// Resolve OG image using manifest system (like blog posts)
function getOgManifest(): Record<string, string> {
  const manifestPath = path.join(process.cwd(), 'public', 'og', 'manifest.json');
  if (!fs.existsSync(manifestPath)) {
    return { default: '/og/default.jpg' };
  }
  const raw = fs.readFileSync(manifestPath, 'utf-8');
  return JSON.parse(raw) as Record<string, string>;
}

const ogManifest = getOgManifest();
const termPath = `/glossary/${term.slug}`;
const ogPath = ogManifest[termPath] || ogManifest['/glossary'] || ogManifest.default || '/og/default.jpg';
const ogImage = `${SITE.site}${ogPath}`;

// Breadcrumb schema for term page
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://soranauts.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "SORA Glossary",
      "item": "https://soranauts.com/glossary"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": term.term,
      "item": canonical
    }
  ]
};

// Generate related terms with proper links
const relatedTermsWithLinks = (term.relatedTerms?.map(r => {
  const relatedTerm = glossary.terms.find(t => {
    // Prefer exact term matches only (not aliases)
    return t.term === r || t.term.toLowerCase() === r.toLowerCase();
  });
  
  return relatedTerm && relatedTerm.slug !== term.slug ? 
    { term: r, slug: relatedTerm.slug } : null;
}).filter((related): related is { term: string; slug: string } => 
  related !== null
)) || [];

const taxonomyNode = getTaxonomyNode(term.slug);
const relatedTagNodes = taxonomyNode ? getRelatedTags(taxonomyNode.slug) : [];

const posts = await getCollection('post');

const relatedTagArticles = relatedTagNodes.map((tagNode) => {
  const tagName = tagNode.aliases?.[0] ?? tagNode.title;
  const normalizedTag = tagName.toLowerCase();
  const tagSlug = cleanSlug(tagName);
  const tagPermalink = getPermalink(tagSlug, 'tag');
  const matchedPosts = posts
    .filter(
      (post) =>
        Array.isArray(post.data.tags) &&
        post.data.tags.some((tag) => {
          const tagValue = String(tag);
          return tagValue.toLowerCase() === normalizedTag || cleanSlug(tagValue) === tagSlug;
        })
    )
    .slice(0, 4);
  return {
    tag: tagNode,
    tagName,
    tagPermalink,
    posts: matchedPosts,
  };
}).filter((entry) => entry.posts.length > 0);

const versionEntries = Array.isArray(term.versions)
  ? term.versions
      .map((slug: string) => glossary.terms.find((entry) => entry.slug === slug))
      .filter(Boolean)
  : [];

const parentEntity = term.entity ? glossary.terms.find((entry) => entry.slug === term.entity) : null;

const tagSubjectEntries = relatedTagArticles.map(({ tag, tagPermalink }) => ({
  "@type": "CollectionPage",
  "name": `${tag.title} Articles`,
  "url": `${SITE.site}${tagPermalink}`,
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "name": term.term,
  "termCode": term.slug,
  "description": term.definition,
  "inDefinedTermSet": `${SITE.site}/glossary`,
  "url": canonical,
  "alternateName": term.aliases ?? [],
  "subjectOf": [
    ...(term.links?.map((l) => ({ "@type": "WebPage", "url": l.url })) ?? []),
    ...tagSubjectEntries,
  ],
};
---

<Layout 
  metadata={{
    title,
    description,
    canonical,
    openGraph: {
      type: "article",
      url: canonical,
      images: [{ url: ogImage, width: 1200, height: 630 }]
    }
  }}
>
  <Header {...headerData} isSticky showRssFeed showToggleTheme />
  
  <main class="py-8 sm:py-16 lg:py-20">
    <div class:list={['container mx-auto px-4 sm:px-6 max-w-4xl', { 'glossary-index': GLOSSARY_V2 }]}>
      <!-- Back Navigation -->
      <div class="mb-8">
        <a 
          href="/glossary" 
          class="inline-flex items-center text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300 transition-colors"
        >
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Back to Glossary
        </a>
      </div>

      <!-- Term Header -->
      <div class="mb-8">
        <div class="flex items-start justify-between mb-4">
          <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-gray-900 dark:text-white">
            {term.term}
          </h1>
          <a 
            href={`/glossary#${encodeURIComponent(term.category)}`}
            class={`px-3 py-1 rounded-full text-sm font-medium ml-4 transition-colors hover:opacity-80 cursor-pointer inline-block ${
              term.category === 'token' ? 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200' :
              term.category === 'technology' ? 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200' :
              term.category === 'governance' ? 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200' :
              term.category === 'defi' ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200' :
              term.category === 'network' ? 'bg-indigo-100 text-indigo-800 dark:bg-indigo-900 dark:text-indigo-200' :
              'bg-pink-100 text-pink-800 dark:bg-pink-900 dark:text-pink-200'
            }`}
            title={`Filter by ${term.category} category in glossary`}
          >
            {term.category}
          </a>
        </div>
      </div>

      <!-- Term Definition -->
      <article 
        data-pagefind-body
        data-pagefind-url={`/glossary/${term.slug}/`}
        data-pagefind-meta={`{"type":"glossary","term":"${term.term}","category":"${term.category}","aliases":["${term.aliases?.join('","') || ''}"]}`}
        class="prose prose-lg dark:prose-invert max-w-none mb-8"
      >
        <!-- Add separate filter elements so Pagefind registers multiple filters -->
        <span data-pagefind-filter="type:glossary"></span>
        <span data-pagefind-filter={`category:${term.category}`}></span>

        <!-- Optional: strengthen searchability for short all-caps terms -->
        <span class="sr-only" aria-hidden="true">
          {term.term} {term.aliases?.join(' ')} {term.category} glossary
        </span>
        <p class="text-xl text-gray-600 dark:text-gray-300 leading-relaxed">
          {term.definition}
        </p>
      </article>

      {parentEntity && (
        <div class="mb-8 rounded-lg border border-gray-200 bg-gray-50 p-4 text-sm text-gray-600 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">
          Part of the {parentEntity.term} entity. Learn more on
          {' '}
          <a href={`/glossary/${parentEntity.slug}`} class="font-semibold text-red-600 hover:text-red-500 dark:text-red-400 dark:hover:text-red-300">
            {parentEntity.term}
          </a>
          .
        </div>
      )}

      {versionEntries.length > 0 && (
        <div class="mb-8">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Versions</h2>
          <div class="grid gap-4 md:grid-cols-2">
            {versionEntries.map((version) => (
              <a
                href={`/glossary/${version.slug}`}
                class="block rounded-lg border border-gray-200 bg-white p-4 shadow-sm transition hover:border-red-300 dark:border-gray-700 dark:bg-gray-900 dark:hover:border-red-500/60"
              >
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">{version.term}</h3>
                <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">{version.summary ?? version.definition}</p>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Aliases -->
      {term.aliases && term.aliases.length > 1 && (
        <div class="mb-8">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Also known as</h2>
          <div class="flex flex-wrap gap-2">
            {term.aliases.slice(1).map((alias) => (
              <a 
                href={`/glossary#${encodeURIComponent(alias)}`}
                class="px-3 py-1 bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-600 hover:text-gray-800 dark:text-gray-300 dark:hover:text-gray-100 rounded-md text-sm transition-colors cursor-pointer inline-block"
                title={`Search for ${alias} in glossary`}
              >
                {alias}
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Tags -->
      {term.tags && term.tags.length > 0 && (
        <div class="mb-8">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Tags</h2>
          <div class="flex flex-wrap gap-2">
            {term.tags.map((tag) => (
              <a 
                href={`/glossary#${encodeURIComponent(tag)}`}
                class="px-3 py-1 bg-red-50 hover:bg-red-100 dark:bg-red-900/20 dark:hover:bg-red-900/40 text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300 rounded-md text-sm transition-colors cursor-pointer inline-block"
                title={`Filter by ${tag} tag in glossary`}
              >
                #{tag}
              </a>
            ))}
          </div>
        </div>
      )}

      {relatedTagArticles.length > 0 && (
        <div class="mb-8">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Related Tags</h2>
          <div class="flex flex-wrap gap-2">
            {relatedTagArticles.map(({ tag, tagName, tagPermalink }) => (
              <a
                href={tagPermalink}
                class="px-3 py-1 bg-gray-100 hover:bg-gray-200 dark:bg-gray-800 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-200 rounded-md text-sm transition-colors inline-flex items-center gap-1"
              >
                #{tag.title}
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Related Terms -->
      {relatedTermsWithLinks.length > 0 && (
        <div class="mb-8">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Related Terms</h2>
          <div class="flex flex-wrap gap-2">
            {relatedTermsWithLinks.map((related) => (
              <a 
                href={`/glossary/${related.slug}`}
                class="px-3 py-1 bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-md text-sm transition-colors"
              >
                {related.term}
              </a>
            ))}
          </div>
        </div>
      )}

      {relatedTagArticles.length > 0 && (
        <div class="mb-12">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Articles using these tags</h2>
          <div class="space-y-6">
            {relatedTagArticles.map(({ tag, tagName, tagPermalink, posts }) => (
              <div class="rounded-lg border border-gray-200 bg-white p-5 dark:border-gray-700 dark:bg-gray-900" key={tag.slug}>
                <div class="flex items-center justify-between">
                  <h3 class="text-lg font-semibold text-gray-900 dark:text-white">#{tag.title}</h3>
                  <a
                    href={tagPermalink}
                    class="text-sm font-medium text-red-600 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300"
                  >
                    View all
                  </a>
                </div>
                <ul class="mt-3 space-y-2">
                  {posts.map((post) => {
                    const postPermalink = getPermalink(post.slug, 'post');
                    return (
                      <li key={post.slug} class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
                        <a
                          href={postPermalink}
                          class="text-sm font-medium text-gray-800 hover:text-red-600 dark:text-gray-200 dark:hover:text-red-400"
                        >
                          {post.data.title}
                        </a>
                        {post.data.publishDate && (
                          <span class="text-xs text-gray-500 dark:text-gray-400">
                            {I18N.dateFormatter.format(post.data.publishDate)}
                          </span>
                        )}
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Examples -->
      {term.examples && term.examples.length > 0 && (
        <div class="mb-8">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Examples</h2>
          <ul class="space-y-2">
            {term.examples.map((example) => (
              <li class="text-gray-600 dark:text-gray-300">• {example}</li>
            ))}
          </ul>
        </div>
      )}

      <!-- Links -->
      {term.links && term.links.length > 0 && (
        <div class="mb-8">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Learn More</h2>
          <ul class="space-y-2">
            {term.links.map((link) => (
              <li>
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-link hover:text-link-hover hover:underline transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </main>

  <Footer {...footerData} />
</Layout>

<!-- Structured Data for SEO -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
