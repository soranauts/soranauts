---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/widgets/Header.astro';
import Footer from '../../components/widgets/Footer.astro';
import GlossaryHero from '~/components/glossary/GlossaryHero.astro';
import GlossarySectionCard from '~/components/glossary/GlossarySectionCard.astro';
import { headerData, footerData } from '../../navigation';
import { getRelatedTags, getTaxonomyNode } from '~/lib/taxonomy';
import { SITE, I18N } from '~/utils/config';
import { cleanSlug, getPermalink } from '~/utils/permalinks';
import {
  FEATURE_GLOSSARY_V2025,
  FEATURE_GLOSSARY_UI_CANONICAL,
  FEATURE_GLOSSARY_ALIAS_REDIRECT,
  FEATURE_GLOSSARY_V3_UI,
} from '~/config/feature-flags';
import {
  getCanonicalSlug as getCanonicalGlossarySlug,
  getGlossaryTerm,
  getStatus as getGlossaryStatus,
} from '~/lib/glossary/glossary-loader';
import { getCachedGlossaryTerms } from '~/lib/glossary/glossary-data';
import { shouldApplyAliasRedirect } from '~/lib/glossary/alias-redirect';
import glossaryDatasetV2025 from '../../../public/data/glossary.v2025.json';
import GlossaryTermPage from '~/components/glossary/v3/GlossaryTermPage';

export const prerender = true;

const allGlossaryTerms = getCachedGlossaryTerms();

export async function getStaticPaths() {
  return glossaryDatasetV2025.terms
    .filter((entry) => entry.status === 'canonical')
    .map((entry) => ({
      params: { slug: entry.slug },
    }));
}

const normalizeSlugValue = (value?: string | null): string =>
  typeof value === 'string' ? value.trim().toLowerCase() : '';

const requestedSlug = Astro.params.slug;
const normalizedInputSlug = normalizeSlugValue(requestedSlug);

const canonicalSlugFromDataset = (() => {
  if (!normalizedInputSlug) return '';
  const aliasEntry = glossaryDatasetV2025.terms.find(
    (entry) =>
      normalizeSlugValue(entry.slug) === normalizedInputSlug &&
      entry.status === 'alias' &&
      entry.targetSlug,
  );
  if (aliasEntry?.targetSlug) {
    return normalizeSlugValue(aliasEntry.targetSlug);
  }
  const canonicalEntry = glossaryDatasetV2025.terms.find(
    (entry) =>
      normalizeSlugValue(entry.slug) === normalizedInputSlug && entry.status === 'canonical',
  );
  return canonicalEntry ? normalizeSlugValue(canonicalEntry.slug) : '';
})();

const resolvedSlug = canonicalSlugFromDataset || getCanonicalGlossarySlug(requestedSlug);
let term = getGlossaryTerm(resolvedSlug);
if (!term && normalizedInputSlug && normalizedInputSlug !== resolvedSlug) {
  term = getGlossaryTerm(normalizedInputSlug);
}

if (!term) {
  return Astro.redirect('/glossary');
}

const canonicalSlug = canonicalSlugFromDataset || term.slug;
const requestedStatus = getGlossaryStatus(requestedSlug ?? '');
const canonicalStatus = getGlossaryStatus(canonicalSlug);
const aliasSlugNormalized = normalizedInputSlug;
const aliasDisplaySlug = typeof requestedSlug === 'string' ? requestedSlug : '';
const isAliasRequest =
  FEATURE_GLOSSARY_UI_CANONICAL &&
  Boolean(aliasSlugNormalized) &&
  aliasSlugNormalized !== term.slug;
const showCanonicalBadge = FEATURE_GLOSSARY_UI_CANONICAL && canonicalStatus === 'canonical';
const featureGlossaryV3Enabled = FEATURE_GLOSSARY_V3_UI && canonicalStatus === 'canonical';
const aliasRedirectEnabled = shouldApplyAliasRedirect({
  featureGlossaryV2025: FEATURE_GLOSSARY_V2025,
  featureGlossaryAliasRedirect: FEATURE_GLOSSARY_ALIAS_REDIRECT,
  requestedSlug,
  resolvedSlug: canonicalSlug,
});

const aliasAnalyticsPayload =
  isAliasRequest && aliasSlugNormalized
    ? {
        aliasSlug: aliasSlugNormalized,
        aliasDisplay: aliasDisplaySlug,
        canonicalSlug,
      }
    : null;
const pagefindPayload = {
  type: 'glossary',
  term: term.term,
  category: term.category,
  aliases: term.aliases || [],
  summary: term.summary ?? term.definition.slice(0, 220),
  definition: term.definition,
  url: `/glossary/${term.slug}/`,
  status: isAliasRequest ? 'alias' : requestedStatus ?? canonicalStatus ?? 'canonical',
  slug: typeof requestedSlug === 'string' ? requestedSlug : term.slug,
  targetSlug: canonicalSlug,
};

const fallbackSite = typeof SITE.site === 'string' && SITE.site.length ? SITE.site : 'https://soranauts.com';
const canonicalUrlBase = Astro.site ?? new URL(fallbackSite);
const canonicalHref = new URL(`/glossary/${canonicalSlug}`, canonicalUrlBase).toString();
const title = `${term.term} — SORA Glossary`;
const description = term.definition?.length > 160 ? term.definition.slice(0, 157) + '…' : term.definition;
const canonical = canonicalHref;

// Resolve OG image using manifest system (like blog posts)
function getOgManifest(): Record<string, string> {
  const manifestPath = path.join(process.cwd(), 'public', 'og', 'manifest.json');
  if (!fs.existsSync(manifestPath)) {
    return { default: '/og/default.jpg' };
  }
  const raw = fs.readFileSync(manifestPath, 'utf-8');
  return JSON.parse(raw) as Record<string, string>;
}

const ogManifest = getOgManifest();
const termPath = `/glossary/${term.slug}`;
const ogPath = ogManifest[termPath] || ogManifest['/glossary'] || ogManifest.default || '/og/default.jpg';
const ogImage = `${SITE.site}${ogPath}`;

// Breadcrumb schema for term page
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://soranauts.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "SORA Glossary",
      "item": "https://soranauts.com/glossary"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": term.term,
      "item": canonical
    }
  ]
};

// Generate related terms with proper links
const relatedTermsWithLinks =
  term.relatedTerms
    ?.map((relatedName) => {
      const relatedTerm = allGlossaryTerms.find(
        (entry) =>
          entry.term === relatedName ||
          entry.term.toLowerCase() === relatedName.toLowerCase() ||
          entry.slug === getCanonicalGlossarySlug(relatedName),
      );
      return relatedTerm && relatedTerm.slug !== term.slug
        ? { term: relatedName, slug: relatedTerm.slug }
        : null;
    })
    .filter((related): related is { term: string; slug: string } => related !== null) ?? [];

const taxonomyNode = getTaxonomyNode(term.slug);
const relatedTagNodes = taxonomyNode ? getRelatedTags(taxonomyNode.slug) : [];

const posts = await getCollection('post');

const relatedTagArticles = (() => {
  const seen = new Set<string>();
  return relatedTagNodes
    .map((tagNode) => {
  const tagName = tagNode.aliases?.[0] ?? tagNode.title;
  const normalizedTag = tagName.toLowerCase();
  const tagSlug = cleanSlug(tagName);
  const tagPermalink = getPermalink(tagSlug, 'tag');
  const matchedPosts = posts
    .filter(
      (post) =>
        Array.isArray(post.data.tags) &&
        post.data.tags.some((tag) => {
          const tagValue = String(tag);
          return tagValue.toLowerCase() === normalizedTag || cleanSlug(tagValue) === tagSlug;
        })
    )
    .slice(0, 4);
      return {
        tag: tagNode,
        tagName,
        tagPermalink,
        posts: matchedPosts,
      };
    })
    .filter((entry) => entry.posts.length > 0)
    .filter((entry) => {
      const key = entry.tag.glossaryRef ?? entry.tag.slug;
      if (!key) return true;
      const normalizedKey = FEATURE_GLOSSARY_V2025 ? getCanonicalGlossarySlug(key.replace(/^\/glossary\//, '')) : key;
      if (normalizedKey && seen.has(normalizedKey)) return false;
      if (normalizedKey) seen.add(normalizedKey);
      return true;
    });
})();

const versionEntries = Array.isArray(term.versions)
  ? term.versions
      .map((slug: string) => allGlossaryTerms.find((entry) => entry.slug === slug))
      .filter((entry): entry is typeof allGlossaryTerms[number] => Boolean(entry))
  : [];

const parentEntity = term.entity ? allGlossaryTerms.find((entry) => entry.slug === term.entity) : null;

const tagSubjectEntries = relatedTagArticles.map(({ tag, tagPermalink }) => ({
  "@type": "CollectionPage",
  "name": `${tag.title} Articles`,
  "url": `${SITE.site}${tagPermalink}`,
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "name": term.term,
  "termCode": term.slug,
  "description": term.definition,
  "inDefinedTermSet": `${SITE.site}/glossary`,
  "url": canonical,
  "alternateName": term.aliases ?? [],
  "subjectOf": [
    ...(term.links?.map((l) => ({ "@type": "WebPage", "url": l.url })) ?? []),
    ...tagSubjectEntries,
  ],
};

const CATEGORY_LABELS: Record<string, string> = {
  token: 'Token',
  technology: 'Technology',
  governance: 'Governance',
  defi: 'DeFi',
  network: 'Network',
  economics: 'Economics',
  tag: 'Tag',
};

const formatLabel = (value: string): string => {
  const raw = String(value || '');
  const lower = raw.toLowerCase();
  // Force specific brand/style acronyms to uppercase
  if (lower === 'sora' || lower === 'ton') {
    return lower.toUpperCase();
  }
  return raw
    .replace(/[-_]+/g, ' ')
    .replace(/\b\w/g, (match) => match.toUpperCase());
};

const categoryLabel = typeof term.category === 'string' ? CATEGORY_LABELS[term.category] ?? formatLabel(term.category) : undefined;
const aliasCount = Array.isArray(term.aliases) && term.aliases.length > 1 ? term.aliases.length - 1 : 0;
const relatedTermsCount = relatedTermsWithLinks.length;
const tagPostCount = relatedTagArticles.reduce((total, entry) => total + entry.posts.length, 0);

const heroStats = [
  { label: 'Aliases', value: aliasCount ? aliasCount.toString() : '—' },
  { label: 'Related terms', value: relatedTermsCount ? relatedTermsCount.toString() : '—' },
  { label: 'Tagged articles', value: tagPostCount ? tagPostCount.toString() : '—' },
];

const heroDescription = term.summary ?? term.definition;
const aliasList = Array.isArray(term.aliases) ? term.aliases.slice(1) : [];
const glossaryTags = Array.isArray(term.tags) ? term.tags : [];
const dateFormatter = I18N.dateFormatter ?? new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' });
---

<Layout 
  metadata={{
    title,
    description,
    canonical,
    openGraph: {
      type: "article",
      url: canonical,
      images: [{ url: ogImage, width: 1200, height: 630 }]
    }
  }}
>
  <Header {...headerData} isSticky showRssFeed showToggleTheme />
  
  <main class="glossary-detail px-4 md:px-6 lg:px-12 pt-10 md:pt-12 lg:pt-14 pb-16 md:pb-20 mx-auto max-w-5xl">
    <a class="glossary-back-link" href="/glossary">← Back to glossary</a>

    {FEATURE_GLOSSARY_UI_CANONICAL && isAliasRequest && (
      <div
        class="glossary-alias-hint"
        role="status"
        data-alias-banner
        data-alias-slug={aliasAnalyticsPayload?.aliasSlug ?? ''}
        data-canonical-slug={term.slug}
      >
        <div class="glossary-alias-hint__body">
          <p>
            You’re viewing the alias <span>{aliasAnalyticsPayload?.aliasDisplay ?? ''}</span>.
          </p>
          <div class="glossary-alias-hint__chip">Alias of: {term.term}</div>
          <p>
            Canonical term:{' '}
            <a href={`/glossary/${canonicalSlug}`} data-alias-canonical-link>
              {term.term}
            </a>
            .
          </p>
        </div>
        <a class="glossary-alias-hint__cta" href={`/glossary/${canonicalSlug}`} data-alias-cta>
          Go to canonical
        </a>
      </div>
    )}

    {FEATURE_GLOSSARY_UI_CANONICAL && aliasAnalyticsPayload?.aliasSlug && (
      <script
        type="module"
        is:inline
        define:vars={{ aliasSlug: aliasAnalyticsPayload.aliasSlug, canonicalSlug: aliasAnalyticsPayload.canonicalSlug }}
      >
        import { emit } from '~/lib/analytics';
        const alias = aliasSlug;
        const target = canonicalSlug;
        if (alias && target) {
          queueMicrotask(() => emit({ name: 'glossary_alias_view', alias, target }));
          const cta = document.querySelector('[data-alias-cta]');
          if (cta) {
            cta.addEventListener(
              'click',
              () => emit({ name: 'glossary_alias_redirect', alias, target }),
              { once: true },
            );
          }
        }
      </script>
    )}

    {aliasRedirectEnabled && aliasAnalyticsPayload?.aliasSlug && (
      <script
        type="module"
        is:inline
        define:vars={{
          aliasSlug: aliasAnalyticsPayload.aliasSlug,
          canonicalSlug: term.slug,
        }}
      >
        import { emit } from '~/lib/analytics';
        const alias = aliasSlug;
        const targetSlug = canonicalSlug;
        if (typeof window !== 'undefined') {
          window.requestAnimationFrame(() => {
            const target = `/glossary/${targetSlug}`;
            if (window.location.pathname !== target) {
              window.history.replaceState({}, '', target + window.location.search + window.location.hash);
              emit({ name: 'glossary_alias_redirect', alias, target: targetSlug });
            }
          });
        }
      </script>
    )}

    {featureGlossaryV3Enabled && (
      <article
        class="sr-only"
        aria-hidden="true"
        data-pagefind-body
        data-pagefind-url={`/glossary/${term.slug}/`}
        data-pagefind-meta={JSON.stringify(pagefindPayload)}
      >
        <span data-pagefind-filter="type:glossary"></span>
        <span data-pagefind-filter={`category:${term.category}`}></span>
        <p>{term.definition}</p>
      </article>
    )}

    {featureGlossaryV3Enabled ? (
      <GlossaryTermPage
        client:load
        title={term.term}
        summary={term.summary ?? null}
        definition={term.definition ?? ''}
        whyItMatters={term.tagline ?? term.subtitle ?? null}
        related={relatedTermsWithLinks.map((related) => ({
          term: related.term,
          href: `/glossary/${related.slug}`,
        }))}
        sources={(term.links ?? []).map((link) => ({
          label: link.label,
          url: link.url,
        }))}
      />
    ) : (
      <>
        <GlossaryHero title={term.term} description={heroDescription} stats={heroStats}>
          <div class="glossary-detail__chips">
            {categoryLabel && term.category && (
              <a class="glossary-chip" href={`/glossary#${encodeURIComponent(term.category)}`}>
                {categoryLabel}
              </a>
            )}
            {parentEntity && (
              <a class="glossary-chip glossary-chip--muted" href={`/glossary/${parentEntity.slug}`}>
                Parent · {parentEntity.term}
              </a>
            )}
            {showCanonicalBadge && (
              <span class="glossary-chip glossary-chip--neutral glossary-chip--canonical" aria-label="Canonical glossary term">
                Canonical
              </span>
            )}
          </div>
        </GlossaryHero>

        <div class="glossary-detail__stack">
      <GlossarySectionCard kicker="Core definition" title="What it means">
        <article
          data-pagefind-body
          data-pagefind-url={`/glossary/${term.slug}/`}
          data-pagefind-meta={JSON.stringify(pagefindPayload)}
          class="prose"
        >
              <span data-pagefind-filter="type:glossary"></span>
              <span data-pagefind-filter={`category:${term.category}`}></span>
              <span class="sr-only" aria-hidden="true">
                {term.term} {term.aliases?.join(' ')} {term.category} glossary
              </span>
              <p>{term.definition}</p>
            </article>

            {parentEntity && (
              <div class="glossary-note">
                <span class="glossary-note__label">Parent entity</span>
                <a class="glossary-note__link" href={`/glossary/${parentEntity.slug}`}>
                  {parentEntity.term}
                </a>
              </div>
            )}
          </GlossarySectionCard>

          {versionEntries.length > 0 && (
            <GlossarySectionCard title="Version history" description="Adjacent glossary entries that track releases and upgrades.">
              <div class="glossary-list glossary-list--stacked">
                {versionEntries.map((version) => (
                  <a class="glossary-related-link" href={`/glossary/${version.slug}`}>
                    <span class="glossary-related-link__title">{version.term}</span>
                    <span class="glossary-related-link__summary">{version.summary ?? version.definition}</span>
                  </a>
                ))}
              </div>
            </GlossarySectionCard>
          )}

          {aliasList.length > 0 && (
            <GlossarySectionCard title="Also known as" description="Alternate spellings and abbreviations linked to this entry.">
              <ul class="glossary-list">
                {aliasList.map((alias) => (
                  <li>
                    <a class="glossary-chip glossary-chip--muted" href={`/glossary#${encodeURIComponent(alias)}`}>
                      {alias}
                    </a>
                  </li>
                ))}
              </ul>
            </GlossarySectionCard>
          )}

          {glossaryTags.length > 0 && (
            <GlossarySectionCard title="Glossary tags">
              <ul class="glossary-list">
                {glossaryTags.map((tag) => (
                  <li>
                    <a class="glossary-chip glossary-chip--muted" href={`/glossary#${encodeURIComponent(tag)}`}>
                      #{formatLabel(tag)}
                    </a>
                  </li>
                ))}
              </ul>
            </GlossarySectionCard>
          )}

          {relatedTermsWithLinks.length > 0 && (
            <GlossarySectionCard title="Related glossary entries">
              <ul class="glossary-list">
                {relatedTermsWithLinks.map((related) => (
                  <li>
                    <a class="glossary-chip glossary-chip--muted" href={`/glossary/${related.slug}`}>
                      {related.term}
                    </a>
                  </li>
                ))}
              </ul>
            </GlossarySectionCard>
          )}

          {relatedTagArticles.length > 0 && (
            <GlossarySectionCard title="Explorer coverage" description="Recent Soranauts articles tagged with this glossary concept.">
              <div class="glossary-related">
                {relatedTagArticles.map(({ tag, tagPermalink, posts }) => (
                  <div class="glossary-related__item">
                    <div class="glossary-related__header">
                      <div class="glossary-related__title">#{formatLabel(tag.title)}</div>
                      <a class="glossary-related__action" href={tagPermalink}>
                        View Explorer tag
                      </a>
                    </div>
                    <ul class="glossary-related__list">
                      {posts.map((post) => {
                        const postPermalink = getPermalink(post.slug, 'post');
                        return (
                          <li class="glossary-related__list-item">
                            <a href={postPermalink}>{post.data.title}</a>
                            {post.data.publishDate && <time>{dateFormatter.format(post.data.publishDate)}</time>}
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                ))}
              </div>
            </GlossarySectionCard>
          )}

          {term.examples && term.examples.length > 0 && (
            <GlossarySectionCard title="Examples" description="Common scenarios where this concept appears.">
              <ul class="glossary-list glossary-list--stacked">
                {term.examples.map((example) => (
                  <li class="glossary-list__bullet">{example}</li>
                ))}
              </ul>
            </GlossarySectionCard>
          )}

          {term.links && term.links.length > 0 && (
            <GlossarySectionCard title="More resources">
              <ul class="glossary-list glossary-list--stacked">
                {term.links.map((link) => (
                  <li>
                    <a
                      class="glossary-related-link glossary-related-link--external"
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </GlossarySectionCard>
          )}
        </div>
      </>
    )}
  </main>

  <Footer {...footerData} />
</Layout>

<!-- Structured Data for SEO -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
