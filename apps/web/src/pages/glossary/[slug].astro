---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/widgets/Header.astro';
import Footer from '../../components/widgets/Footer.astro';
import GlossaryHero from '~/components/glossary/GlossaryHero.astro';
import GlossarySectionCard from '~/components/glossary/GlossarySectionCard.astro';
import { headerData, footerData } from '../../navigation';
import { getRelatedTags, getTaxonomyNode } from '~/lib/taxonomy';
import { SITE, I18N } from '~/utils/config';
import { cleanSlug, getPermalink } from '~/utils/permalinks';
import {
  FEATURE_GLOSSARY_V2025,
  FEATURE_GLOSSARY_UI_CANONICAL,
  FEATURE_GLOSSARY_ALIAS_REDIRECT,
  FEATURE_GLOSSARY_V3_UI,
} from '~/config/feature-flags';
import {
  getCanonicalSlug as getCanonicalGlossarySlug,
  getGlossaryTerm,
  getStatus as getGlossaryStatus,
} from '~/lib/glossary/glossary-loader';
import { getCachedGlossaryTerms } from '~/lib/glossary/glossary-data';
import { shouldApplyAliasRedirect } from '~/lib/glossary/alias-redirect';
import glossaryDatasetV2025 from '../../../public/data/glossary.v2025.json';
import GlossaryTermPage from '~/components/glossary/v3/GlossaryTermPage';
import GlossaryTermHero from '~/components/glossary/GlossaryTermHero';
import GlossaryQuickView from '~/components/glossary/GlossaryQuickView';
import { loadGlossaryFull } from '~/lib/glossary-data';
import { resolveGlossaryEntry } from '~/lib/glossary-resolve';
import { formatGlossaryTitle, formatCategoryLabel, formatHashtag, truncateOneLiner, ACRONYM_TOKENS, formatGlossaryDate } from '~/lib/glossary/format';
import { getTermSubgroup } from '~/data/nexus-explorer.config';
import { getExplorerUrlForCategory, getExplorerDomainForCategory, getExplorerDomainLabel } from '~/lib/glossary/explorer-mapping';

export const prerender = true;

const allGlossaryTerms = getCachedGlossaryTerms();

export async function getStaticPaths() {
  // Compute canonical slugs at build time to avoid alias routes.
  const cached = getCachedGlossaryTerms();
  const canonicalCached = cached.filter((t) => t.status === 'canonical');
  const canonicalDataset = (glossaryDatasetV2025?.terms ?? []).filter(
    (t) => t.status === 'canonical',
  );

  const source = FEATURE_GLOSSARY_V2025 ? canonicalDataset : canonicalCached;
  return source.map((t) => ({ params: { slug: t.slug } }));
}

const normalizeSlugValue = (value?: string | null): string =>
  typeof value === 'string' ? value.trim().toLowerCase() : '';

const requestedSlug = Astro.params.slug;
const normalizedInputSlug = normalizeSlugValue(requestedSlug);

const canonicalSlugFromDataset = (() => {
  if (!normalizedInputSlug) return '';
  const aliasEntry = glossaryDatasetV2025.terms.find(
    (entry) =>
      normalizeSlugValue(entry.slug) === normalizedInputSlug &&
      entry.status === 'alias' &&
      entry.targetSlug,
  );
  if (aliasEntry?.targetSlug) {
    return normalizeSlugValue(aliasEntry.targetSlug);
  }
  const canonicalEntry = glossaryDatasetV2025.terms.find(
    (entry) =>
      normalizeSlugValue(entry.slug) === normalizedInputSlug && entry.status === 'canonical',
  );
  return canonicalEntry ? normalizeSlugValue(canonicalEntry.slug) : '';
})();

const resolvedSlug = canonicalSlugFromDataset || getCanonicalGlossarySlug(requestedSlug);
let term = getGlossaryTerm(resolvedSlug);
if (!term && normalizedInputSlug && normalizedInputSlug !== resolvedSlug) {
  term = getGlossaryTerm(normalizedInputSlug);
}

if (!term) {
  return Astro.redirect('/glossary');
}

const normalizedGlossaryTerms = await loadGlossaryFull();
const runtimeTerm =
  resolveGlossaryEntry(normalizedGlossaryTerms, requestedSlug ?? '') ??
  resolveGlossaryEntry(normalizedGlossaryTerms, term.slug) ??
  resolveGlossaryEntry(normalizedGlossaryTerms, canonicalSlugFromDataset);
const rawTermTitle = (runtimeTerm?.title ?? runtimeTerm?.term ?? term.term ?? term.slug ?? '').trim();
const displayTermTitle = formatGlossaryTitle(rawTermTitle || term.slug);
const displaySummary = runtimeTerm?.summary ?? term.summary ?? null;
const rawDisplayDefinition =
  runtimeTerm?.definition ?? runtimeTerm?.summary ?? term.definition ?? term.summary ?? '';
const displayDefinition =
  typeof rawDisplayDefinition === 'string' && rawDisplayDefinition.trim().length
    ? rawDisplayDefinition.trim()
    : 'Definition coming soon.';

const canonicalSlug = canonicalSlugFromDataset || term.slug;
const requestedStatus = getGlossaryStatus(requestedSlug ?? '');
const canonicalStatus = getGlossaryStatus(canonicalSlug);
const aliasSlugNormalized = normalizedInputSlug;
const aliasDisplaySlug = typeof requestedSlug === 'string' ? requestedSlug : '';
const isAliasRequest =
  FEATURE_GLOSSARY_UI_CANONICAL &&
  Boolean(aliasSlugNormalized) &&
  aliasSlugNormalized !== term.slug;
const showCanonicalBadge = FEATURE_GLOSSARY_UI_CANONICAL && canonicalStatus === 'canonical';
const featureGlossaryV3Enabled = FEATURE_GLOSSARY_V3_UI && canonicalStatus === 'canonical';
const aliasRedirectEnabled = shouldApplyAliasRedirect({
  featureGlossaryV2025: FEATURE_GLOSSARY_V2025,
  featureGlossaryAliasRedirect: FEATURE_GLOSSARY_ALIAS_REDIRECT,
  requestedSlug,
  resolvedSlug: canonicalSlug,
});

const aliasAnalyticsPayload =
  isAliasRequest && aliasSlugNormalized
    ? {
        aliasSlug: aliasSlugNormalized,
        aliasDisplay: aliasDisplaySlug,
        canonicalSlug,
      }
    : null;
const pagefindPayload = {
  type: 'glossary',
  term: displayTermTitle,
  category: term.category,
  aliases: term.aliases || [],
  summary: (displaySummary ?? displayDefinition).slice(0, 220),
  definition: displayDefinition,
  url: `/glossary/${term.slug}/`,
  status: isAliasRequest ? 'alias' : requestedStatus ?? canonicalStatus ?? 'canonical',
  slug: typeof requestedSlug === 'string' ? requestedSlug : term.slug,
  targetSlug: canonicalSlug,
};

const fallbackSite = typeof SITE.site === 'string' && SITE.site.length ? SITE.site : 'https://soranauts.com';
const canonicalUrlBase = Astro.site ?? new URL(fallbackSite);
const canonicalHref = new URL(`/glossary/${canonicalSlug}`, canonicalUrlBase).toString();
const title = `${displayTermTitle} — SORA Glossary`;
const description =
  displayDefinition.length > 160 ? `${displayDefinition.slice(0, 157)}…` : displayDefinition;
const canonical = canonicalHref;

// Resolve OG image using manifest system (like blog posts)
function getOgManifest(): Record<string, string> {
  const manifestPath = path.join(process.cwd(), 'public', 'og', 'manifest.json');
  if (!fs.existsSync(manifestPath)) {
    return { default: '/og/default.jpg' };
  }
  const raw = fs.readFileSync(manifestPath, 'utf-8');
  return JSON.parse(raw) as Record<string, string>;
}

const ogManifest = getOgManifest();
const termPath = `/glossary/${term.slug}`;
const ogPath = ogManifest[termPath] || ogManifest['/glossary'] || ogManifest.default || '/og/default.jpg';
const ogImage = `${SITE.site}${ogPath}`;

// Breadcrumb schema for term page
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://soranauts.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "SORA Glossary",
      "item": "https://soranauts.com/glossary"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": displayTermTitle,
      "item": canonical
    }
  ]
};

// Generate related terms with proper links
const relatedTermsWithLinks =
  term.relatedTerms
    ?.map((relatedName) => {
      const relatedTerm = allGlossaryTerms.find(
        (entry) =>
          entry.term === relatedName ||
          entry.term.toLowerCase() === relatedName.toLowerCase() ||
          entry.slug === getCanonicalGlossarySlug(relatedName),
      );
      return relatedTerm && relatedTerm.slug !== term.slug
        ? { term: relatedName, slug: relatedTerm.slug }
        : null;
    })
    .filter((related): related is { term: string; slug: string } => related !== null) ?? [];

const taxonomyNode = getTaxonomyNode(term.slug);
const relatedTagNodes = taxonomyNode ? getRelatedTags(taxonomyNode.slug) : [];

const posts = await getCollection('post');

const relatedTagArticles = (() => {
  const seen = new Set<string>();
  return relatedTagNodes
    .map((tagNode) => {
  const tagName = tagNode.aliases?.[0] ?? tagNode.title;
  const normalizedTag = tagName.toLowerCase();
  const tagSlug = cleanSlug(tagName);
  const tagPermalink = getPermalink(tagSlug, 'tag');
  const matchedPosts = posts
    .filter(
      (post) =>
        Array.isArray(post.data.tags) &&
        post.data.tags.some((tag) => {
          const tagValue = String(tag);
          return tagValue.toLowerCase() === normalizedTag || cleanSlug(tagValue) === tagSlug;
        })
    )
    .slice(0, 4);
      return {
        tag: tagNode,
        tagName,
        tagPermalink,
        posts: matchedPosts,
      };
    })
    .filter((entry) => entry.posts.length > 0)
    .filter((entry) => {
      const key = entry.tag.glossaryRef ?? entry.tag.slug;
      if (!key) return true;
      const normalizedKey = FEATURE_GLOSSARY_V2025 ? getCanonicalGlossarySlug(key.replace(/^\/glossary\//, '')) : key;
      if (normalizedKey && seen.has(normalizedKey)) return false;
      if (normalizedKey) seen.add(normalizedKey);
      return true;
    });
})();

const versionEntries = Array.isArray(term.versions)
  ? term.versions
      .map((slug: string) => allGlossaryTerms.find((entry) => entry.slug === slug))
      .filter((entry): entry is typeof allGlossaryTerms[number] => Boolean(entry))
  : [];

const parentEntity = term.entity ? allGlossaryTerms.find((entry) => entry.slug === term.entity) : null;

const tagSubjectEntries = relatedTagArticles.map(({ tag, tagPermalink }) => ({
  "@type": "CollectionPage",
  "name": `${tag.title} Articles`,
  "url": `${SITE.site}${tagPermalink}`,
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "name": displayTermTitle,
  "termCode": term.slug,
  "description": displayDefinition,
  "inDefinedTermSet": `${SITE.site}/glossary`,
  "url": canonical,
  "alternateName": term.aliases ?? [],
  "subjectOf": [
    ...(term.links?.map((l) => ({ "@type": "WebPage", "url": l.url })) ?? []),
    ...tagSubjectEntries,
  ],
};

// Use the centralized hashtag formatting function for consistent casing
const formatLabel = (value: string): string => formatHashtag(value);

const categoryLabel = typeof term.category === 'string' ? formatCategoryLabel(term.category) : undefined;
const aliasCount = Array.isArray(term.aliases) && term.aliases.length > 1 ? term.aliases.length - 1 : 0;
const relatedTermsCount = relatedTermsWithLinks.length;
const tagPostCount = relatedTagArticles.reduce((total, entry) => total + entry.posts.length, 0);

const heroStats = [
  { label: 'Aliases', value: aliasCount ? aliasCount.toString() : '—' },
  { label: 'Related terms', value: relatedTermsCount ? relatedTermsCount.toString() : '—' },
  { label: 'Tagged articles', value: tagPostCount ? tagPostCount.toString() : '—' },
];

const aliasList = Array.isArray(term.aliases) ? term.aliases.slice(1) : [];
const glossaryTags = Array.isArray(term.tags) ? term.tags : [];
const heroSummary = truncateOneLiner(displaySummary ?? displayDefinition);

const formattedLastUpdate = formatGlossaryDate(
  (term as any)?.updateDate ?? runtimeTerm?.updateDate ?? null,
  (term as any)?.publishDate ?? runtimeTerm?.publishDate ?? null,
);

const CORE_AUTOLINK_SLUGS = ['xor', 'val', 'pswap', 'polkaswap', 'sora-v2', 'sora-v3'];

const escapeRegExp = (value: string) => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const escapeHtml = (value: string) =>
  value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');

const buildAutoLinkTargets = () => {
  return CORE_AUTOLINK_SLUGS.map((slug) => {
    const ref = allGlossaryTerms.find((entry) => entry.slug === slug);
    if (!ref) return null;
    const tokens = new Set<string>();
    const pushToken = (token?: string | null) => {
      if (!token) return;
      const normalized = token.trim();
      if (!normalized || /\s/.test(normalized)) return;
      tokens.add(normalized);
    };
    pushToken(ref.term);
    pushToken(ref.slug);
    (ref.aliases ?? []).forEach(pushToken);
    if (!tokens.size) return null;
    const pattern = new RegExp(`\\b(${Array.from(tokens).map(escapeRegExp).join('|')})\\b`, 'gi');
    return { slug: ref.slug, pattern };
  }).filter((value): value is { slug: string; pattern: RegExp } => Boolean(value));
};

const autoLinkTargets = buildAutoLinkTargets();
const definitionHasHtml = /<\/?[a-z][\s>]/i.test(displayDefinition);

const linkParagraph = (paragraph: string) => {
  if (!autoLinkTargets.length) {
    return escapeHtml(paragraph);
  }
  const matches: Array<{ start: number; end: number; slug: string; text: string }> = [];
  autoLinkTargets.forEach((target) => {
    target.pattern.lastIndex = 0;
    let match: RegExpExecArray | null;
    while ((match = target.pattern.exec(paragraph)) !== null) {
      matches.push({
        start: match.index,
        end: match.index + match[0].length,
        slug: target.slug,
        text: match[0],
      });
    }
  });
  matches.sort((a, b) => a.start - b.start);
  const linkedSlugs = new Set<string>();
  let cursor = 0;
  let result = '';
  for (const match of matches) {
    if (match.start < cursor || linkedSlugs.has(match.slug)) {
      continue;
    }
    result += escapeHtml(paragraph.slice(cursor, match.start));
    
    // Preserve original casing for acronyms
    const matchUpper = match.text.toUpperCase();
    const matchLower = match.text.toLowerCase();
    const isAcronym = ACRONYM_TOKENS.has(matchLower);
    const displayText = isAcronym ? matchUpper : match.text;
    
    result += `<a class="text-brand-500 font-semibold hover:underline" data-auto-glossary="true" href="/glossary/${match.slug}#definition">${escapeHtml(displayText)}</a>`;
    linkedSlugs.add(match.slug);
    cursor = match.end;
  }
  if (cursor < paragraph.length) {
    result += escapeHtml(paragraph.slice(cursor));
  }
  return result;
};

const buildDefinitionHtml = () => {
  if (definitionHasHtml) {
    return displayDefinition;
  }
  const paragraphs = displayDefinition.split(/\n{2,}/).map((block) => block.trim()).filter(Boolean);
  if (!paragraphs.length) {
    return `<p>${escapeHtml(displayDefinition)}</p>`;
  }
  return paragraphs.map((paragraph) => `<p>${linkParagraph(paragraph)}</p>`).join('');
};

const definitionHtml = buildDefinitionHtml();

const relatedTermChips = relatedTermsWithLinks.slice(0, 4).map((related) => ({
  term: formatGlossaryTitle(related.term),
  href: `/glossary/${related.slug}`,
}));

const relatedTagChips = glossaryTags.slice(0, 3).map((tag) => ({
  term: `#${formatLabel(tag)}`,
  href: `/glossary#${encodeURIComponent(tag)}`,
}));

const relatedChipLinks = [...relatedTermChips, ...relatedTagChips].slice(0, 6);
const dateFormatter = I18N.dateFormatter ?? new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' });

// Check if this term is part of Nexus Architecture for "View in Explorer" link
const isNexusTerm = glossaryTags.includes('Nexus Architecture');
const nexusSubgroup = isNexusTerm ? getTermSubgroup(displayTermTitle) : undefined;

// Compute Explorer integration values (server-side for client hydration)
const explorerDomain = term.category ? getExplorerDomainForCategory(term.category) : null;
const explorerUrl = term.category ? getExplorerUrlForCategory(term.category) : null;
const explorerDomainLabel = explorerDomain ? getExplorerDomainLabel(explorerDomain) : null;

// Prepare terms data for Quick-View panel (lightweight payload)
const quickViewTerms = allGlossaryTerms
  .filter((t) => t.status === 'canonical')
  .map((t) => ({
    slug: t.slug,
    term: t.term,
    title: t.term,
    definition: t.definition,
    summary: t.summary,
    category: t.category,
    tags: t.tags,
    relatedTerms: t.relatedTerms,
    tagline: t.tagline,
    subtitle: t.subtitle,
  }));

// Get initial term slug from URL if present (SSR)
const initialQuickViewSlug = Astro.url.searchParams.get('term') || null;
---

<Layout 
  metadata={{
    title,
    description,
    canonical,
    openGraph: {
      type: "article",
      url: canonical,
      images: [{ url: ogImage, width: 1200, height: 630 }]
    }
  }}
>
  <Header {...headerData} isSticky showRssFeed showToggleTheme />
  
  <main id="main-content" class="glossary-detail px-4 md:px-6 lg:px-12 pt-10 md:pt-12 lg:pt-14 pb-16 md:pb-20 mx-auto max-w-5xl">
    <div class="glossary-nav-links">
      <a class="glossary-back-link" href="/glossary" aria-label="Back to glossary index">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>Back to glossary</span>
      </a>
      {isNexusTerm && (
        <a 
          class="glossary-explorer-link" 
          href="/explore#nexus-architecture"
          aria-label={`View ${displayTermTitle} in SORA Explorer${nexusSubgroup ? ` under ${nexusSubgroup.title}` : ''}`}
        >
          <svg class="glossary-explorer-link__icon" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M9 1L11.5 6.5L17 9L11.5 11.5L9 17L6.5 11.5L1 9L6.5 6.5L9 1Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>View in Explorer</span>
          {nexusSubgroup && <span class="glossary-explorer-link__subgroup">· {nexusSubgroup.title}</span>}
        </a>
      )}
    </div>

    {FEATURE_GLOSSARY_UI_CANONICAL && isAliasRequest && (
      <div
        class="glossary-alias-hint"
        role="status"
        data-alias-banner
        data-alias-slug={aliasAnalyticsPayload?.aliasSlug ?? ''}
        data-canonical-slug={term.slug}
      >
        <div class="glossary-alias-hint__body">
          <p>
            You’re viewing the alias <span>{aliasAnalyticsPayload?.aliasDisplay ?? ''}</span>.
          </p>
          <div class="glossary-alias-hint__chip">Alias of: {displayTermTitle}</div>
          <p>
            Canonical term:{' '}
            <a href={`/glossary/${canonicalSlug}`} data-alias-canonical-link>
              {displayTermTitle}
            </a>
            .
          </p>
        </div>
        <a class="glossary-alias-hint__cta" href={`/glossary/${canonicalSlug}`} data-alias-cta>
          Go to canonical
        </a>
      </div>
    )}

    {FEATURE_GLOSSARY_UI_CANONICAL && aliasAnalyticsPayload?.aliasSlug && (
      <script
        type="module"
        is:inline
        define:vars={{ aliasSlug: aliasAnalyticsPayload.aliasSlug, canonicalSlug: aliasAnalyticsPayload.canonicalSlug }}
      >
        const emitGlossaryEvent = (event) => {
          if (window.posthog?.capture) {
            window.posthog.capture(event.name, event);
            return;
          }
          if (typeof window.gtag === 'function') {
            window.gtag('event', event.name, event);
            return;
          }
          console.debug?.('[analytics]', event);
        };
        const alias = aliasSlug;
        const target = canonicalSlug;
        if (alias && target) {
          queueMicrotask(() => emitGlossaryEvent({ name: 'glossary_alias_view', alias, target }));
          const cta = document.querySelector('[data-alias-cta]');
          if (cta) {
            cta.addEventListener(
              'click',
              () => emitGlossaryEvent({ name: 'glossary_alias_redirect', alias, target }),
              { once: true },
            );
          }
        }
      </script>
    )}

    {aliasRedirectEnabled && aliasAnalyticsPayload?.aliasSlug && (
      <script
        type="module"
        is:inline
        define:vars={{
          aliasSlug: aliasAnalyticsPayload.aliasSlug,
          canonicalSlug: term.slug,
        }}
      >
        const emitGlossaryEvent = (event) => {
          if (window.posthog?.capture) {
            window.posthog.capture(event.name, event);
            return;
          }
          if (typeof window.gtag === 'function') {
            window.gtag('event', event.name, event);
            return;
          }
          console.debug?.('[analytics]', event);
        };
        const alias = aliasSlug;
        const targetSlug = canonicalSlug;
        if (typeof window !== 'undefined') {
          window.requestAnimationFrame(() => {
            const target = `/glossary/${targetSlug}`;
            if (window.location.pathname !== target) {
              window.history.replaceState({}, '', target + window.location.search + window.location.hash);
              emitGlossaryEvent({ name: 'glossary_alias_redirect', alias, target: targetSlug });
            }
          });
        }
      </script>
    )}

    {/* Hidden content for Pagefind indexing - no aria-hidden so Pagefind can index */}
    {featureGlossaryV3Enabled && (
      <div
        class="sr-only"
        data-pagefind-body
        data-pagefind-meta={`type:glossary,term:${displayTermTitle},category:${term.category || ''}`}
      >
        <p>{displayTermTitle}</p>
        <p>{displayDefinition}</p>
      </div>
    )}

    {featureGlossaryV3Enabled ? (
      <div class="flex flex-col space-y-8 md:space-y-10">
        <GlossaryTermHero
          client:load
          title={displayTermTitle}
          category={categoryLabel ?? null}
          categorySlug={term.category ?? null}
          summary={heroSummary || null}
        />
        <GlossaryTermPage
          client:load
          title={displayTermTitle}
          summary={heroSummary || null}
          definition={displayDefinition}
          definitionHtml={definitionHtml}
          categoryLabel={categoryLabel ?? null}
          whyItMatters={term.tagline ?? term.subtitle ?? null}
          explorerUrl={explorerUrl}
          explorerDomainLabel={explorerDomainLabel}
          related={relatedTermsWithLinks.map((related) => ({
            term: related.term,
            href: `/glossary/${related.slug}`,
            slug: related.slug,
          }))}
          sources={(term.links ?? []).map((link) => ({
            label: link.label,
            url: link.url,
          }))}
          lastUpdate={formattedLastUpdate}
        />
      </div>
    ) : (
      <>
        <GlossaryHero title={displayTermTitle} stats={heroStats} kicker="Reference">
          <div class="flex flex-col items-start gap-3 text-base text-slate-700 dark:text-slate-200">
            {categoryLabel && (
              <a 
                href={`/glossary?category=${encodeURIComponent(term.category ?? '')}#glossary-search-results`}
                class="chip chip--md chip--neutral hover:bg-white/20 transition-colors"
                title={`View all ${categoryLabel} terms`}
              >
                {categoryLabel}
              </a>
            )}
            {heroSummary && <p class="text-base leading-relaxed">{heroSummary}</p>}
          </div>
          {(parentEntity || showCanonicalBadge) && (
            <div class="glossary-detail__chips mb-8 md:mb-10">
              {parentEntity && (
                <a 
                  class="chip chip--sm chip--muted" 
                  href={`/glossary/${parentEntity.slug}`}
                  data-qv-trigger={parentEntity.slug}
                >
                  Parent · {parentEntity.term}
                </a>
              )}
              {showCanonicalBadge && (
                <span class="chip chip--sm chip--neutral chip--canonical" aria-label="Canonical glossary term">
                  Canonical
                </span>
              )}
            </div>
          )}
        </GlossaryHero>

        <div class="glossary-detail__stack">
      <GlossarySectionCard
        kicker="Core definition"
        title="What it means"
        id="definition"
        class="scroll-mt-28 md:scroll-mt-32"
      >
        <article
          data-pagefind-body
          data-pagefind-meta={`type:glossary,term:${displayTermTitle},category:${term.category || ''}`}
          class="prose"
        >
              <span class="sr-only">
                {displayTermTitle} {term.aliases?.join(' ')} {term.category} glossary
              </span>
              <div class="glossary-definition prose max-w-none" set:html={definitionHtml}></div>
            </article>

            {parentEntity && (
              <div class="glossary-note">
                <span class="glossary-note__label">Parent entity</span>
                <a class="glossary-note__link" href={`/glossary/${parentEntity.slug}`}>
                  {parentEntity.term}
                </a>
              </div>
            )}
          </GlossarySectionCard>

          {versionEntries.length > 0 && (
            <GlossarySectionCard title="Version history" description="Adjacent glossary entries that track releases and upgrades.">
              <div class="glossary-list glossary-list--stacked">
                {versionEntries.map((version) => (
                  <a class="glossary-related-link" href={`/glossary/${version.slug}`}>
                    <span class="glossary-related-link__title">{version.term}</span>
                    <span class="glossary-related-link__summary">{version.summary ?? version.definition}</span>
                  </a>
                ))}
              </div>
            </GlossarySectionCard>
          )}

          {aliasList.length > 0 && (
            <GlossarySectionCard title="Also known as" description="Alternate spellings and abbreviations linked to this entry.">
              <ul class="glossary-list">
                {aliasList.map((alias) => (
                  <li>
                    <a class="chip chip--sm chip--muted" href={`/glossary#${encodeURIComponent(alias)}`}>
                      {alias}
                    </a>
                  </li>
                ))}
              </ul>
            </GlossarySectionCard>
          )}

          {glossaryTags.length > 0 && (
            <GlossarySectionCard title="Glossary tags">
              <ul class="glossary-list">
                {glossaryTags.map((tag) => (
                  <li>
                    <a class="chip chip--sm chip--muted" href={`/glossary#${encodeURIComponent(tag)}`}>
                      #{formatLabel(tag)}
                    </a>
                  </li>
                ))}
              </ul>
            </GlossarySectionCard>
          )}

          {relatedTermsWithLinks.length > 0 && (
            <GlossarySectionCard title="Related glossary entries">
              <ul class="glossary-list">
                {relatedTermsWithLinks.map((related) => (
                  <li>
                    <a 
                      class="chip chip--sm chip--muted" 
                      href={`/glossary/${related.slug}`}
                      data-qv-trigger={related.slug}
                    >
                      {related.term}
                    </a>
                  </li>
                ))}
              </ul>
            </GlossarySectionCard>
          )}

          {relatedTagArticles.length > 0 && (
            <GlossarySectionCard title="Explorer coverage" description="Recent Soranauts articles tagged with this glossary concept.">
              <div class="glossary-related">
                {relatedTagArticles.map(({ tag, tagPermalink, posts }) => (
                  <div class="glossary-related__item">
                    <div class="glossary-related__header">
                      <div class="glossary-related__title">#{formatLabel(tag.title)}</div>
                      <a class="glossary-related__action" href={tagPermalink}>
                        View Explorer tag
                      </a>
                    </div>
                    <ul class="glossary-related__list">
                      {posts.map((post) => {
                        const postPermalink = getPermalink(post.slug, 'post');
                        return (
                          <li class="glossary-related__list-item">
                            <a href={postPermalink}>{post.data.title}</a>
                            {post.data.publishDate && <time>{dateFormatter.format(post.data.publishDate)}</time>}
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                ))}
              </div>
            </GlossarySectionCard>
          )}

          {term.examples && term.examples.length > 0 && (
            <GlossarySectionCard title="Examples" description="Common scenarios where this concept appears.">
              <ul class="glossary-list glossary-list--stacked">
                {term.examples.map((example) => (
                  <li class="glossary-list__bullet">{example}</li>
                ))}
              </ul>
            </GlossarySectionCard>
          )}

          {term.links && term.links.length > 0 && (
            <GlossarySectionCard title="More resources">
              <ul class="glossary-list glossary-list--stacked">
                {term.links.map((link) => (
                  <li>
                    <a
                      class="glossary-related-link glossary-related-link--external"
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </GlossarySectionCard>
          )}
        </div>
      </>
    )}
  </main>

  <Footer {...footerData} />
  
  <!-- Quick-View Panel (Progressive Enhancement) -->
  <GlossaryQuickView 
    client:load
    terms={quickViewTerms}
    initialSlug={initialQuickViewSlug}
  />
</Layout>

<!-- Structured Data for SEO -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
