---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/widgets/Header.astro';
import Footer from '../../components/widgets/Footer.astro';
import { AstroSeo } from '@astrolib/seo';
import glossary from '../../../public/glossary.json';
import { headerData, footerData } from '../../navigation';

export async function getStaticPaths() {
  return glossary.terms.map(term => ({
    params: { slug: term.slug },
    props: { term }
  }));
}

const { term } = Astro.props;

if (!term) {
  return Astro.redirect('/glossary');
}

const title = `${term.term} — SORA Glossary`;
const description = term.definition?.length > 160 ? term.definition.slice(0, 157) + '…' : term.definition;
const canonical = `https://soranauts.com/glossary/${term.slug}`;
const ogImage = `https://soranauts.com/og/glossary/${term.slug}.png`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "name": term.term,
  "termCode": term.slug,
  "description": term.definition,
  "inDefinedTermSet": "https://soranauts.com/glossary",
  "url": canonical,
  "alternateName": term.aliases ?? [],
  "subjectOf": term.links?.map(l => ({ "@type": "WebPage", "url": l.url })) ?? [],
};

// Generate related terms with proper links
const relatedTermsWithLinks = (term.relatedTerms?.map(r => {
  const relatedTerm = glossary.terms.find(t => {
    // Prefer exact term matches only (not aliases)
    return t.term === r || t.term.toLowerCase() === r.toLowerCase();
  });
  
  return relatedTerm && relatedTerm.slug !== term.slug ? 
    { term: r, slug: relatedTerm.slug } : null;
}).filter((related): related is { term: string; slug: string } => 
  related !== null
)) || [];
---

<Layout 
  metadata={{
    title,
    description,
    canonical,
    openGraph: {
      type: "article",
      url: canonical,
      images: [{ url: ogImage, width: 1200, height: 630 }]
    }
  }}
>
  <Header {...headerData} isSticky showRssFeed showToggleTheme />
  
  <main class="py-8 sm:py-16 lg:py-20">
    <div class="container mx-auto px-4 sm:px-6 max-w-4xl">
      <!-- Back Navigation -->
      <div class="mb-8">
        <a 
          href="/glossary" 
          class="inline-flex items-center text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300 transition-colors"
        >
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Back to Glossary
        </a>
      </div>

      <!-- Term Header -->
      <div class="mb-8">
        <div class="flex items-start justify-between mb-4">
          <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-gray-900 dark:text-white">
            {term.term}
          </h1>
          <span class={`px-3 py-1 rounded-full text-sm font-medium ml-4 ${
            term.category === 'token' ? 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200' :
            term.category === 'technology' ? 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200' :
            term.category === 'governance' ? 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200' :
            term.category === 'defi' ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200' :
            term.category === 'network' ? 'bg-indigo-100 text-indigo-800 dark:bg-indigo-900 dark:text-indigo-200' :
            'bg-pink-100 text-pink-800 dark:bg-pink-900 dark:text-pink-200'
          }`}>
            {term.category}
          </span>
        </div>
      </div>

      <!-- Term Definition -->
      <div class="prose prose-lg dark:prose-invert max-w-none mb-8">
        <p class="text-xl text-gray-600 dark:text-gray-300 leading-relaxed">
          {term.definition}
        </p>
      </div>

      <!-- Aliases -->
      {term.aliases && term.aliases.length > 1 && (
        <div class="mb-8">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Also known as</h2>
          <div class="flex flex-wrap gap-2">
            {term.aliases.slice(1).map((alias) => (
              <a 
                href={`/glossary#${encodeURIComponent(alias)}`}
                class="px-3 py-1 bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-600 hover:text-gray-800 dark:text-gray-300 dark:hover:text-gray-100 rounded-md text-sm transition-colors cursor-pointer inline-block"
                title={`Search for ${alias} in glossary`}
              >
                {alias}
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Tags -->
      {term.tags && term.tags.length > 0 && (
        <div class="mb-8">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Tags</h2>
          <div class="flex flex-wrap gap-2">
            {term.tags.map((tag) => (
              <a 
                href={`/glossary#${encodeURIComponent(tag)}`}
                class="px-3 py-1 bg-red-50 hover:bg-red-100 dark:bg-red-900/20 dark:hover:bg-red-900/40 text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300 rounded-md text-sm transition-colors cursor-pointer inline-block"
                title={`Filter by ${tag} tag in glossary`}
              >
                #{tag}
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Related Terms -->
      {relatedTermsWithLinks.length > 0 && (
        <div class="mb-8">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Related Terms</h2>
          <div class="flex flex-wrap gap-2">
            {relatedTermsWithLinks.map((related) => (
              <a 
                href={`/glossary/${related.slug}`}
                class="px-3 py-1 bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-md text-sm transition-colors"
              >
                {related.term}
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Examples -->
      {term.examples && term.examples.length > 0 && (
        <div class="mb-8">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Examples</h2>
          <ul class="space-y-2">
            {term.examples.map((example) => (
              <li class="text-gray-600 dark:text-gray-300">• {example}</li>
            ))}
          </ul>
        </div>
      )}

      <!-- Links -->
      {term.links && term.links.length > 0 && (
        <div class="mb-8">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Learn More</h2>
          <ul class="space-y-2">
            {term.links.map((link) => (
              <li>
                <a 
                  href={link.url} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300 transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </main>

  <Footer {...footerData} />
</Layout>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
