---
import PageLayout from '~/layouts/PageLayout.astro';
import TagFilters from '~/components/tag-hub/TagFilters';
import { getAllTagHubViewModels } from '~/lib/tag-hub';
import type { TagHubClientTag, TagHubDomainOption, TagHubTraitFilter } from '~/components/tag-hub/TagFilters';

export const prerender = true;

const allTags = getAllTagHubViewModels();

const domainLabels: Record<string, string> = {
  ecosystem: 'Ecosystem & Adoption',
  defi: 'DeFi & Liquidity',
  economics: 'Economics & Tokenomics',
  governance: 'Governance & Policy',
  technology: 'Technology & Infrastructure',
  network: 'Network & Validators',
};

const domainOptions: TagHubDomainOption[] = [
  { id: 'ecosystem', label: 'Ecosystem & Adoption' },
  { id: 'defi', label: 'DeFi & Liquidity' },
  { id: 'economics', label: 'Economics & Tokenomics' },
  { id: 'governance', label: 'Governance & Policy' },
  { id: 'technology', label: 'Technology & Infrastructure' },
  { id: 'network', label: 'Network & Validators' },
];

const traitFilters: TagHubTraitFilter[] = [
  { id: 'foundational', label: 'Foundational', trait: 'foundational' },
  { id: 'glossary', label: 'Glossary linked', trait: 'glossary-linked' },
  { id: 'beginner', label: 'Beginner friendly', trait: 'beginner-friendly' },
];

const islandTags: TagHubClientTag[] = allTags.map((tag) => ({
  slug: tag.slug,
  title: tag.title,
  summary: tag.summary,
  domain: tag.domain,
  domainLabel: domainLabels[tag.domain] ?? tag.domain,
  traits: tag.traits,
  quickPathIds: tag.quickPathIds,
  usageCount: tag.usageCount,
  firstSeen: tag.firstSeen,
  lastSeen: tag.lastSeen,
  glossaryRef: tag.glossaryRef,
  category: tag.category,
  relatedTags: tag.relatedTags,
  aliases: tag.aliases,
}));

const meta = {
  title: 'Explore SORA Topics | Soranauts',
  description: 'Browse and search topics across the SORA ecosystem. Find articles, guides, and resources by tag.',
  canonical: 'https://soranauts.com/explore',
};
---

<PageLayout metadata={meta}>
  <main class="explore-hub">
    <header class="explore-header">
      <p class="explore-header__kicker">SORA EXPLORER</p>
      <h1>Explore Topics</h1>
      <p class="explore-header__description">
        Search and filter {allTags.length} curated topics across the SORA ecosystem.
      </p>
      <p class="explore-header__learn-cta">
        New to SORA? <a href="/learn">Start with guided learning paths →</a>
      </p>
    </header>

    <section class="search-section">
      <TagFilters 
        client:load 
        tags={islandTags} 
        domains={domainOptions}
        traitFilters={traitFilters}
      />
    </section>
  </main>
</PageLayout>

<style>
  .explore-hub {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-6);
  }

  .explore-header {
    text-align: center;
    padding: var(--space-8) 0;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-6);
  }

  .explore-header__kicker {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
    text-transform: uppercase;
  }

  .explore-header h1 {
    font-size: var(--text-3xl);
    font-weight: 700;
    margin: 0 0 var(--space-3);
  }

  .explore-header__description {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    margin-bottom: var(--space-4);
  }

  .explore-header__learn-cta {
    font-size: var(--text-sm);
  }

  .explore-header__learn-cta a {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 500;
  }

  .explore-header__learn-cta a:hover {
    text-decoration: underline;
  }

  .search-section {
    padding: var(--space-4) 0;
  }
</style>
