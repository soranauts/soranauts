---
/**
 * Explore Page - Pure Tag Discovery Hub
 * 
 * Simplified version focused on tag search and browsing.
 * Learning content moved to /learn.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import { TAG_HUB_V1 } from '~/utils/featureFlags';
import {
  getAllTagHubViewModels,
  getTagHubDomains,
} from '~/lib/tag-hub';
import TagFilters from '~/components/tag-hub/TagFilters.tsx';
import type {
  TagHubDomainOption,
  TagHubTraitFilter,
  TagHubClientTag,
} from '~/components/tag-hub/TagFilters.tsx';

export const prerender = true;

const isEnabled = TAG_HUB_V1;
const tags = isEnabled ? getAllTagHubViewModels() : [];
const domainOrder = isEnabled ? getTagHubDomains() : [];

// Domain labels for filtering
const domainLabels: Record<string, string> = {
  ecosystem: 'Ecosystem & Adoption',
  defi: 'DeFi & Liquidity',
  economics: 'Economics & Tokenomics',
  governance: 'Governance & Policy',
  technology: 'Technology & Infrastructure',
  network: 'Network & Validators',
};

const domainOptions: TagHubDomainOption[] = domainOrder.map((domain) => ({
  id: domain,
  label: domainLabels[domain] ?? domain.replace(/-/g, ' ').replace(/(^|\s)\S/g, (match) => match.toUpperCase()),
}));

const traitFilters: TagHubTraitFilter[] = [
  { id: 'foundational', label: 'Foundational', trait: 'foundational' },
  { id: 'glossary', label: 'Glossary linked', trait: 'glossary-linked' },
  { id: 'beginner', label: 'Beginner friendly', trait: 'beginner-friendly' },
  { id: 'builder', label: 'Builder guide', trait: 'builder-guide' },
  { id: 'trending', label: 'Trending now', trait: 'trending' },
];

// Prepare tags for client component
const islandTags: TagHubClientTag[] = tags.map((tag) => ({
  slug: tag.slug,
  title: tag.title,
  summary: tag.summary,
  domain: tag.domain,
  domainLabel: domainLabels[tag.domain] ?? tag.domain,
  traits: tag.traits,
  quickPathIds: tag.quickPathIds,
  usageCount: tag.usageCount,
  firstSeen: tag.firstSeen,
  lastSeen: tag.lastSeen,
  glossaryRef: tag.glossaryRef,
  category: tag.category,
  relatedTags: tag.relatedTags,
  aliases: tag.aliases,
}));

const metadata = {
  title: 'Explore SORA Topics | Soranauts',
  description: 'Browse and search topics across the SORA ecosystem. Find articles, guides, and resources by domain.',
};
---

<PageLayout {metadata}>
  <main class="explore-hub">
    <header class="explore-header">
      <p class="explore-header__kicker">SORA EXPLORER</p>
      <h1>Explore Topics</h1>
      <p class="explore-header__description">
        Search {tags.length} curated topics across the SORA ecosystem.
      </p>
      <p class="explore-header__learn-cta">
        New to SORA? <a href="/learn">Start with guided learning paths →</a>
      </p>
    </header>

    {isEnabled ? (
      <section class="search-section">
        <TagFilters 
          client:load 
          tags={islandTags}
          domains={domainOptions}
          traitFilters={traitFilters}
        />
      </section>
    ) : (
      <section class="disabled-notice">
        <p>SORA Explorer is coming soon. Check back after the next release.</p>
      </section>
    )}

    <footer class="explore-footer">
      <div class="explore-footer__links">
        <a href="/glossary">📚 Browse Glossary (369 terms)</a>
        <a href="/learn">🎓 Learning Paths</a>
        <a href="/docs">📖 Technical Docs</a>
      </div>
    </footer>
  </main>
</PageLayout>

<style>
  .explore-hub {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-6);
  }

  .explore-header {
    text-align: center;
    padding: var(--space-8) 0;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-6);
  }

  .explore-header__kicker {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--red-500);
    margin-bottom: var(--space-2);
  }

  .explore-header h1 {
    font-size: var(--text-3xl);
    margin: 0 0 var(--space-3);
    color: var(--color-text);
  }

  .explore-header__description {
    color: var(--color-text-muted);
    margin: 0 0 var(--space-4);
  }

  .explore-header__learn-cta {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
  }

  .explore-header__learn-cta a {
    color: var(--red-500);
    text-decoration: none;
    font-weight: 500;
  }

  .explore-header__learn-cta a:hover {
    text-decoration: underline;
  }

  .search-section {
    padding: var(--space-4) 0;
  }

  .disabled-notice {
    text-align: center;
    padding: var(--space-12);
    color: var(--color-text-muted);
  }

  .explore-footer {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .explore-footer__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-6);
  }

  .explore-footer__links a {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .explore-footer__links a:hover {
    color: var(--color-text);
  }
</style>
