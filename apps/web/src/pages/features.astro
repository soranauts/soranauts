---
import PageLayout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Stats from '~/components/widgets/Stats.astro';
import ItemGrid from '~/components/ui/ItemGrid.astro';
import Timeline from '~/components/ui/Timeline.astro';
import Button from '~/components/ui/Button.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
// @ts-expect-error astro-icon ships runtime-only component typings
import { Icon } from 'astro-icon/components';
import type { MetaData } from '~/types';

const metadata: MetaData = {
  title: 'Features',
  description:
    'Explore the Soranauts platform highlights—design guardrails, glossary evolution, and automation work that keep the site fast and trustworthy.',
};

const featureLinks = {
  glossary: '/glossary',
  changelog: '/changelog',
  latestBlog: '/sora-v3-vision-defi-milestones-and-polkaswap-news-update-88',
};

const featureSignals = [
  {
    icon: 'tabler:rocket',
    title: 'Design system guardrails',
    description: 'Tokens, gradients, and typography refresh ensure every release lands with consistent styling.',
  },
  {
    icon: 'tabler:book',
    title: 'Glossary & glossary search',
    description: 'Interactive definitions and tooltips keep ecosystem language aligned with official docs.',
  },
  {
    icon: 'tabler:news',
    title: 'Article modernization',
    description: 'Long-form guides now open with TL;DRs, comparison tables, and collapsible FAQs.',
  },
  {
    icon: 'tabler:device-analytics',
    title: 'Automated knowledge base',
    description: 'Nightly syncs, provenance snapshots, and SARIF QA power reliable answers.',
  },
];

const deploymentFocus = [
  {
    icon: 'tabler:layout-grid',
    title: 'Design tokens live sitewide',
    description:
      'Layered CSS tokens, Tailwind guardrails, and updated layouts keep every page aligned without manual overrides.',
  },
  {
    icon: 'tabler:bookmarks',
    title: 'Glossary 2.0 shipping daily',
    description:
      '130+ linked definitions, instant search, and contextual tooltips make SORA terminology effortless to explore.',
  },
  {
    icon: 'tabler:article',
    title: '26+ long-form guides modernized',
    description:
      'Article TL;DRs, comparison tables, and collapsible FAQs are rolling out across the 2023–2024 catalog.',
  },
  {
    icon: 'tabler:clock',
    title: 'Nightly sync at 03:17 UTC',
    description:
      'Automated pulls from SORA wiki, Soramitsu, Medium, and GitHub rebuild provenance-backed indices while you sleep.',
  },
];

const stats = [
  {
    amount: '26+',
    title: 'Articles rebuilt with TL;DRs, evidence-backed links, and updated governance coverage since Q3 2025',
    icon: 'tabler:article-filled-filled',
  },
  {
    amount: '130+',
    title: 'Glossary entries with instant search, tooltips, and auto-linking across the site',
    icon: 'tabler:book',
  },
  {
    amount: '1,000+',
    title: 'Knowledge assets indexed with provenance snapshots and hybrid retrieval guardrails',
    icon: 'tabler:layers-union',
  },
  {
    amount: '10+',
    title: 'Automated pipelines syncing wiki docs, repos, partner sites, and Medium digests',
    icon: 'tabler:git-branch',
  },
];

const highlightItems = [
  {
    icon: 'tabler:clipboard-data',
    title: 'Public changelog',
    description:
      'We publish a running log of UX, content, and automation updates so supporters can see what shipped each week.',
    callToAction: {
      href: featureLinks.changelog,
      text: 'Review recent releases',
      icon: 'tabler:external-link',
    },
  },
  {
    icon: 'tabler:search',
    title: 'Glossary search revamp',
    description:
      'Interactive filters, hover tooltips, and category chips make 130+ SORA definitions discoverable in seconds.',
    callToAction: {
      href: featureLinks.glossary,
      text: 'Explore glossary 2.0',
      icon: 'tabler:arrow-up-right',
    },
  },
  {
    icon: 'tabler:script',
    title: 'Article modernization sprint',
    description:
      'Long-form content now ships with TL;DRs, FAQ toggles, strategic linking, and consistent metadata for SEO + UX gains.',
    callToAction: {
      href: '/sora-roadmap-token-repackaging-hub-chain-defi-upgrades',
      text: 'See an updated article',
      icon: 'tabler:external-link',
    },
  },
];

const searchEnhancements = [
  {
    icon: 'tabler:filter',
    title: 'Glossary & article filters',
    description:
      'Instantly pivot between definitions and long-form guides with type chips, category filters, and result counts that stay in sync.',
  },
  {
    icon: 'tabler:layout',
    title: 'Context-rich cards',
    description:
      'Each result surfaces metadata — publish dates, reading time, tags, and aliases — so you know what you are opening before you click.',
  },
  {
    icon: 'tabler:keyboard',
    title: 'Keyboard-first navigation',
    description:
      'Arrow through results, press Enter to open, and rely on global ⌘K / Ctrl+K shortcuts anywhere on the site.',
  },
  {
    icon: 'tabler:chart-dots',
    title: 'Search analytics + synonyms',
    description:
      'Built-in synonym expansion and lightweight analytics capture what the community searches for so we can prioritize new content.',
  },
];

const searchInsights = [
  {
    icon: 'tabler:app-window',
    title: 'One unified overlay',
    description: 'The modal preloads Pagefind assets and caches responses so searches stay fast even on repeat queries.',
  },
  {
    icon: 'tabler:sparkles',
    title: 'Smart highlighting',
    description: 'Highlights include synonyms (e.g., SORA ↔ Soramitsu) and deduplicate repeated terms for easier scanning.',
  },
  {
    icon: 'tabler:shield-check',
    title: 'Built for privacy',
    description: 'Everything runs client-side without third-party trackers; analytics funnel through self-hosted PostHog events.',
  },
];

const timelineItems = [
  {
    title: 'November 2025 — Knowledge base hardening complete',
    description:
      'We locked in provenance snapshots, hybrid retrieval, and CI guardrails so every answer cites auditable evidence.',
    icon: 'tabler:shield-lock',
  },
  {
    title: 'October 2025 — Article modernization wave',
    description:
      '26+ long-form guides received TL;DRs, comparison tables, expanded tags, and collapsible FAQs for faster scanning.',
    icon: 'tabler:news',
  },
  {
    title: 'September 2025 — Glossary 2.0 rollout',
    description:
      'Interactive search, taxonomy chips, and hover previews shipped alongside Related Articles and visual refreshes.',
    icon: 'tabler:book-2',
  },
  {
    title: 'June 2025 — Release cadence reboot',
    description:
      'Website improvements log launched with performance tuning, SEO guardrails, and navigation reordering for clarity.',
    icon: 'tabler:rocket',
  },
];

const resourceLinks = [
  {
    icon: 'tabler:clipboard-check',
    title: 'SORA Network Changelog',
    description:
      'Track mainnet releases, bridge upgrades, and validator tooling milestones from the public network changelog.',
    href: 'https://wiki.sora.org/changelog.html',
    external: true,
  },
  {
    icon: 'tabler:planet',
    title: 'Soranauts Release Log',
    description:
      'Dive deeper into the UX, content, and automation work shipping each week across the platform.',
    href: featureLinks.changelog,
  },
  {
    icon: 'tabler:route',
    title: 'SORA Integrated Plan Insights',
    description:
      'Understand how community goals align with the roadmap across business, backend, web, and mobile tracks.',
    href: 'https://wiki.sora.org/integrated-plan.html',
    external: true,
  },
];
---

<PageLayout metadata={metadata}>
  <section class="relative overflow-hidden bg-page">
    <div class="absolute inset-0 -z-[1] bg-gradient-to-br from-brand-soft/60 via-transparent to-transparent" aria-hidden="true" />
    <div class="mx-auto flex max-w-6xl flex-col gap-12 px-4 pb-20 pt-24 md:px-6 lg:flex-row lg:items-start">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 rounded-full border border-brand-soft bg-surface/80 px-4 py-1 text-xs font-semibold uppercase tracking-[0.35em] text-brand-600 shadow-sm">
          Platform Highlights
        </span>
        <h1 class="mt-6 text-4xl font-bold leading-tight text-text-main md:text-5xl lg:text-6xl">
          Explore the Soranauts features that keep the site credible, fast, and easy to trust.
        </h1>
        <p class="mt-6 text-lg text-text-muted">
          The Soranauts platform blends UX design, knowledge base automation, and community documentation. These sections showcase the systems that shape every release.
        </p>
        <div class="mt-8 grid gap-3 sm:flex sm:flex-wrap sm:gap-4">
          <Button variant="primary" href="#highlights" text="Jump to highlights" icon="tabler:sparkles" class="w-full justify-center sm:w-auto sm:min-w-[220px]" />
          <Button variant="secondary" href="https://t.me/Soranauts" target="_blank" text="Share feedback in Telegram" icon="tabler:send" class="w-full justify-center sm:w-auto sm:min-w-[220px]" />
          <Button variant="tertiary" href={featureLinks.changelog} text="Browse the changelog" icon="tabler:arrow-up-right" class="w-full justify-center border-border-subtle text-text-muted hover:border-brand-500 hover:text-link sm:w-auto sm:min-w-[220px]" />
        </div>
        <ul class="mt-10 grid gap-4 text-base text-text-muted sm:grid-cols-2">
          {featureSignals.map(({ icon, title, description }) => (
            <li class="flex items-start gap-3 rounded-xl border border-border-subtle bg-surface/90 p-4 shadow-sm">
              <Icon name={icon} class="mt-0.5 h-6 w-6 text-brand-500" />
              <div>
                <p class="text-sm font-semibold text-text-main">{title}</p>
                <p class="mt-1 text-sm text-text-muted">{description}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <div class="relative flex-1 overflow-hidden rounded-3xl border border-border-subtle bg-surface/90 p-8 shadow-elevated backdrop-blur">
        <div class="space-y-6">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.3em] text-text-soft">Deployment Snapshot</p>
            <h2 class="mt-3 text-2xl font-semibold text-text-main">How the platform earns trust.</h2>
            <p class="mt-4 text-sm text-text-muted">
              These pillars explain how Soranauts features combine: front-end polish, glossary clarity, and automation that keeps information current.
            </p>
          </div>
          <div class="grid gap-4">
            {deploymentFocus.map(({ title, description, icon }) => (
              <div class="flex items-start gap-3 rounded-xl border border-border-subtle/80 bg-page/70 p-4">
                <Icon name={icon} class="mt-0.5 h-5 w-5 text-brand-500" />
                <div>
                  <p class="text-sm font-semibold text-text-main">{title}</p>
                  <p class="mt-1 text-sm text-text-muted">{description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <Stats
    id="metrics"
    tagline="Feature Metrics"
    title="The data behind the Soranauts experience"
    subtitle="Each enhancement blends UX polish with knowledge base safeguards so contributors can rely on the platform daily."
    stats={stats}
    classes={{ container: 'mt-0' }}
  />

  <WidgetWrapper id="highlights" containerClass="max-w-6xl">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.35em] text-brand-500">Highlights</p>
      <h2 class="mt-4 text-3xl font-bold text-text-main md:text-4xl">What stands out right now.</h2>
      <p class="mt-4 text-lg text-text-muted">
        Discoverability, accuracy, and contributor friendliness drive every release. These highlights capture the capabilities users feel most.
      </p>
    </div>
    <div class="mt-12">
      <ItemGrid
        columns={3}
        items={highlightItems}
        classes={{
          container: 'gap-10',
          panel: 'flex-col rounded-2xl border border-border-subtle bg-surface p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-elevated h-full',
          icon: 'w-10 h-10 text-brand-500',
          title: 'text-2xl text-text-main',
          description: 'text-base text-text-muted',
          action: 'mt-4 flex-grow flex items-end',
        }}
      />
    </div>
  </WidgetWrapper>

  <WidgetWrapper id="search-modal" containerClass="max-w-6xl">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)]">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.35em] text-brand-500">Search & Navigation</p>
        <h2 class="mt-4 text-3xl font-bold text-text-main md:text-4xl">
          Command+K now surfaces the entire Soranauts knowledge base.
        </h2>
        <p class="mt-4 text-lg text-text-muted">
          The new search modal blends glossary precision with article depth. Filters, metadata-rich cards, and synonym-aware highlighting
          make it easier to jump from definitions to deep dives without leaving the keyboard.
        </p>
        <ul class="mt-8 space-y-4">
          {searchEnhancements.map(({ icon, title, description }) => (
            <li class="flex items-start gap-3 rounded-2xl border border-border-subtle bg-surface/90 p-4 shadow-sm">
              <span class="mt-0.5 flex h-9 w-9 items-center justify-center rounded-xl bg-brand-soft/60 text-brand-600">
                <Icon name={icon} class="h-5 w-5" />
              </span>
              <div>
                <p class="text-sm font-semibold text-text-main">{title}</p>
                <p class="mt-1 text-sm text-text-muted">{description}</p>
              </div>
            </li>
          ))}
        </ul>
        <div class="mt-8 rounded-2xl border border-dashed border-brand-soft bg-brand-soft/20 px-4 py-3 text-sm text-text-muted sm:text-base">
          Tip: Press <span class="mx-1 inline-flex rounded bg-soft px-2 py-0.5 font-mono text-sm">⌘K</span> (macOS) or
          <span class="mx-1 inline-flex rounded bg-soft px-2 py-0.5 font-mono text-sm">Ctrl+K</span> (Windows/Linux) to open the modal anywhere on the site.
        </div>
      </div>
      <div class="flex flex-col gap-4">
        {searchInsights.map(({ icon, title, description }) => (
          <div class="rounded-2xl border border-border-subtle bg-page/80 p-5 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-soft text-brand-600">
                <Icon name={icon} class="h-5 w-5" />
              </span>
              <p class="text-base font-semibold text-text-main">{title}</p>
            </div>
            <p class="mt-3 text-sm text-text-muted">{description}</p>
          </div>
        ))}
        <div class="mt-auto rounded-2xl border border-border-subtle bg-surface/90 p-5 shadow-sm">
          <p class="text-sm font-semibold uppercase tracking-[0.25em] text-brand-500">Why it matters</p>
          <p class="mt-3 text-sm text-text-muted">
            Search analytics stay self-hosted, and every result links back to content backed by provenance snapshots. It is a faster path
            to trustworthy answers, whether you are clarifying terminology or citing a governance update.
          </p>
        </div>
      </div>
    </div>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-6xl" isDark bg={`<div class="absolute inset-0 bg-gradient-to-br from-brand-soft/20 via-transparent to-brand-soft/10"></div>`}>
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.35em] text-brand-200">Evolution Timeline</p>
      <h2 class="mt-4 text-3xl font-bold text-white md:text-4xl">How the Soranauts feature set matured in 2025.</h2>
      <p class="mt-4 text-lg text-text-soft">
        From design tokens to knowledge base hardening, every milestone brings the community closer to a transparent, well-documented SORA ecosystem.
      </p>
    </div>
    <div class="mt-12">
      <Timeline
        defaultIcon="tabler:circle-dotted"
        items={timelineItems.map(({ title, description, icon }) => ({
          title,
          description,
          icon,
          classes: {
            panel: 'bg-surface/95 border border-border-subtle rounded-2xl p-6 shadow-sm',
            title: 'text-2xl text-text-main',
            description: 'text-base text-text-muted',
            icon: 'text-brand-500 border-brand-500/60 bg-page/80',
          },
        }))}
        classes={{
          container: 'relative mx-auto max-w-4xl',
          panel: 'flex-col',
          icon: 'border-brand-500',
          description: 'text-base text-text-muted',
        }}
      />
    </div>
  </WidgetWrapper>

  <section class="px-4 md:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="rounded-3xl border border-border-subtle bg-surface p-6 shadow-sm md:p-10">
        <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
          <div class="max-w-2xl">
            <p class="text-sm font-semibold uppercase tracking-[0.35em] text-brand-500">Helpful Resources</p>
            <h2 class="mt-4 text-3xl font-bold text-text-main md:text-4xl">Dig deeper into our documentation.</h2>
            <p class="mt-4 text-lg text-text-muted">
              Transparency matters. These resources provide network-level release notes, Soranauts-specific improvements, and roadmap context for what ships next.
            </p>
          </div>
        </div>
        <div class="mt-8 grid gap-4 md:grid-cols-3">
          {resourceLinks.map(({ title, description, href, icon, external }) => (
            <a
              class="group flex h-full flex-col gap-3 rounded-2xl border border-border-subtle bg-page/80 p-5 transition hover:-translate-y-1 hover:border-brand-500 hover:shadow-elevated focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
              href={href}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
            >
              <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-soft text-brand-600 transition group-hover:bg-brand-500 group-hover:text-white">
                  <Icon name={icon} class="h-5 w-5" />
                </span>
                <p class="text-lg font-semibold text-text-main">{title}</p>
              </div>
              <p class="text-sm text-text-muted">{description}</p>
              <span class="mt-auto inline-flex items-center gap-2 text-sm font-semibold text-link group-hover:text-link-hover">
                View resource
                <Icon name="tabler:arrow-up-right" class="h-4 w-4" />
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CallToAction
    isDark
    classes={{
      container: 'max-w-4xl',
      actions: 'gap-3 sm:gap-4 lg:gap-3 xl:gap-2.5 lg:max-w-xl xl:max-w-lg',
    }}
    actions={[
      {
        variant: 'primary',
        href: '/donate',
        text: 'Support Soranauts',
        icon: 'tabler:heart',
        class: 'md:px-5 md:py-2 lg:px-4 lg:py-1.5 lg:text-base lg:rounded-3xl xl:px-3.5 xl:py-1.5 xl:rounded-3xl',
      },
      {
        variant: 'secondary',
        href: 'https://t.me/Soranauts',
        target: '_blank',
        text: 'Join the community',
        icon: 'tabler:send',
        class: 'md:px-5 md:py-2 lg:px-4 lg:py-1.5 lg:text-base lg:rounded-3xl xl:px-3.5 xl:py-1.5 xl:rounded-3xl',
      },
    ]}
  >
    <Fragment slot="title">
      Help us keep the decentralized frontier approachable.
    </Fragment>
    <Fragment slot="subtitle">
      Every guide, glossary entry, and deployment log is crafted to make the SORA ecosystem easier to navigate. Your support keeps that cadence going.
    </Fragment>
  </CallToAction>
</PageLayout>


