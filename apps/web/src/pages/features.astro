---
import PageLayout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Stats from '~/components/widgets/Stats.astro';
import ItemGrid from '~/components/ui/ItemGrid.astro';
import Timeline from '~/components/ui/Timeline.astro';
import Button from '~/components/ui/Button.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
// @ts-expect-error astro-icon ships runtime-only component typings
import { Icon } from 'astro-icon/components';
import type { MetaData } from '~/types';

const metadata: MetaData = {
  title: 'Soranauts Platform Features',
  description:
    'Explore how the SORA Glossary, Explorer, and unified search work together to make SORA ecosystem knowledge accessible and verifiable.',
};

const featureLinks = {
  glossary: '/glossary',
  explore: '/explore',
  about: '/about',
};

const featureSignals = [
  {
    icon: 'tabler:vocabulary',
    title: 'Unified Glossary with 338 terms',
    description: 'MDX-based Nexus terms, SORA ecosystem taxonomy, and canonical tags merged into one searchable, categorized reference.',
  },
  {
    icon: 'tabler:compass',
    title: 'Explorer Tag Hub',
    description: 'Six domain dashboards with quick journeys and trait filters that connect articles to glossary definitions.',
  },
  {
    icon: 'tabler:search',
    title: 'Command+K unified search',
    description: 'Search glossary terms, articles, and Explorer entries from one keyboard-first modal with category filters.',
  },
  {
    icon: 'tabler:tags',
    title: '19 taxonomy categories',
    description: 'From DeFi and Governance to Cryptography and Consensus — terms organized by domain for faster discovery.',
  },
];

const glossaryFeatures = [
  {
    icon: 'tabler:database',
    title: 'Multi-source data merge',
    description: 'Nexus MDX content, SORA taxonomy terms, and canonical tags with fallback definitions combined into a single JSON index.',
  },
  {
    icon: 'tabler:category',
    title: 'Smart categorization',
    description: 'Each term assigned to one of 19 categories (Economics, Technology, DeFi, Governance, etc.) for filtered browsing.',
  },
  {
    icon: 'tabler:link',
    title: 'Related terms & hashtags',
    description: 'Clickable hashtag chips link to related definitions, with proper formatting for tokens (XOR, VAL) and products (Polkaswap).',
  },
  {
    icon: 'tabler:star',
    title: 'Featured terms',
    description: 'Curated selection of popular ecosystem terms (XOR, Polkaswap, TONSWAP, Kensetsu) highlighted on the glossary landing.',
  },
];

const explorerFeatures = [
  {
    icon: 'tabler:layout-dashboard',
    title: 'Domain dashboards',
    description: 'Six Explorer domains (Ecosystem, DeFi, Economics, Governance, Technology, Network) organize content by theme.',
  },
  {
    icon: 'tabler:route',
    title: 'Quick journeys',
    description: 'Curated paths guide users from onboarding to advanced topics without getting lost in the full content library.',
  },
  {
    icon: 'tabler:filter',
    title: 'Trait filters',
    description: 'Filter by foundational, beginner, advanced, trending, or builder-focused content to match your experience level.',
  },
  {
    icon: 'tabler:arrows-join',
    title: 'Glossary integration',
    description: 'Explorer cards link directly to glossary definitions, keeping terminology consistent across the site.',
  },
];

const stats = [
  {
    amount: '338',
    title: 'Glossary terms from Nexus MDX, SORA taxonomy, and canonical tags with verified definitions',
    icon: 'tabler:vocabulary',
  },
  {
    amount: '19',
    title: 'Taxonomy categories spanning Economics, Technology, DeFi, Governance, Cryptography, and more',
    icon: 'tabler:category',
  },
  {
    amount: '6',
    title: 'Explorer domains organizing content by Ecosystem, DeFi, Economics, Governance, Technology, and Network',
    icon: 'tabler:compass',
  },
  {
    amount: '52',
    title: 'Economics terms covering XOR, VAL, PSWAP, Token Bonding Curve, and monetary policy',
    icon: 'tabler:chart-line',
  },
];

const highlightItems = [
  {
    icon: 'tabler:vocabulary',
    title: 'SORA Glossary',
    description:
      'Browse 338 terms across 19 categories with instant search, category filters, clickable hashtags, and featured terms for quick access to XOR, Polkaswap, TONSWAP, and Kensetsu.',
    callToAction: {
      href: featureLinks.glossary,
      text: 'Explore the Glossary',
      icon: 'tabler:arrow-up-right',
      isCardLink: true,
    },
  },
  {
    icon: 'tabler:compass',
    title: 'SORA Explorer',
    description:
      'Navigate six domain dashboards with curated quick journeys and trait filters that connect articles to glossary definitions and governance context.',
    callToAction: {
      href: featureLinks.explore,
      text: 'Open the Explorer',
      icon: 'tabler:arrow-up-right',
      isCardLink: true,
    },
  },
  {
    icon: 'tabler:search',
    title: 'Unified Search',
    description:
      'Press ⌘K to search glossary terms, articles, and Explorer entries from one modal with type filters, metadata cards, and keyboard navigation.',
    callToAction: {
      href: featureLinks.about,
      text: 'Learn more',
      icon: 'tabler:arrow-up-right',
      isCardLink: true,
    },
  },
];

const searchFeatures = [
  {
    icon: 'tabler:filter',
    title: 'Category filters',
    description: 'Filter glossary results by any of 19 categories, with counts that update as you type.',
  },
  {
    icon: 'tabler:layout-cards',
    title: 'Rich result cards',
    description: 'See term definitions, categories, and related hashtags before clicking.',
  },
  {
    icon: 'tabler:keyboard',
    title: 'Keyboard navigation',
    description: 'Arrow through results, press Enter to open — no mouse required.',
  },
  {
    icon: 'tabler:hash',
    title: 'Hashtag linking',
    description: 'Click any hashtag to jump to that term, with proper casing for tokens (XOR, PSWAP) and products (Polkaswap).',
  },
];

const timelineItems = [
  {
    title: 'December 2025 — Glossary expansion to 338 terms',
    description:
      'Merged Nexus MDX content, SORA ecosystem taxonomy, and canonical tags into a unified glossary with 19 categories, clickable hashtags, and collapsible category filters.',
    icon: 'tabler:vocabulary',
  },
  {
    title: 'November 2025 — SORA Explorer preview',
    description:
      'Tag Hub V1 launched with six domain dashboards, quick journeys, and trait filters connecting articles to glossary definitions.',
    icon: 'tabler:compass',
  },
  {
    title: 'October 2025 — Article modernization',
    description:
      '26+ long-form guides gained TL;DRs, comparison tables, structured tags, and collapsible FAQs.',
    icon: 'tabler:news',
  },
  {
    title: 'September 2025 — About page redesign',
    description:
      'Mission-driven narrative page with principles, methodology, and non-goals replacing the old features-style layout.',
    icon: 'tabler:info-circle',
  },
];

const resourceLinks = [
  {
    icon: 'tabler:vocabulary',
    title: 'SORA Glossary',
    description: '338 terms across 19 categories with instant search, category filters, and clickable hashtags.',
    href: featureLinks.glossary,
  },
  {
    icon: 'tabler:compass',
    title: 'SORA Explorer',
    description: 'Six domain dashboards with quick journeys and trait filters for navigating the ecosystem.',
    href: featureLinks.explore,
  },
  {
    icon: 'tabler:info-circle',
    title: 'About Soranauts',
    description: 'Our mission, principles, and methodology for building a trustworthy SORA reference.',
    href: featureLinks.about,
  },
  {
    icon: 'tabler:external-link',
    title: 'SORA Wiki',
    description: 'Official documentation maintained by the SORA network team.',
    href: 'https://wiki.sora.org/',
    external: true,
  },
];
---

<PageLayout metadata={metadata}>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-page">
    <div class="absolute inset-0 -z-[1] bg-gradient-to-br from-brand-soft/50 via-transparent to-transparent" aria-hidden="true" />
    <div class="mx-auto max-w-6xl px-4 pb-16 pt-24 md:px-6">
      <div class="mx-auto max-w-4xl text-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-brand-soft bg-surface/80 px-4 py-1 text-xs font-semibold uppercase tracking-[0.35em] text-brand-600 shadow-sm">
          Platform Features
        </span>
        <h1 class="mt-6 text-4xl font-bold leading-tight text-text-main md:text-5xl">
          Everything you need to understand the SORA ecosystem
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-text-muted">
          The SORA Glossary, Explorer, and unified search work together to make complex blockchain concepts accessible. 338 terms, 19 categories, and growing.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <Button variant="primary" href={featureLinks.glossary} text="Browse the Glossary" icon="tabler:vocabulary" />
          <Button variant="secondary" href={featureLinks.explore} text="Open the Explorer" icon="tabler:compass" />
          <Button variant="tertiary" href={featureLinks.about} text="About Soranauts" icon="tabler:info-circle" class="border-border-subtle text-text-muted hover:border-brand-500 hover:text-link" />
        </div>
      </div>
      
      <!-- Feature signals grid -->
      <div class="mx-auto mt-16 grid max-w-5xl gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {featureSignals.map(({ icon, title, description }) => (
          <div class="flex flex-col gap-3 rounded-xl border border-border-subtle bg-surface/90 p-5 shadow-sm">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-soft text-brand-500">
              <Icon name={icon} class="h-5 w-5" />
            </div>
            <h3 class="font-semibold text-text-main">{title}</h3>
            <p class="text-sm text-text-muted">{description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <Stats
    id="metrics"
    tagline="By the Numbers"
    title="The scope of the Soranauts knowledge base"
    subtitle="A comprehensive reference built from official sources, community contributions, and verified definitions."
    stats={stats}
    classes={{ container: 'mt-0' }}
  />

  <!-- Highlights Section -->
  <WidgetWrapper id="highlights" containerClass="max-w-6xl">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.35em] text-brand-500">Highlights</p>
      <h2 class="mt-4 text-3xl font-bold text-text-main md:text-4xl">Three ways to explore</h2>
      <p class="mt-4 text-lg text-text-muted">
        Whether you need a quick definition, want to browse by topic, or are researching a specific domain — there's a path for you.
      </p>
    </div>
    <div class="mt-12">
      <ItemGrid
        columns={3}
        items={highlightItems}
        classes={{
          container: 'gap-8',
          panel: 'flex-col rounded-2xl border border-border-subtle bg-surface p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-elevated hover:border-brand-500 h-full',
          icon: 'w-10 h-10 text-brand-500',
          title: 'text-xl text-text-main',
          description: 'text-base text-text-muted',
          action: 'mt-4 flex-grow flex items-end',
        }}
      />
    </div>
  </WidgetWrapper>

  <!-- Glossary Deep Dive -->
  <WidgetWrapper containerClass="max-w-6xl">
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.35em] text-brand-500">Glossary</p>
        <h2 class="mt-4 text-3xl font-bold text-text-main md:text-4xl">
          338 terms. 19 categories. One unified reference.
        </h2>
        <p class="mt-4 text-lg text-text-muted">
          The SORA Glossary merges Nexus technical documentation, ecosystem taxonomy terms, and canonical tags into a searchable, categorized knowledge base.
        </p>
        <div class="mt-8 space-y-4">
          {glossaryFeatures.map(({ icon, title, description }) => (
            <div class="flex items-start gap-4 rounded-xl border border-border-subtle bg-surface/90 p-4">
              <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-brand-soft text-brand-500">
                <Icon name={icon} class="h-5 w-5" />
              </div>
              <div>
                <h3 class="font-semibold text-text-main">{title}</h3>
                <p class="mt-1 text-sm text-text-muted">{description}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="mt-8">
          <Button variant="primary" href={featureLinks.glossary} text="Browse the Glossary" icon="tabler:arrow-up-right" />
        </div>
      </div>
      <div class="flex flex-col gap-4">
        <div class="rounded-2xl border border-border-subtle bg-surface/50 p-6">
          <h3 class="font-semibold text-text-main">Top categories by term count</h3>
          <div class="mt-4 space-y-3">
            {[
              { name: 'Economics', count: 52, desc: 'XOR, VAL, PSWAP, Token Bonding Curve' },
              { name: 'Technology', count: 43, desc: 'Substrate, Iroha, smart contracts' },
              { name: 'Cryptography', count: 38, desc: 'BLAKE2b, Merkle trees, signatures' },
              { name: 'Execution', count: 34, desc: 'Triggers, ISI, Kotodama' },
              { name: 'Governance', count: 34, desc: 'Proposals, voting, councils' },
              { name: 'DeFi', count: 25, desc: 'AMM, liquidity, Polkaswap' },
            ].map(({ name, count, desc }) => (
              <div class="flex items-center justify-between rounded-lg bg-page/50 px-4 py-3">
                <div>
                  <p class="font-medium text-text-main">{name}</p>
                  <p class="text-xs text-text-muted">{desc}</p>
                </div>
                <span class="rounded-full bg-brand-soft px-3 py-1 text-sm font-semibold text-brand-600">{count}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="rounded-2xl border border-dashed border-brand-soft bg-brand-soft/10 p-5">
          <p class="text-sm text-text-muted">
            <strong class="text-text-main">Featured terms:</strong> XOR, VAL, PSWAP, Polkaswap, TONSWAP, Kensetsu, Token Bonding Curve, and more are highlighted on the glossary landing page.
          </p>
        </div>
      </div>
    </div>
  </WidgetWrapper>

  <!-- Explorer Deep Dive -->
  <WidgetWrapper containerClass="max-w-6xl">
    <div class="grid gap-12 lg:grid-cols-2">
      <div class="order-2 lg:order-1">
        <div class="rounded-2xl border border-border-subtle bg-surface/50 p-6">
          <h3 class="font-semibold text-text-main">Explorer domains</h3>
          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            {[
              { name: 'Ecosystem', icon: 'tabler:world', desc: 'SORA, Polkaswap, wallets' },
              { name: 'DeFi', icon: 'tabler:chart-pie', desc: 'AMM, liquidity, yield' },
              { name: 'Economics', icon: 'tabler:coin', desc: 'Tokens, TBC, monetary' },
              { name: 'Governance', icon: 'tabler:gavel', desc: 'Proposals, voting, DAO' },
              { name: 'Technology', icon: 'tabler:cpu', desc: 'Substrate, Iroha, bridges' },
              { name: 'Network', icon: 'tabler:network', desc: 'Validators, consensus' },
            ].map(({ name, icon, desc }) => (
              <div class="flex items-center gap-3 rounded-lg bg-page/50 px-4 py-3">
                <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-soft text-brand-500">
                  <Icon name={icon} class="h-4 w-4" />
                </div>
                <div>
                  <p class="font-medium text-text-main">{name}</p>
                  <p class="text-xs text-text-muted">{desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="order-1 lg:order-2">
        <p class="text-sm font-semibold uppercase tracking-[0.35em] text-brand-500">Explorer</p>
        <h2 class="mt-4 text-3xl font-bold text-text-main md:text-4xl">
          Navigate by domain, not by guesswork
        </h2>
        <p class="mt-4 text-lg text-text-muted">
          The SORA Explorer organizes articles and guides into six thematic domains with quick journeys and trait filters.
        </p>
        <div class="mt-8 space-y-4">
          {explorerFeatures.map(({ icon, title, description }) => (
            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-brand-soft text-brand-500">
                <Icon name={icon} class="h-5 w-5" />
              </div>
              <div>
                <h3 class="font-semibold text-text-main">{title}</h3>
                <p class="mt-1 text-sm text-text-muted">{description}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="mt-8">
          <Button variant="primary" href={featureLinks.explore} text="Open the Explorer" icon="tabler:arrow-up-right" />
        </div>
      </div>
    </div>
  </WidgetWrapper>

  <!-- Search Section -->
  <WidgetWrapper containerClass="max-w-6xl">
    <div class="rounded-2xl border border-border-subtle bg-surface/50 p-8 md:p-10">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.35em] text-brand-500">Unified Search</p>
        <h2 class="mt-4 text-3xl font-bold text-text-main md:text-4xl">
          Press ⌘K to search everything
        </h2>
        <p class="mt-4 text-lg text-text-muted">
          One modal to search glossary terms, articles, and Explorer entries with category filters and keyboard navigation.
        </p>
      </div>
      <div class="mx-auto mt-10 grid max-w-4xl gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {searchFeatures.map(({ icon, title, description }) => (
          <div class="flex flex-col items-center gap-3 text-center">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-soft text-brand-500">
              <Icon name={icon} class="h-6 w-6" />
            </div>
            <h3 class="font-semibold text-text-main">{title}</h3>
            <p class="text-sm text-text-muted">{description}</p>
          </div>
        ))}
      </div>
      <div class="mx-auto mt-8 max-w-md rounded-xl border border-dashed border-brand-soft bg-brand-soft/20 px-4 py-3 text-center text-sm text-text-muted">
        Press <span class="mx-1 inline-flex rounded bg-soft px-2 py-0.5 font-mono text-sm">⌘K</span> (macOS) or
        <span class="mx-1 inline-flex rounded bg-soft px-2 py-0.5 font-mono text-sm">Ctrl+K</span> (Windows/Linux)
      </div>
    </div>
  </WidgetWrapper>

  <!-- Timeline Section -->
  <WidgetWrapper containerClass="max-w-6xl" isDark bg={`<div class="absolute inset-0 bg-gradient-to-br from-brand-soft/20 via-transparent to-brand-soft/10"></div>`}>
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.35em] text-brand-200">Recent Updates</p>
      <h2 class="mt-4 text-3xl font-bold text-white md:text-4xl">What we shipped in 2025</h2>
      <p class="mt-4 text-lg text-text-soft">
        From glossary expansion to Explorer launch — the platform keeps evolving.
      </p>
    </div>
    <div class="mt-12">
      <Timeline
        defaultIcon="tabler:circle-dotted"
        items={timelineItems.map(({ title, description, icon }) => ({
          title,
          description,
          icon,
          classes: {
            panel: 'bg-surface/95 border border-border-subtle rounded-2xl p-6 shadow-sm',
            title: 'text-xl text-text-main',
            description: 'text-base text-text-muted',
            icon: 'text-brand-500 border-brand-500/60 bg-page/80',
          },
        }))}
        classes={{
          container: 'relative mx-auto max-w-4xl',
          panel: 'flex-col',
          icon: 'border-brand-500',
          description: 'text-base text-text-muted',
        }}
      />
    </div>
  </WidgetWrapper>

  <!-- Resources Section -->
  <section class="px-4 py-16 md:px-6">
    <div class="mx-auto max-w-5xl">
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.35em] text-brand-500">Quick Links</p>
        <h2 class="mt-4 text-3xl font-bold text-text-main md:text-4xl">Start exploring</h2>
      </div>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {resourceLinks.map(({ title, description, href, icon, external }) => (
          <a
            class="group flex flex-col gap-3 rounded-xl border border-border-subtle bg-surface p-5 transition hover:-translate-y-1 hover:border-brand-500 hover:shadow-elevated"
            href={href}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener noreferrer' : undefined}
          >
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-soft text-brand-600 transition group-hover:bg-brand-500 group-hover:text-white">
              <Icon name={icon} class="h-5 w-5" />
            </div>
            <h3 class="font-semibold text-text-main">{title}</h3>
            <p class="text-sm text-text-muted">{description}</p>
            <span class="mt-auto inline-flex items-center gap-1 text-sm font-medium text-link group-hover:text-link-hover">
              {external ? 'Visit' : 'Open'}
              <Icon name="tabler:arrow-up-right" class="h-4 w-4" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <CallToAction
    isDark
    classes={{
      container: 'max-w-4xl',
      actions: 'gap-3 sm:gap-4',
    }}
    actions={[
      {
        variant: 'primary',
        href: '/donate',
        text: 'Support Soranauts',
        icon: 'tabler:heart',
      },
      {
        variant: 'secondary',
        href: 'https://t.me/Soranauts',
        target: '_blank',
        text: 'Join the community',
        icon: 'tabler:brand-telegram',
      },
    ]}
  >
    <Fragment slot="title">
      Help keep this resource independent
    </Fragment>
    <Fragment slot="subtitle">
      Your support funds glossary expansion, Explorer improvements, and the infrastructure that keeps Soranauts accurate and up-to-date.
    </Fragment>
  </CallToAction>
</PageLayout>
