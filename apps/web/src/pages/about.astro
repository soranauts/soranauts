---
import PageLayout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Button from '~/components/ui/Button.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
// @ts-expect-error astro-icon ships runtime-only component typings
import { Icon } from 'astro-icon/components';
import type { MetaData } from '~/types';

const metadata: MetaData = {
  title: 'About Soranauts',
  description:
    'Soranauts is a public-good reference for the SORA ecosystem — clear, evidence-backed, and built for long-term stewardship.',
};

const principles = [
  {
    icon: 'tabler:eye',
    title: 'Clarity over hype',
    description: 'We explain what things are and how they work — no marketing spin, no breathless announcements.',
  },
  {
    icon: 'tabler:file-certificate',
    title: 'Evidence before claims',
    description: 'Every statement traces back to official sources, code, or verifiable on-chain data.',
  },
  {
    icon: 'tabler:scale',
    title: 'Neutral reference',
    description: 'We document the ecosystem as it is, not as anyone wishes it to be.',
  },
  {
    icon: 'tabler:clock-hour-4',
    title: 'Long-term stewardship',
    description: 'This resource is built to last — maintained, updated, and improved over years, not weeks.',
  },
  {
    icon: 'tabler:world',
    title: 'Public-good mindset',
    description: 'Soranauts exists to serve the community, not to extract from it.',
  },
  {
    icon: 'tabler:users-group',
    title: 'Open collaboration',
    description: 'Corrections, additions, and improvements from the community are welcomed and credited.',
  },
  {
    icon: 'tabler:adjustments-horizontal',
    title: 'Pragmatic transparency',
    description: 'We share how we work and why — without performative complexity.',
  },
  {
    icon: 'tabler:refresh',
    title: 'Continuous improvement',
    description: 'We iterate based on feedback and new information — nothing is set in stone.',
  },
  {
    icon: 'tabler:accessible',
    title: 'Accessible to all',
    description: 'Complex topics explained simply, so anyone can learn regardless of technical background.',
  },
];

const nonGoals = [
  {
    icon: 'tabler:chart-line',
    text: 'Soranauts is not a trading signal service — we do not offer investment advice or price predictions.',
  },
  {
    icon: 'tabler:speakerphone',
    text: 'Soranauts is not a hype engine — we do not amplify unverified rumors or speculative narratives.',
  },
  {
    icon: 'tabler:building-store',
    text: 'Soranauts is not vendor PR — we do not publish sponsored content or promotional material.',
  },
  {
    icon: 'tabler:shield-x',
    text: 'Soranauts is not a place for unverifiable claims — if it cannot be sourced, it does not belong here.',
  },
];
---

<PageLayout metadata={metadata}>
  <!-- SECTION 1: Mission Hero -->
  <section id="mission" class="relative overflow-hidden bg-page">
    <div class="absolute inset-0 -z-[1] bg-gradient-to-br from-brand-soft/70 via-transparent to-transparent" aria-hidden="true" />
    <div class="mx-auto flex max-w-4xl flex-col items-center gap-8 px-4 pb-16 pt-24 text-center md:px-6">
        <span class="inline-flex items-center gap-2 rounded-full border border-brand-soft bg-surface/80 px-4 py-1 text-xs font-semibold uppercase tracking-[0.35em] text-brand-600 shadow-sm">
        About
        </span>
      <h1 class="text-4xl font-bold leading-tight text-text-main md:text-5xl lg:text-6xl">
        A trustworthy reference for the SORA ecosystem.
        </h1>
      <p class="max-w-2xl text-lg text-text-muted md:text-xl">
        Soranauts exists to make SORA v3, Polkaswap, Kensetsu, and the Token Bonding Curve understandable for everyone — builders, researchers, and curious newcomers alike. We gather scattered information into one clear, verified, and enduring resource.
        </p>
      <div class="mt-4 grid gap-3 sm:flex sm:flex-wrap sm:justify-center sm:gap-4">
          <Button
            variant="primary"
          href="/explore"
          text="Explore the Knowledge Base"
          icon="tabler:compass"
          class="w-full justify-center sm:w-auto sm:min-w-[240px]"
          />
          <Button
            variant="secondary"
            href="https://t.me/Soranauts"
            target="_blank"
          text="Join the Community"
          icon="tabler:users"
          class="w-full justify-center sm:w-auto sm:min-w-[200px]"
        />
      </div>
    </div>
  </section>

  <!-- SECTION 2: Principles -->
  <WidgetWrapper id="principles" containerClass="max-w-5xl">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.35em] text-brand-500">Our Principles</p>
      <h2 class="mt-4 text-3xl font-bold text-text-main md:text-4xl">What guides us</h2>
      <p class="mt-4 text-lg text-text-muted">
        These values shape every decision we make about what to publish and how to present it.
      </p>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {principles.map(({ icon, title, description }) => (
        <div class="flex items-start gap-4 rounded-xl border border-border-subtle bg-surface/90 p-5">
          <Icon name={icon} class="mt-0.5 h-6 w-6 flex-shrink-0 text-brand-500" />
          <div>
            <p class="font-semibold text-text-main">{title}</p>
            <p class="mt-1 text-sm text-text-muted">{description}</p>
          </div>
        </div>
          ))}
        </div>
  </WidgetWrapper>

  <!-- SECTION 3: Why Soranauts Exists -->
  <section id="why" class="px-4 py-16 md:px-6 md:py-20">
    <div class="mx-auto max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.35em] text-brand-500">The Problem</p>
      <h2 class="mt-4 text-3xl font-bold text-text-main md:text-4xl">Why Soranauts exists</h2>
      <div class="mt-8 space-y-6 text-lg text-text-muted">
        <p>
          The SORA ecosystem is ambitious and fast-moving. SORA v3, Polkaswap, Kensetsu, the Token Bonding Curve, bridges, governance — each piece has its own documentation scattered across wikis, GitHub repos, Medium posts, and Telegram channels. Finding accurate, current information often means piecing together fragments from a dozen sources.
        </p>
        <p>
          Meanwhile, the broader crypto space is noisy. Hype cycles, speculation, and marketing blur the line between what's real and what's wishful thinking. For someone trying to understand how SORA actually works — or whether it's worth their time — separating signal from noise is exhausting.
        </p>
        <p>
          Soranauts is a response to both problems. We consolidate authoritative information into a single reference that's verified, kept current, and written for clarity. No hype, no spin — just a durable resource you can trust to still be accurate next month and next year.
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION 4: Methodology -->
  <WidgetWrapper id="methodology" containerClass="max-w-5xl" isDark bg={`<div class="absolute inset-0 bg-gradient-to-br from-brand-soft/20 via-transparent to-brand-soft/10"></div>`}>
    <div class="mx-auto max-w-3xl">
      <p class="text-center text-sm font-semibold uppercase tracking-[0.35em] text-brand-200">How We Work</p>
      <h2 class="mt-4 text-center text-3xl font-bold text-white md:text-4xl">How truth stays sturdy</h2>
      <div class="mt-10 space-y-6 text-lg text-text-soft">
        <p>
          Everything published on Soranauts traces back to official sources: the SORA wiki, Polkaswap documentation, Hyperledger Iroha specs, GitHub repositories, and on-chain data. When we cite something, you can verify it yourself.
        </p>
        <p>
          Our knowledge base runs nightly synchronization jobs that pull updates from upstream sources. Each sync is logged with timestamps and checksums so we can audit exactly when information arrived and whether it changed. Deterministic builds mean the same inputs always produce the same outputs — no hidden drift.
        </p>
        <p>
          Before anything goes live, automated checks catch broken links, outdated references, and formatting issues. Human review adds context and judgment. The result is a reference that earns trust through consistency, not claims.
      </p>
    </div>
    </div>
  </WidgetWrapper>

  <!-- SECTION 5: What Soranauts Is Not -->
  <section id="not" class="px-4 py-16 md:px-6 md:py-20">
    <div class="mx-auto max-w-4xl">
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.35em] text-brand-500">Non-Goals</p>
        <h2 class="mt-4 text-3xl font-bold text-text-main md:text-4xl">What Soranauts is not</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-text-muted">
          Clarity about what we don't do is as important as clarity about what we do.
        </p>
      </div>
      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        {nonGoals.map(({ icon, text }) => (
          <div class="flex items-start gap-4 rounded-xl border border-border-subtle bg-surface/90 p-5">
            <Icon name={icon} class="mt-0.5 h-6 w-6 flex-shrink-0 text-text-soft" />
            <p class="text-text-muted">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 6: Get Involved -->
  <WidgetWrapper id="involve" containerClass="max-w-4xl">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.35em] text-brand-500">Contribute</p>
      <h2 class="mt-4 text-3xl font-bold text-text-main md:text-4xl">Get involved</h2>
      <p class="mt-6 text-lg text-text-muted">
        Soranauts improves through community input. If you spot an error, know of a missing term, or have research that should be included, we want to hear from you. Suggestions, corrections, and pull requests are all welcome — every contribution makes the resource better for everyone.
      </p>
      <div class="mt-8 grid gap-3 sm:flex sm:flex-wrap sm:justify-center sm:gap-4">
        <Button
          variant="primary"
          href="/glossary"
          text="Browse the Glossary"
          icon="tabler:vocabulary"
          class="w-full justify-center sm:w-auto"
        />
        <Button
          variant="secondary"
          href="/features"
          text="Platform Features"
          icon="tabler:sparkles"
          class="w-full justify-center sm:w-auto"
        />
        <Button
          variant="tertiary"
          href="https://wiki.sora.org/"
          target="_blank"
          text="SORA Wiki"
          icon="tabler:external-link"
          class="w-full justify-center border-border-subtle text-text-muted hover:border-brand-500 hover:text-link sm:w-auto"
        />
        <Button
          variant="tertiary"
          href="https://t.me/Soranauts"
          target="_blank"
          text="Join the Community"
          icon="tabler:send"
          class="w-full justify-center border-border-subtle text-text-muted hover:border-brand-500 hover:text-link sm:w-auto"
        />
    </div>
    </div>
  </WidgetWrapper>

  <CallToAction
    isDark
    classes={{
      container: 'max-w-4xl',
      actions: 'gap-3 sm:gap-4 lg:gap-3 xl:gap-2.5 lg:max-w-xl xl:max-w-lg',
    }}
    actions={[
      {
        variant: 'primary',
        href: '/explore',
        text: 'Explore the Knowledge Base',
        icon: 'tabler:compass',
        class: 'md:px-5 md:py-2 lg:px-4 lg:py-1.5 lg:text-base lg:rounded-3xl xl:px-3.5 xl:py-1.5 xl:rounded-3xl',
      },
      {
        variant: 'secondary',
        href: 'https://t.me/Soranauts',
        target: '_blank',
        text: 'Join the Community',
        icon: 'tabler:users',
        class: 'md:px-5 md:py-2 lg:px-4 lg:py-1.5 lg:text-base lg:rounded-3xl xl:px-3.5 xl:py-1.5 xl:rounded-3xl',
      },
    ]}
  >
    <Fragment slot="title">
      A reference you can rely on.
    </Fragment>
    <Fragment slot="subtitle">
      Clear documentation, verified sources, and long-term maintenance — because the SORA ecosystem deserves a trustworthy guide.
    </Fragment>
  </CallToAction>
</PageLayout>
