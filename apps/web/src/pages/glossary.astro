---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import GlossarySearchFallback from '~/components/glossary/GlossarySearchFallback';
import { SITE } from '~/utils/config';
import { headerData, footerData } from '~/navigation';
import glossary from '../../public/glossary.json';

// Get initial term from URL hash for deep linking
const initialTerm = Astro.url.hash.replace('#', '');

// Generate DefinedTermSet schema for main glossary page
const definedTermSetSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "name": "SORA Glossary",
  "description": "Complete glossary of SORA ecosystem terms, definitions, and concepts. Learn about XOR, VAL, PSWAP, governance, DeFi, and more.",
  "url": `${SITE.site}/glossary`,
  "hasDefinedTerm": glossary.terms.map(term => ({
    "@type": "DefinedTerm",
    "name": term.term,
    "termCode": term.slug,
    "description": term.definition,
    "url": `${SITE.site}/glossary/${term.slug}`,
    "inDefinedTermSet": `${SITE.site}/glossary`,
    "alternateName": term.aliases ?? []
  }))
};

// Breadcrumb schema for glossary page
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": SITE.site
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "SORA Glossary",
      "item": `${SITE.site}/glossary`
    }
  ]
};
---

<Layout 
  metadata={{
    title: 'SORA Glossary | Comprehensive Guide to SORA Ecosystem Terms',
    description: 'Complete glossary of SORA ecosystem terms, definitions, and concepts. Learn about XOR, VAL, PSWAP, governance, DeFi, and more.',
    canonical: `${SITE.site}/glossary`,
    openGraph: {
      url: `${SITE.site}/glossary`,
      type: 'website',
      images: [{
        url: `${SITE.site}/og/glossary.jpg`,
        width: 1200,
        height: 630
      }]
    }
    }}
  >
    <!-- Preload glossary search index for faster search -->
    <link rel="preload" href="/glossary.index.json" as="fetch" type="application/json" crossorigin />
    
    <Header {...headerData} isSticky showRssFeed showToggleTheme />
  
  <main class="py-8 sm:py-16 lg:py-20">
    <div class="container mx-auto px-4 sm:px-6 max-w-6xl">
      <!-- Header Section -->
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading mb-6">
          SORA Glossary
        </h1>
        <p class="text-xl md:text-2xl text-muted dark:text-slate-400 max-w-3xl mx-auto">
          Your comprehensive guide to SORA ecosystem terms, concepts, and definitions. 
          Search, filter, and explore with our interactive glossary.
        </p>
      </div>

          <!-- Main Glossary Search Component -->
          <GlossarySearchFallback client:load />
    </div>
  </main>

  <Footer {...footerData} />
  
  <!-- Structured Data for SEO -->
  <script type="application/ld+json" set:html={JSON.stringify(definedTermSetSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Layout>
