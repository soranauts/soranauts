---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import { headerData, footerData } from '~/navigation';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Donate to Soranauts | Fuel SORA Research & Education',
  description: 'Support Soranauts, an independent knowledge hub for SORA, Soramitsu, and DeFi. Your donation sustains research, documentation, and governance tracking.',
  image: '/soranauts-social-share.jpg',
  url: '/donate'
};

const donationOptions = [
  {
    name: 'SORA Ecosystem',
    icon: '/sora-xor-logo.svg',
    iconType: 'image',
    description: 'XOR, VAL, PSWAP, and other SORA tokens sustain governance tracking and living documentation.',
    label: 'SORA Network Address',
    address: 'cnVcjvUEVGbK4LGLB9K382EEKm57dxtmGYdiFfnjEWWg9vr72',
    accent: 'brand',
  },
  {
    name: 'Bitcoin',
    icon: '/bitcoin-btc-logo.svg',
    iconType: 'image',
    description: 'Bitcoin contributions keep infrastructure, audits, and analytics tooling online.',
    label: 'BTC Address',
    address: 'BC1QHEN7QMF32E0NNEUSTXH4FUS5KG7KSAS94YT3NT',
    accent: 'warning',
  },
  {
    name: 'Ethereum',
    icon: 'tabler:currency-ethereum',
    iconType: 'icon',
    description: 'ETH and ERC-20 support community tooling and translations across our resources.',
    label: 'ETH Address',
    address: '0xfdF182784C748439F20645eE74932960f17d7f98',
    accent: 'info',
  },
];

const impactItems = [
  {
    icon: 'tabler:book-2',
    title: 'Deep-dive Explainers',
    description: 'Neutral walkthroughs of SORA mechanics, Polkaswap flows, and policy context.',
  },
  {
    icon: 'tabler:vocabulary',
    title: 'Glossary Verification',
    description: 'Continuous review of terminology, risk disclosures, and protocol updates.',
  },
  {
    icon: 'tabler:bolt',
    title: 'Faster Search & Tooling',
    description: 'Performance tuning, infrastructure, and data pipelines for reliable discovery.',
  },
  {
    icon: 'tabler:heart-handshake',
    title: 'Community Research',
    description: 'Collaborations that surface governance insights and multilingual resources.',
  },
];

const supportLinks = [
  {
    href: 'https://t.me/Soranauts',
    icon: 'tabler:brand-telegram',
    label: 'Join Telegram',
    sublabel: 'Community & Feedback',
    external: true,
    primary: true,
  },
  {
    href: 'https://twitter.com/soranauts',
    icon: 'tabler:brand-x',
    label: 'Follow on X',
    sublabel: 'Boost Updates',
    external: true,
  },
  {
    href: '/blog',
    icon: 'tabler:news',
    label: 'Read the Blog',
    sublabel: 'Learn & Share',
  },
  {
    href: 'https://wiki.sora.org/',
    icon: 'tabler:external-link',
    label: 'SORA Wiki',
    sublabel: 'Official Docs',
    external: true,
  },
];
---

<Layout metadata={metadata}>
  <Header {...headerData} isSticky showRssFeed showToggleTheme />
  <main id="main-content" class="min-h-screen bg-page text-text-main">
    <!-- Hero Section -->
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 -z-[1] bg-gradient-to-br from-brand-soft/50 via-transparent to-transparent" aria-hidden="true" />
      <div class="mx-auto max-w-4xl px-4 py-20 text-center md:px-6">
        <span class="inline-flex items-center gap-2 rounded-full border border-brand-soft bg-surface/80 px-4 py-1 text-xs font-semibold uppercase tracking-[0.35em] text-brand-600 shadow-sm">
          Support
        </span>
        <h1 class="mt-6 text-4xl font-bold leading-tight text-text-main md:text-5xl">
          Fuel independent SORA research
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-text-muted">
          Soranauts documents the SORA ecosystem with neutral analysis and open documentation. Your donation powers original research, governance tracking, and community resources.
        </p>
      </div>
    </section>

    <!-- Donation Options -->
    <section class="px-4 pb-16 md:px-6">
      <div class="mx-auto max-w-5xl">
        <div class="grid gap-6 md:grid-cols-3">
          {donationOptions.map((option) => (
            <div class="group relative flex flex-col overflow-hidden rounded-2xl border border-border-subtle bg-surface shadow-sm transition hover:border-brand-500/50 hover:shadow-elevated">
              <div class="flex flex-col items-center gap-4 p-6 text-center">
                <div class:list={[
                  "flex h-14 w-14 items-center justify-center rounded-full transition group-hover:scale-110",
                  option.accent === 'brand' && "bg-brand-soft text-brand-500",
                  option.accent === 'warning' && "bg-status-warning/10 text-status-warning",
                  option.accent === 'info' && "bg-status-info/10 text-status-info",
                ]}>
                  {option.iconType === 'image' ? (
                    <img src={option.icon} alt={`${option.name} logo`} class="h-7 w-7" />
                  ) : (
                    <Icon name={option.icon} class="h-7 w-7" />
                  )}
                </div>
                <h3 class="text-lg font-semibold text-text-main">{option.name}</h3>
                <p class="text-sm text-text-muted">{option.description}</p>
              </div>
              <div class="mt-auto border-t border-border-subtle bg-soft/50 p-4">
                <p class="mb-2 text-xs font-medium uppercase tracking-wide text-text-soft">{option.label}</p>
                <div class="group/copy relative">
                  <code class="block break-all rounded-lg bg-page/80 px-3 py-2 text-xs text-text-muted font-mono">
                    {option.address}
                  </code>
                  <button 
                    type="button"
                    class="absolute right-2 top-1/2 -translate-y-1/2 rounded-md p-1.5 text-text-soft opacity-0 transition hover:bg-surface hover:text-brand-500 group-hover/copy:opacity-100"
                    data-copy={option.address}
                    aria-label={`Copy ${option.name} address`}
                  >
                    <Icon name="tabler:copy" class="h-4 w-4" />
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- What Your Support Enables -->
    <section class="px-4 py-16 md:px-6">
      <div class="mx-auto max-w-5xl">
        <div class="rounded-2xl border border-border-subtle bg-surface/50 p-8 md:p-10">
          <h2 class="mb-8 text-center text-2xl font-bold text-text-main">
            What your support enables
          </h2>
          <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
            {impactItems.map((item) => (
              <div class="flex flex-col items-center gap-3 text-center">
                <div class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-soft text-brand-500">
                  <Icon name={item.icon} class="h-6 w-6" />
                </div>
                <h3 class="font-semibold text-text-main">{item.title}</h3>
                <p class="text-sm text-text-muted leading-relaxed">{item.description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Other Ways to Support -->
    <section class="px-4 py-16 md:px-6">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="mb-8 text-2xl font-bold text-text-main">
          Other ways to support
        </h2>
        <div class="grid gap-3 sm:grid-cols-2">
          {supportLinks.map((link) => (
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              class:list={[
                "group flex items-center gap-4 rounded-xl border p-4 transition",
                link.primary 
                  ? "border-brand-500/30 bg-brand-soft/20 hover:border-brand-500 hover:bg-brand-soft/40" 
                  : "border-border-subtle bg-surface hover:border-brand-500/50 hover:bg-surface/80",
              ]}
            >
              <div class:list={[
                "flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-full transition",
                link.primary 
                  ? "bg-brand-500 text-white group-hover:scale-110" 
                  : "bg-soft text-text-muted group-hover:bg-brand-soft group-hover:text-brand-500",
              ]}>
                <Icon name={link.icon} class="h-5 w-5" />
              </div>
              <div class="text-left">
                <p class:list={[
                  "font-semibold",
                  link.primary ? "text-brand-500" : "text-text-main",
                ]}>{link.label}</p>
                <p class="text-sm text-text-muted">{link.sublabel}</p>
              </div>
              {link.external && (
                <Icon name="tabler:external-link" class="ml-auto h-4 w-4 text-text-soft" />
              )}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Thank You Message -->
    <section class="px-4 pb-20 md:px-6">
      <div class="mx-auto max-w-3xl">
        <div class="relative overflow-hidden rounded-2xl border border-brand-500/30 bg-gradient-to-br from-brand-soft/40 via-brand-soft/20 to-transparent p-8 text-center md:p-10">
          <div class="absolute -right-8 -top-8 h-32 w-32 rounded-full bg-brand-500/10 blur-3xl" aria-hidden="true" />
          <div class="absolute -bottom-8 -left-8 h-32 w-32 rounded-full bg-brand-500/10 blur-3xl" aria-hidden="true" />
          <div class="relative">
            <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-brand-soft text-brand-500">
              <Icon name="tabler:heart" class="h-7 w-7" />
            </div>
            <h3 class="text-2xl font-bold text-text-main">
              Thank you for backing independent SORA knowledge
            </h3>
            <p class="mx-auto mt-4 max-w-xl text-text-muted">
              Your contribution keeps Soranauts transparent, independent, and focused on education. Donations fund research, documentation, and community tooling — not speculation.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer {...footerData} />
</Layout>

<script>
  // Copy to clipboard functionality
  document.querySelectorAll('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      const text = button.getAttribute('data-copy');
      if (text) {
        await navigator.clipboard.writeText(text);
        const icon = button.querySelector('svg');
        if (icon) {
          icon.style.color = 'var(--color-status-success)';
          setTimeout(() => {
            icon.style.color = '';
          }, 1500);
        }
      }
    });
  });
</script>
