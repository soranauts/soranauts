---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import { headerData, footerData } from '~/navigation';

const metadata = {
  title: 'Support Soranauts | Donate to Help Build the SORA Ecosystem',
  description: 'Support Soranauts in creating educational content about SORA, Polkaswap, and DeFi innovation. Help us build a better understanding of decentralized finance.',
  image: '/soranauts-social-share.jpg',
  url: '/donate'
};
---

<Layout metadata={metadata}>
  <Header {...headerData} isSticky showRssFeed showToggleTheme />
  <main class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-900 dark:to-gray-800">
    <div class="container mx-auto px-4 py-16">
      <!-- Hero Section -->
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6">
          Support Soranauts
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
          Help us create educational content about SORA, Polkaswap, and the future of decentralized finance. 
          Your support enables us to build better resources for the community.
        </p>
      </div>

      <!-- Donation Options -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        <!-- SORA Ecosystem Donations -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-8 border border-gray-200 dark:border-gray-700">
          <div class="text-center">
            <div class="w-16 h-16 bg-red-100 dark:bg-red-900/20 rounded-full flex items-center justify-center mx-auto mb-6">
              <img src="/sora-xor-logo.svg" alt="SORA Logo" class="w-8 h-8" />
            </div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">SORA Ecosystem</h3>
            <p class="text-gray-600 dark:text-gray-300 mb-6">
              Support us with SORA ecosystem tokens to help build educational content.
            </p>
            <div class="bg-gray-50 dark:bg-gray-700 p-3 rounded-lg">
              <p class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">SORA Network Address</p>
              <p class="text-sm text-gray-600 dark:text-gray-400 font-mono break-all">
                cnVcjvUEVGbK4LGLB9K382EEKm57dxtmGYdiFfnjEWWg9vr72
              </p>
            </div>
          </div>
        </div>

        <!-- Bitcoin Donations -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-8 border border-gray-200 dark:border-gray-700">
          <div class="text-center">
            <div class="w-16 h-16 bg-orange-100 dark:bg-orange-900/20 rounded-full flex items-center justify-center mx-auto mb-6">
              <img src="/bitcoin-btc-logo.svg" alt="Bitcoin Logo" class="w-8 h-8" />
            </div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Bitcoin</h3>
            <p class="text-gray-600 dark:text-gray-300 mb-6">
              Support us with Bitcoin to help fund server costs and development tools.
            </p>
            <div class="bg-gray-50 dark:bg-gray-700 p-3 rounded-lg">
              <p class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">BTC Address</p>
              <p class="text-sm text-gray-600 dark:text-gray-400 font-mono break-all">
                BC1QHEN7QMF32E0NNEUSTXH4FUS5KG7KSAS94YT3NT
              </p>
            </div>
          </div>
        </div>

        <!-- Ethereum Donations -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-8 border border-gray-200 dark:border-gray-700">
          <div class="text-center">
            <div class="w-16 h-16 bg-blue-100 dark:bg-blue-900/20 rounded-full flex items-center justify-center mx-auto mb-6">
              <svg class="w-8 h-8 text-blue-600 dark:text-blue-400" fill="currentColor" viewBox="0 0 24 24">
                <path d="M11.944 17.97L4.58 13.62 11.943 24l7.37-10.38-7.372 4.35h.003zM12.056 0L4.69 12.223l7.365 4.354 7.365-4.35L12.056 0z"/>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Ethereum</h3>
            <p class="text-gray-600 dark:text-gray-300 mb-6">
              Support us with ETH or ERC-20 tokens to help maintain and improve our platform.
            </p>
            <div class="bg-gray-50 dark:bg-gray-700 p-3 rounded-lg">
              <p class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">ETH Address</p>
              <p class="text-sm text-gray-600 dark:text-gray-400 font-mono break-all">
                0xfdF182784C748439F20645eE74932960f17d7f98
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- What Your Support Enables -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-8 mb-16 border border-gray-200 dark:border-gray-700">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-8 text-center">
          What Your Support Enables
        </h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="text-center">
            <div class="w-12 h-12 bg-green-100 dark:bg-green-900/20 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Educational Content</h3>
            <p class="text-sm text-gray-600 dark:text-gray-300">In-depth articles and guides about SORA and DeFi</p>
          </div>
          <div class="text-center">
            <div class="w-12 h-12 bg-purple-100 dark:bg-purple-900/20 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Glossary & Resources</h3>
            <p class="text-sm text-gray-600 dark:text-gray-300">Comprehensive SORA ecosystem terminology and tools</p>
          </div>
          <div class="text-center">
            <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900/20 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Fast Performance</h3>
            <p class="text-sm text-gray-600 dark:text-gray-300">Optimized hosting and infrastructure for better user experience</p>
          </div>
          <div class="text-center">
            <div class="w-12 h-12 bg-red-100 dark:bg-red-900/20 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Community Building</h3>
            <p class="text-sm text-gray-600 dark:text-gray-300">Supporting the growth of the SORA community</p>
          </div>
        </div>
      </div>

      <!-- Alternative Support Methods -->
      <div class="text-center">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">
          Other Ways to Support
        </h2>
        <div class="flex flex-wrap justify-center gap-4">
          <a 
            href="https://github.com/soranauts" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center px-6 py-3 bg-gray-900 dark:bg-gray-700 text-white rounded-lg hover:bg-gray-800 dark:hover:bg-gray-600 transition-colors"
          >
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            Contribute on GitHub
          </a>
          <a 
            href="https://twitter.com/soranauts" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center px-6 py-3 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-colors"
          >
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
            </svg>
            Follow on Twitter
          </a>
          <a 
            href="/blog" 
            class="inline-flex items-center px-6 py-3 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            Read Our Content
          </a>
        </div>
      </div>

      <!-- Thank You Message -->
      <div class="mt-16 text-center">
        <div class="bg-gradient-to-r from-red-50 to-red-100 dark:from-red-900/20 dark:to-red-800/20 rounded-lg p-8 border border-red-200 dark:border-red-700">
          <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
            Thank You for Your Support! 🙏
          </h3>
          <p class="text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
            Every contribution, no matter how small, helps us continue building educational resources for the SORA community. 
            Your support enables us to create better content, improve our platform, and help more people understand the power of decentralized finance.
          </p>
        </div>
      </div>
    </div>
  </main>
  <Footer {...footerData} />
</Layout>
