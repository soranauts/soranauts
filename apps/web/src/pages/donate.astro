---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import { headerData, footerData } from '~/navigation';

const metadata = {
  title: 'Support Soranauts | Donate to Help Build the SORA Ecosystem',
  description: 'Support Soranauts in creating educational content about SORA, Polkaswap, and DeFi innovation. Help us build a better understanding of decentralized finance.',
  image: '/soranauts-social-share.jpg',
  url: '/donate'
};
---

<Layout metadata={metadata}>
  <Header {...headerData} isSticky showRssFeed showToggleTheme />
  <main class="min-h-screen bg-page text-text-main">
    <div class="container mx-auto px-4 py-16 space-y-16">
      <!-- Hero Section -->
      <div class="text-center space-y-4">
        <h1 class="text-4xl md:text-5xl font-bold text-text-main">
          Support Soranauts
        </h1>
        <p class="text-xl text-text-muted max-w-3xl mx-auto">
          Help us create educational content about SORA, Polkaswap, and the future of decentralized finance. 
          Your support enables us to build better resources for the community.
        </p>
      </div>

      <!-- Donation Options -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch">
        <!-- SORA Ecosystem Donations -->
        <div class="bg-surface border border-border-subtle rounded-xl shadow-elevated p-8 flex flex-col">
          <div class="flex flex-col items-center text-center gap-6 flex-1 w-full">
            <div class="w-16 h-16 rounded-full flex items-center justify-center bg-brand-soft text-brand-500">
              <img src="/sora-xor-logo.svg" alt="SORA Logo" class="w-8 h-8" />
            </div>
            <h3 class="text-xl font-semibold text-text-main">SORA Ecosystem</h3>
            <p class="text-text-muted">
              Support us with SORA ecosystem tokens to help build educational content.
            </p>
            <div class="mt-auto w-full rounded-lg border border-border-subtle bg-soft p-3 text-left space-y-2">
              <p class="text-sm font-medium text-text-main">SORA Network Address</p>
              <p class="text-sm text-text-muted font-mono break-all">
                cnVcjvUEVGbK4LGLB9K382EEKm57dxtmGYdiFfnjEWWg9vr72
              </p>
            </div>
          </div>
        </div>

        <!-- Bitcoin Donations -->
        <div class="bg-surface border border-border-subtle rounded-xl shadow-elevated p-8 flex flex-col">
          <div class="flex flex-col items-center text-center gap-6 flex-1 w-full">
            <div class="w-16 h-16 rounded-full flex items-center justify-center bg-soft text-status-warning">
              <img src="/bitcoin-btc-logo.svg" alt="Bitcoin Logo" class="w-8 h-8" />
            </div>
            <h3 class="text-xl font-semibold text-text-main">Bitcoin</h3>
            <p class="text-text-muted">
              Support us with Bitcoin to help fund server costs and development tools.
            </p>
            <div class="mt-auto w-full rounded-lg border border-border-subtle bg-soft p-3 text-left space-y-2">
              <p class="text-sm font-medium text-text-main">BTC Address</p>
              <p class="text-sm text-text-muted font-mono break-all">
                BC1QHEN7QMF32E0NNEUSTXH4FUS5KG7KSAS94YT3NT
              </p>
            </div>
          </div>
        </div>

        <!-- Ethereum Donations -->
        <div class="bg-surface border border-border-subtle rounded-xl shadow-elevated p-8 flex flex-col">
          <div class="flex flex-col items-center text-center gap-6 flex-1 w-full">
            <div class="w-16 h-16 rounded-full flex items-center justify-center bg-soft text-status-info">
              <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
                <path d="M11.944 17.97L4.58 13.62 11.943 24l7.37-10.38-7.372 4.35h.003zM12.056 0L4.69 12.223l7.365 4.354 7.365-4.35L12.056 0z"/>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-text-main">Ethereum</h3>
            <p class="text-text-muted">
              Support us with ETH or ERC-20 tokens to help maintain and improve our platform.
            </p>
            <div class="mt-auto w-full rounded-lg border border-border-subtle bg-soft p-3 text-left space-y-2">
              <p class="text-sm font-medium text-text-main">ETH Address</p>
              <p class="text-sm text-text-muted font-mono break-all">
                0xfdF182784C748439F20645eE74932960f17d7f98
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- What Your Support Enables -->
      <div class="bg-surface border border-border-subtle rounded-xl shadow-elevated p-8 space-y-8">
        <h2 class="text-2xl font-bold text-text-main text-center">
          What Your Support Enables
        </h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 text-center">
          <div class="space-y-4">
            <div class="w-12 h-12 mx-auto rounded-full flex items-center justify-center bg-soft text-status-success">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <h3 class="font-semibold text-text-main">Educational Content</h3>
            <p class="text-sm text-text-muted">In-depth articles and guides about SORA and DeFi</p>
          </div>
          <div class="space-y-4">
            <div class="w-12 h-12 mx-auto rounded-full flex items-center justify-center bg-soft text-brand-500">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <h3 class="font-semibold text-text-main">Glossary & Resources</h3>
            <p class="text-sm text-text-muted">Comprehensive SORA ecosystem terminology and tools</p>
          </div>
          <div class="space-y-4">
            <div class="w-12 h-12 mx-auto rounded-full flex items-center justify-center bg-soft text-status-info">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="font-semibold text-text-main">Fast Performance</h3>
            <p class="text-sm text-text-muted">Optimized hosting and infrastructure for better user experience</p>
          </div>
          <div class="space-y-4">
            <div class="w-12 h-12 mx-auto rounded-full flex items-center justify-center bg-brand-soft text-brand-500">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <h3 class="font-semibold text-text-main">Community Building</h3>
            <p class="text-sm text-text-muted">Supporting the growth of the SORA community</p>
          </div>
        </div>
      </div>

      <!-- Alternative Support Methods -->
      <div class="text-center space-y-6">
        <h2 class="text-2xl font-bold text-text-main">
          Other Ways to Support
        </h2>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="https://t.me/Soranauts"
            target="_blank"
            rel="noopener noreferrer"
            class="btn gap-3 bg-soft text-text-muted hover:text-link focus-visible:text-link w-full max-w-xs sm:max-w-none sm:w-auto"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M22 2.01c-.5-.02-1 .04-1.43.27l-16.17 7c-1.11.43-1.09 1.07-.21 1.34l4.28 1.34 9.97-6.29c.47-.3.9-.14.55.2l-7.63 7.4-.26 4.14c.37.01.53-.17.73-.37l1.75-1.7 4.13 2.96c.76.41 1.24.2 1.41-.69l2.56-15.51c.23-1.28-.6-1.82-1.57-1.84z"/>
            </svg>
            Join on Telegram
          </a>
          <a
            href="https://twitter.com/soranauts"
            target="_blank"
            rel="noopener noreferrer"
            class="btn gap-3 bg-soft text-text-muted hover:text-link focus-visible:text-link w-full max-w-xs sm:max-w-none sm:w-auto"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
            </svg>
            Follow on X (Twitter)
          </a>
          <a 
            href="/blog" 
            class="btn-primary gap-2 w-full max-w-xs sm:max-w-none sm:w-auto"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            Read Our Content
          </a>
          <a
            href="https://github.com/soranauts"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary gap-2 w-full max-w-xs sm:max-w-none sm:w-auto"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-.189-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            <span>Follow on GitHub</span>
          </a>
        </div>
      </div>

      <!-- Thank You Message -->
      <div class="text-center">
        <div class="rounded-xl border border-brand-soft bg-brand-soft p-8 space-y-4">
          <h3 class="text-2xl font-bold text-text-main">
            Thank You for Your Support! 🙏
          </h3>
          <p class="text-text-muted max-w-2xl mx-auto">
            Every contribution, no matter how small, helps us continue building educational resources for the SORA community. 
            Your support enables us to create better content, improve our platform, and help more people understand the power of decentralized finance.
          </p>
        </div>
      </div>
    </div>
  </main>
  <Footer {...footerData} />
</Layout>
