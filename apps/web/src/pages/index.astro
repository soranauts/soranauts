---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Button from '~/components/ui/Button.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'SORA v3 (Nexus) — DeFi Economy & Polkaswap | Soranauts',
  description:
    'SORA v3 (Nexus) delivers deterministic execution, predictable liquidity, and accountable governance. Explore the glossary, browse the knowledge base, or launch Polkaswap.',
  ignoreTitleTemplate: true,
};

const quickLinks = [
  {
    icon: 'tabler:vocabulary',
    title: 'SORA Glossary',
    description: '384 terms across 18 categories — from XOR tokenomics to Nexus architecture.',
    href: '/glossary',
    cta: 'Browse terms',
  },
  {
    icon: 'tabler:compass',
    title: 'SORA Explorer',
    description: 'Navigate six domain dashboards with curated journeys and trait filters.',
    href: '/explore',
    cta: 'Start exploring',
  },
  {
    icon: 'tabler:book-2',
    title: 'SORA Codex',
    description: '24 curated documentation pages covering fundamentals, products, and technical specs.',
    href: '/docs',
    cta: 'Read the docs',
  },
  {
    icon: 'tabler:file-text',
    title: 'Nexus Whitepaper',
    description: 'The authoritative reference for execution lanes, governance, and liquidity.',
    href: '/documents/sora_nexus_whitepaper.pdf',
    cta: 'Download PDF',
    external: true,
  },
];

const nexusHighlights = [
  {
    eyebrow: 'Architecture',
    title: 'Lanes, Merge Ledger & Data Spaces',
    summary: 'Sections 6–7 explain how Nexus scales with parallel lanes while the merge ledger keeps one canonical order across sovereign data spaces.',
    points: [
      'Lanes finalize independently and fuse or split deterministically based on load.',
      'Merge ledger orders lane tips without rewriting finalized history.',
      'Data spaces provide privacy and jurisdictional controls while still emitting proofs.',
    ],
    source: {
      href: '/documents/sora_nexus_whitepaper.pdf',
      label: 'Whitepaper §§6–7 — Architecture & Data Spaces',
      description: 'PDF: Component roles, data-space governance, lane/merge design.',
    },
  },
  {
    eyebrow: 'Execution',
    title: 'IVM, Kotodama & Deterministic Contracts',
    summary: 'Sections 5 and 11 detail the Iroha Virtual Machine and Kotodama bytecode that keep Nexus execution deterministic.',
    points: [
      'Pointer-ABI defines typed handles so contracts cannot craft malformed references.',
      'Gas tables and syscalls are versioned on-chain for predictable execution.',
      'Kotodama bytecode (.to) plus Norito serialization keeps auditing and ZK tracing straightforward.',
    ],
    source: {
      href: '/documents/sora_nexus_whitepaper.pdf',
      label: 'Whitepaper §§5 & 11 — IVM & Smart Contracts',
      description: 'PDF: Kotodama runtime, pointer ABI, syscalls, gas, and execution model.',
    },
  },
  {
    eyebrow: 'Security & DA',
    title: 'FASTPQ Proofs, DA Sampling & Sumeragi',
    summary: 'Sections 8–10 describe the Sumeragi pipeline, Start-Time Fair Queuing, and FASTPQ zk-STARK proofs tied to DA certificates.',
    points: [
      'Sumeragi finalizes non-empty slots in ~1 s with deterministic leader rotation.',
      'FASTPQ proofs aggregate per-data-space execution into verifiable lane receipts.',
      'Two-dimensional erasure coding plus DA sampling keeps data recoverable and auditable.',
    ],
    source: {
      href: '/documents/sora_nexus_whitepaper.pdf',
      label: 'Whitepaper §§8–10 — Consensus, Proofs & DA',
      description: 'PDF: Consensus pipeline, fairness budgets, proof system, DA certificates.',
    },
  },
  {
    eyebrow: 'Governance',
    title: 'SORA Parliament & Governance Surfaces',
    summary: 'Sections 7.2 and 16 outline configuration surfaces, data-space onboarding, and the upcoming SORA Parliament structure.',
    points: [
      'Council, Assembly, and Technical Committee publish Norito manifests with XOR bonds.',
      'Parameter sets (crypto, scheduling, admission caps) are versioned on-chain.',
      'New data spaces require attested certificates; unknown DSIDs are rejected.',
    ],
    source: {
      href: '/documents/sora_nexus_whitepaper.pdf',
      label: 'Whitepaper §§7.2 & 16 — Governance Surfaces & Parliament',
      description: 'PDF: Governance bodies, manifests, bonds, and upgrade flow.',
    },
  },
];

const primitives = [
  {
    eyebrow: 'Execution',
    icon: 'tabler:git-merge',
    title: 'Lanes & Merge Ledger',
    description: 'Iroha v3 lanes finalize independently, then the merge ledger weaves those tips into one canonical order so builders never fork history.',
    href: '/documents/sora_nexus_whitepaper.pdf',
    cta: 'Architecture overview',
  },
  {
    eyebrow: 'Monetary Policy',
    icon: 'tabler:chart-line',
    title: 'XOR Bonding Curve',
    description: 'The bonding curve keeps XOR supply elastic and signals mint/burn windows so desks can dial liquidity without surprises.',
    href: 'https://wiki.sora.org/tbc.html',
    cta: 'Bonding curve model',
    external: true,
  },
  {
    eyebrow: 'Governance',
    icon: 'tabler:scale',
    title: 'SORA Parliament',
    description: 'Council, Assembly, and Technical Committee publish Norito manifests with XOR bonds so upgrades activate deterministically.',
    href: 'https://wiki.sora.org/sora-governance.html',
    cta: 'Governance plan',
    external: true,
  },
  {
    eyebrow: 'Liquidity',
    icon: 'tabler:arrows-exchange',
    title: 'Polkaswap & HASHI',
    description: 'Polkaswap routes liquidity across HASHI-connected domains while XOR operates as supranational money.',
    href: 'https://wiki.sora.org/polkaswap.html',
    cta: 'Polkaswap rails',
    external: true,
  },
];

const nexusFaqs = [
  {
    question: 'How do Nexus lanes reach ~1 second finality?',
    answer:
      'Sections 6–8 of the <a href="/documents/sora_nexus_whitepaper.pdf" class="text-brand-500 hover:underline">Nexus whitepaper</a> explain how parallel lanes execute in isolation while the merge ledger orders lane tips into one canonical sequence. The Sumeragi pipeline plus Start-Time Fair Queuing (STFQ) keeps every lane deterministic.',
  },
  {
    question: 'What are data spaces and why do they matter?',
    answer:
      'Nexus treats each jurisdiction or business unit as a sovereign data space with its own policy, privacy settings, and audit proofs. Governed onboarding ensures private zones stay private while still emitting proofs to the merge ledger. See §7 of the whitepaper or the <a href="/glossary/dataspaces" class="text-brand-500 hover:underline">glossary entry</a>.',
  },
  {
    question: 'How is liquidity policy enforced across SORA?',
    answer:
      'The <a href="/glossary/tokenbondingcurve" class="text-brand-500 hover:underline">XOR Token Bonding Curve</a> keeps supply elastic and signals mint/burn windows so desks can schedule liquidity programs. Nexus lanes read the same bonding-curve state, meaning Polkaswap LPs and Kensetsu vaults all follow the same deterministic policy.',
  },
  {
    question: 'Where can I learn SORA terminology?',
    answer:
      'The <a href="/glossary" class="text-brand-500 hover:underline">SORA Glossary</a> contains 384 terms across 18 categories — from XOR and VAL tokenomics to Nexus architecture concepts like lanes, data spaces, and the merge ledger. Use the search or filter by category.',
  },
];

const onboardSteps = [
  {
    icon: 'tabler:vocabulary',
    title: 'Learn the terminology',
    copy: 'Start with the <a href="/glossary" class="text-brand-500 hover:underline">SORA Glossary</a> to understand XOR, VAL, PSWAP, the Token Bonding Curve, and Nexus architecture concepts.',
  },
  {
    icon: 'tabler:wallet',
    title: 'Connect your wallet',
    copy: 'Use <a href="https://wiki.sora.org/polkaswap-connect-wallet.html" class="text-brand-500 hover:underline" target="_blank" rel="noopener noreferrer">Polkaswap wallet guides</a> or install <a href="https://fearlesswallet.io" class="text-brand-500 hover:underline" target="_blank" rel="noopener noreferrer">Fearless Wallet</a> to manage XOR, VAL, and KUSD.',
  },
  {
    icon: 'tabler:compass',
    title: 'Explore the ecosystem',
    copy: 'Browse the <a href="/explore" class="text-brand-500 hover:underline">SORA Explorer</a> to navigate governance, DeFi, economics, and technology topics with curated journeys.',
  },
  {
    icon: 'tabler:users',
    title: 'Join the community',
    copy: 'Jump into <a href="https://t.me/sora_xor" class="text-brand-500 hover:underline" target="_blank" rel="noopener noreferrer">Telegram</a>, follow progress on <a href="https://x.com/sora_xor" class="text-brand-500 hover:underline" target="_blank" rel="noopener noreferrer">X</a>, and track proposals via <a href="https://wiki.sora.org/sora-governance.html" class="text-brand-500 hover:underline" target="_blank" rel="noopener noreferrer">governance updates</a>.',
  },
];
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Browse the Glossary',
        href: '/glossary',
        size: 'md',
        icon: 'tabler:vocabulary',
      },
      {
        variant: 'secondary',
        text: 'Launch Polkaswap',
        href: 'https://polkaswap.io/',
        target: '_blank',
        size: 'md',
        icon: 'tabler:external-link',
        rel: 'noopener noreferrer',
      },
      {
        variant: 'tertiary',
        text: 'Read Whitepaper',
        href: '/documents/sora_nexus_whitepaper.pdf',
        target: '_blank',
        size: 'md',
        icon: 'tabler:file-text',
      },
    ]}
  >
    <Fragment slot="tagline">
      SORA v3 (Nexus)
    </Fragment>

    <Fragment slot="title">
      Your guide to the SORA decentralized economy.
    </Fragment>

    <Fragment slot="subtitle">
      Soranauts is an independent knowledge base covering SORA v3 (Nexus), Polkaswap, and the Token Bonding Curve. 
      Explore 384 glossary terms, 24 documentation pages, and stay current with ecosystem developments.
    </Fragment>
  </Hero>

  <!-- Hero Image -->
  <figure class="mx-auto mt-10 max-w-6xl px-4 text-center sm:px-6">
    <img
      src="/nexus-spectral-seal.jpg"
      alt="SORA emblem surrounded by blue and red Nexus particles"
      loading="lazy"
      decoding="async"
      class="mx-auto w-full rounded-3xl shadow-lg"
    />
  </figure>

  <!-- Quick Links Section (NEW) -->
  <section class="mx-auto mt-16 max-w-6xl px-4 sm:px-6">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {quickLinks.map(({ icon, title, description, href, cta, external }) => (
        <a
          href={href}
          target={external ? '_blank' : undefined}
          rel={external ? 'noopener noreferrer' : undefined}
          class="group flex flex-col gap-4 rounded-2xl border border-border-subtle bg-surface p-5 shadow-sm transition hover:-translate-y-1 hover:border-brand-500 hover:shadow-elevated"
        >
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-soft text-brand-500 transition group-hover:bg-brand-500 group-hover:text-white">
            <Icon name={icon} class="h-6 w-6" />
          </div>
          <div class="flex-1">
            <h3 class="font-semibold text-text-main">{title}</h3>
            <p class="mt-1 text-sm text-text-muted">{description}</p>
          </div>
          <span class="inline-flex items-center gap-1 text-sm font-medium text-brand-500 group-hover:text-brand-400">
            {cta}
            <Icon name={external ? 'tabler:external-link' : 'tabler:arrow-right'} class="h-4 w-4" />
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Whitepaper Highlights Section -->
  <section id="features" class="mx-auto mt-20 max-w-6xl px-4 sm:px-6">
    <div class="text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.35em] text-brand-500">Whitepaper Highlights</p>
      <h2 class="mt-4 text-3xl font-bold text-text-main md:text-4xl">What the Nexus whitepaper covers.</h2>
      <p class="mx-auto mt-3 max-w-3xl text-base text-text-muted">
        Execution lanes, predictable liquidity, governance cadence, and programmatic guardrails — the building blocks of the SORA v3 economy.
      </p>
    </div>
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {nexusHighlights.map(({ eyebrow, title, summary, points, source }) => (
        <article class="flex h-full flex-col rounded-2xl border border-border-subtle bg-surface p-6 shadow-sm transition hover:border-brand-500/30">
          <p class="text-xs font-semibold uppercase tracking-[0.35em] text-brand-500">{eyebrow}</p>
          <h3 class="mt-3 text-xl font-semibold text-text-main">{title}</h3>
          {summary && <p class="mt-3 text-sm text-text-muted">{summary}</p>}
          {points && (
            <ul class="mt-4 flex-1 space-y-2 text-sm text-text-muted">
              {points.map((point) => (
                <li class="flex gap-2">
                  <span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-brand-500" />
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          )}
          {source && (
            <p class="mt-4 border-t border-border-subtle pt-4 text-xs text-text-muted">
              Source:{' '}
              <a href={source.href} class="text-brand-500 hover:text-brand-400 underline decoration-dotted" target="_blank" rel="noopener noreferrer">
                {source.label}
              </a>
            </p>
          )}
        </article>
      ))}
    </div>
  </section>

  <!-- Whitepaper Access Banner -->
  <section class="relative mt-20 px-4 sm:px-6">
    <div class="mx-auto max-w-5xl overflow-hidden rounded-2xl border border-brand-500/30 bg-gradient-to-br from-[#1b2430] to-[#0f1419] p-8 text-center shadow-lg sm:p-10">
      <div class="absolute inset-0 -z-[1] bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-brand-500/10 via-transparent to-transparent" />
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-brand-400">
        Nexus Whitepaper
      </p>
      <h2 class="mt-4 text-2xl font-bold text-white sm:text-3xl">
        The authoritative reference for SORA v3.
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-base text-gray-300">
        Execution lanes, governance cadence, and liquidity safeguards — all documented in the official Nexus whitepaper. Download the PDF or browse the wiki.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
        <Button
          variant="primary"
          size="md"
          text="Download PDF"
          href="/documents/sora_nexus_whitepaper.pdf"
          icon="tabler:file-download"
          class="w-full justify-center sm:w-auto"
          target="_blank"
          rel="noopener noreferrer"
        />
        <Button
          variant="secondary"
          size="md"
          text="Open SORA Wiki"
          href="https://wiki.sora.org/"
          icon="tabler:external-link"
          class="w-full justify-center sm:w-auto"
          target="_blank"
          rel="noopener noreferrer"
        />
      </div>
    </div>
  </section>

  <!-- Architecture & Primitives Section -->
  <section class="mt-20 px-4 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.35em] text-brand-500">Core Primitives</p>
        <h2 class="mt-4 text-3xl font-bold text-text-main md:text-4xl">How SORA v3 (Nexus) works.</h2>
        <p class="mt-3 text-base text-text-muted">
          Four primitives form the backbone of execution, monetary policy, governance, and liquidity.
        </p>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {primitives.map(({ eyebrow, icon, title, description, href, cta, external }) => (
          <a
            href={href}
            target={external ? '_blank' : '_blank'}
            rel="noopener noreferrer"
            class="group flex flex-col rounded-2xl border border-border-subtle bg-surface p-6 shadow-sm transition hover:-translate-y-1 hover:border-brand-500 hover:shadow-elevated"
          >
            <p class="text-xs font-semibold uppercase tracking-[0.35em] text-brand-500">{eyebrow}</p>
            <div class="mt-3 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-soft text-brand-500 transition group-hover:bg-brand-500 group-hover:text-white">
              <Icon name={icon} class="h-5 w-5" />
            </div>
            <h3 class="mt-4 text-lg font-semibold text-text-main">{title}</h3>
            <p class="mt-2 flex-1 text-sm text-text-muted">{description}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand-500 group-hover:text-brand-400">
              {cta}
              <Icon name="tabler:arrow-up-right" class="h-4 w-4" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Onboarding Section -->
  <section class="mt-20 px-4 sm:px-6">
    <div class="mx-auto max-w-6xl rounded-3xl border border-border-subtle bg-surface p-6 shadow-sm sm:p-10">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.35em] text-brand-500">Getting Started</p>
        <h2 class="mt-4 text-3xl font-bold text-text-main md:text-4xl">New to SORA?</h2>
        <p class="mt-3 text-base text-text-muted">
          Four steps to understand the ecosystem, connect your wallet, and join the community.
        </p>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {onboardSteps.map(({ icon, title, copy }, index) => (
          <div class="relative rounded-2xl border border-border-subtle bg-page p-5 shadow-sm">
            <div class="absolute -top-3 left-5 flex h-6 w-6 items-center justify-center rounded-full bg-brand-500 text-xs font-bold text-white">
              {index + 1}
            </div>
            <div class="mt-2 flex items-center gap-3">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-border-subtle bg-soft">
                <Icon name={icon} class="h-5 w-5 text-brand-500" />
              </span>
              <p class="text-base font-semibold text-text-main">{title}</p>
            </div>
            <p class="mt-3 text-sm text-text-muted leading-relaxed" set:html={copy} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Blog Posts Section -->
  <BlogLatestPosts
    classes={{ container: 'mt-20' }}
    title="Latest from the SORA ecosystem"
    information={`Stay current with Nexus architecture updates, Polkaswap liquidity improvements, and ecosystem news — translated into plain language for builders and policymakers.`}
  />

  <!-- FAQs Section -->
  <section class="mt-20 px-4 sm:px-6">
    <div class="mx-auto max-w-5xl rounded-3xl border border-border-subtle bg-surface p-6 shadow-sm sm:p-10">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.35em] text-brand-500">FAQs</p>
        <h2 class="mt-4 text-3xl font-bold text-text-main md:text-4xl">Common questions</h2>
        <p class="mt-3 text-base text-text-muted">
          Answers reference the Nexus whitepaper, glossary entries, and live wiki sections.
        </p>
      </div>
      <div class="mt-8 space-y-3">
        {nexusFaqs.map(({ question, answer }) => (
          <details class="group rounded-2xl border border-border-subtle bg-page p-5 transition hover:border-brand-500/30">
            <summary class="flex cursor-pointer items-center justify-between text-base font-semibold text-text-main focus-visible:outline-none">
              {question}
              <Icon
                name="tabler:chevron-down"
                class="h-5 w-5 flex-shrink-0 text-text-muted transition-transform duration-200 group-open:rotate-180"
              />
            </summary>
            <div class="mt-4 text-sm text-text-muted leading-relaxed" set:html={answer} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA Section -->
  <section class="mt-20 mb-20 px-4 sm:px-6">
    <div class="mx-auto max-w-5xl overflow-hidden rounded-3xl border border-border-subtle bg-gradient-to-br from-surface to-page p-8 text-center shadow-sm sm:p-10">
      <h2 class="text-2xl font-bold text-text-main sm:text-3xl">Ready to explore the SORA economy?</h2>
      <p class="mx-auto mt-3 max-w-2xl text-base text-text-muted">
        Start with the glossary to learn the terminology, then dive into Polkaswap to experience the Token Bonding Curve and decentralized liquidity firsthand.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
        <Button
          variant="primary"
          size="md"
          text="Browse the Glossary"
          href="/glossary"
          icon="tabler:vocabulary"
          class="w-full justify-center sm:w-auto"
        />
        <Button
          variant="secondary"
          size="md"
          text="Launch Polkaswap"
          href="https://polkaswap.io/"
          target="_blank"
          icon="tabler:external-link"
          class="w-full justify-center sm:w-auto"
        />
        <Button
          variant="tertiary"
          size="md"
          text="Support Soranauts"
          href="/donate"
          icon="tabler:heart"
          class="w-full justify-center border-border-subtle text-text-muted hover:border-brand-500 hover:text-link sm:w-auto"
        />
      </div>
    </div>
  </section>
</Layout>
