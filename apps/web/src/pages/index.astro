---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
/** import Features2 from '~/components/widgets/Features2.astro'; **/
import Steps from '~/components/widgets/Steps.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'SORA v3 DeFi Ecosystem & Polkaswap | Soranauts',
  description:
    'Explore how SORA v3 unites the Token Bonding Curve, Polkaswap, and governance to build a supranational DeFi economy.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Open Polkaswap',
        href: 'https://polkaswap.io/',
        target: '_blank',
      },
      { text: 'Explore Features', href: '#features' },
    ]}
    image={{
      src: '~/assets/images/polkaswap-sora-blockchain.jpg',
      alt: 'Polkaswap trading interface within the SORA v3 decentralized economy',
    }}
  >
    <Fragment slot="title">
      Build Open Finance with SORA v3
    </Fragment>

    <Fragment slot="subtitle">
      SORA v3 is a supranational economic system built on Hyperledger Iroha to deliver predictable liquidity, democratic
      governance, and productive credit. Polkaswap anchors the network with non-custodial liquidity so builders and
      institutions can transact across borders.
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="Features"
    title="What You Get with the SORA Economic Model"
    subtitle="SORA v3 brings together deterministic monetary policy, accountable governance, and interoperable infrastructure for a resilient global finance stack."
    items={[
      {
        title: 'Supranational Economic System',
        description:
          'SORA coordinates a supranational economy that allocates resources to productive work instead of debt. The community blueprint, <a href="https://wiki.sora.org/sora-economy.html" class="font-medium text-link dark:text-link hover:underline">SORA: The New Economic Order</a>, documents how value flows across the network.',
        icon: 'tabler:building-bank',
      },
      {
        title: 'Token Bonding Curve',
        description:
          'XOR supply is governed by the <a href="https://wiki.sora.org/tbc.html" class="font-medium text-link dark:text-link hover:underline">Token Bonding Curve</a>, providing continuous liquidity, transparent price discovery, and elastic issuance aligned with real demand.',
        icon: 'tabler:chart-bar',
      },
      {
        title: 'On-chain Governance',
        description:
          'SORA Governance V1 combines a Council, Technical Committee, and the SORA Parliament to steward upgrades and treasury allocations. Review the <a href="https://wiki.sora.org/sora-governance.html" class="font-medium text-link dark:text-link hover:underline">governance framework</a> to see how proposals reach the network.',
        icon: 'tabler:file-invoice',
      },
      {
        title: 'Hyperledger Iroha Infrastructure',
        description:
          'SORA v3 runs on the next generation of <a href="https://wiki.sora.org/sora-v3.html" class="font-medium text-link dark:text-link hover:underline">Hyperledger Iroha</a>, gaining deterministic finality, modular interoperability, and tooling that connects permissioned and public domains.',
        icon: 'tabler:building-monument',
      },
      {
        title: 'Credit Creation',
        description:
          'SORA introduces production-focused credit so economies can fund new goods and services without compounding debt. Learn how this approach follows the <a href="https://wiki.sora.org/introduction.html" class="font-medium text-link dark:text-link hover:underline">disaggregated quantity theory of money</a>.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'XOR as Legal Tender',
        description:
          'XOR operates as <a href="https://wiki.sora.org/xor.html" class="font-medium text-link dark:text-link hover:underline">supranational money</a>, enabling jurisdictions to finance productive projects, settle trade, and manage reserves through the bonding curve.',
        icon: 'tabler:wallet',
      },
    ]}
  />

  <!-- Get Started Widget ****************** -->

  <Steps
    title="Get Started with SORA"
    items={[
      {
        title: 'Connect Your Wallet',
        description:
          'Begin by <a href="https://wiki.sora.org/polkaswap-connect-wallet.html" class="font-medium text-link dark:text-link hover:underline">connecting a wallet</a> to Polkaswap or installing the <a href="https://fearlesswallet.io" class="font-medium text-link dark:text-link hover:underline">Fearless Wallet</a> app to manage XOR, VAL, and KUSD on the go.',
        icon: 'tabler:wallet',
      },
      {
        title: 'Explore the Ecosystem',
        description:
          'Understand how SORA v3, Polkaswap, and Kensetsu connect by reviewing <a href="https://wiki.sora.org/tokenomics.html" class="font-medium text-link dark:text-link hover:underline">XOR tokenomics</a>, the <a href="https://wiki.sora.org/tbc.html" class="font-medium text-link dark:text-link hover:underline">Token Bonding Curve</a>, and the <a href="https://wiki.sora.org/sora-v3.html" class="font-medium text-link dark:text-link hover:underline">SORA v3 architecture</a>.',
        icon: 'tabler:building-bank',
      },
      {
        title: 'Join the Community',
        description:
          'Collaborate with the SORA community on <a href="https://t.me/sora_xor" class="font-medium text-link dark:text-link hover:underline">Telegram</a>, follow ecosystem milestones on <a href="https://x.com/sora_xor" class="font-medium text-link dark:text-link hover:underline">X</a>, and track proposals through <a href="https://wiki.sora.org/sora-governance.html" class="font-medium text-link dark:text-link hover:underline">on-chain governance</a>.',
        icon: 'tabler:users',
      },
      {
        title: 'Start Learning',
        description:
          'Dive deeper with the Soranauts <a href="/blog" class="font-medium text-link dark:text-link hover:underline">knowledge library</a> and expand your skills through the <a href="https://wiki.sora.org/sora-academy.html" class="font-medium text-link dark:text-link hover:underline">SORA Academy</a> guides.',
        icon: 'tabler:book',
      },
    ]}
    image={{
      src: '~/assets/images/polkaswap-logo-sora-decentralized-exchange.jpg',
      alt: 'Polkaswap logo representing the SORA decentralized exchange',
    }}
  />
  
  <!-- Features2 Widget
  
  ************** -->
  
  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts
    title="Follow SORA v3 & Polkaswap Progress"
    information={`Stay current with analysis of SORA v3 milestones, Polkaswap liquidity improvements, and the Token Bonding Curve's evolving role in the economy. Our guides translate technical updates into clear actions for builders, policymakers, and contributors.
                `}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Everything You Need to Know About SORA"
    subtitle="Clarify how SORA v3, Polkaswap, and XOR work together"
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'What makes SORA V3 different from other blockchains?',
        description:
          "SORA v3 transitions the network onto Hyperledger Iroha for deterministic finality, modular interoperability, and seamless coordination between public and permissioned domains. The hub chain empowers the SORA Parliament to fund productive initiatives while bridges connect ecosystems like Polkadot, TON, and Ethereum. Review the <a href='https://wiki.sora.org/sora-v3.html' class='font-medium text-link dark:text-link hover:underline'>SORA v3 documentation</a> for details.",
      },
      {
        title: 'How does Polkaswap compare to other DEXs?',
        description:
          "Polkaswap aggregates liquidity across connected networks, enabling non-custodial swaps between assets that live on SORA, Polkadot, Ethereum, and beyond. Smart routing and bridge integrations keep spreads competitive while you retain control of your keys. Explore the <a href='https://wiki.sora.org/polkaswap.html' class='font-medium text-link dark:text-link hover:underline'>Polkaswap wiki guide</a> to see supported features.",
      },
      {
        title: 'What are the benefits of the Token Bonding Curve?',
        description:
          "The Token Bonding Curve continuously mints or burns XOR in line with demand, so the supply expands for productive activity and contracts when reserves are redeemed. This automated market maker delivers transparent pricing, guaranteed liquidity, and forward guidance for the economy. Study the mechanism in <a href='https://wiki.sora.org/tokenomics.html' class='font-medium text-link dark:text-link hover:underline'>SORA's tokenomics documentation</a>.",
      },
      {
        title: "How do I get started with SORA and Polkaswap?",
        description:
          "Download <a href='https://fearlesswallet.io' class='font-medium text-link dark:text-link hover:underline'>Fearless Wallet</a> or connect a browser wallet to Polkaswap. From there you can acquire XOR through the bonding curve, supply liquidity, or participate in governance. Track the roadmap through the <a href='https://wiki.sora.org/integrated-plan.html' class='font-medium text-link dark:text-link hover:underline'>SORA Integrated Plan</a>.",
      },
      {
        title: 'What staking and yield opportunities are available?',
        description:
          "Community members can stake to secure the network, participate in liquidity programs on Polkaswap, or follow campaign-specific incentives published through the ecosystem updates feed. Consult the <a href='https://wiki.sora.org/sora-academy.html' class='font-medium text-link dark:text-link hover:underline'>SORA Academy</a> tutorials for the latest participation guides.",
      },
      {
        title: 'Is SORA secure and decentralized?',
        description:
          "SORA is operated by a decentralized validator set governed through on-chain referenda. Monetary stability is enforced by the Token Bonding Curve, and upgrades are vetted through the Parliament and Council process before deployment. Follow security and governance updates in the <a href='https://wiki.sora.org/sora-governance.html' class='font-medium text-link dark:text-link hover:underline'>SORA governance documentation</a>.",
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Launch Polkaswap',
        href: 'https://polkaswap.io/',
        target: '_blank',
        icon: 'tabler:external-link',
      },
    ]}
  >
    <Fragment slot="title">
      Engage with the SORA economy.
    </Fragment>

    <Fragment slot="subtitle">
      Use Polkaswap to bridge, swap, and allocate liquidity while SORA governance and the Token Bonding Curve keep the economy transparent.
    </Fragment>
  </CallToAction>
</Layout>
