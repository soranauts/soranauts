---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Button from '~/components/ui/Button.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'SORA v3 (Nexus) — DeFi Economy & Polkaswap | Soranauts',
  description:
    'SORA v3 (Nexus) delivers deterministic execution, predictable liquidity, and accountable governance. Download the Nexus whitepaper or launch Polkaswap.',
  ignoreTitleTemplate: true,
};

const nexusHighlights = [
  {
    eyebrow: 'Architecture',
    title: 'Lanes, Merge Ledger & Data Spaces',
    summary: 'Sections 6–7 explain how Nexus scales with parallel lanes while the merge ledger keeps one canonical order across sovereign data spaces.',
    points: [
      'Lanes finalize independently and fuse or split deterministically based on load.',
      'Merge ledger orders lane tips without rewriting finalized history.',
      'Data spaces provide privacy and jurisdictional controls while still emitting proofs.',
    ],
    source: {
      href: '/documents/sora_nexus_whitepaper.pdf',
      label: 'Whitepaper §§6–7 — Architecture & Data Spaces',
      description: 'PDF: Component roles, data-space governance, lane/merge design.',
    },
  },
  {
    eyebrow: 'Execution',
    title: 'IVM, Kotodama & Deterministic Contracts',
    summary: 'Sections 5 and 11 detail the Iroha Virtual Machine and Kotodama bytecode that keep Nexus execution deterministic.',
    points: [
      'Pointer-ABI defines typed handles so contracts cannot craft malformed references.',
      'Gas tables and syscalls are versioned on-chain for predictable execution.',
      'Kotodama bytecode (.to) plus Norito serialization keeps auditing and ZK tracing straightforward.',
    ],
    source: {
      href: '/documents/sora_nexus_whitepaper.pdf',
      label: 'Whitepaper §§5 & 11 — IVM & Smart Contracts',
      description: 'PDF: Kotodama runtime, pointer ABI, syscalls, gas, and execution model.',
    },
  },
  {
    eyebrow: 'Security & DA',
    title: 'FASTPQ Proofs, DA Sampling & Sumeragi',
    summary: 'Sections 8–10 describe the Sumeragi pipeline, Start-Time Fair Queuing, and FASTPQ zk-STARK proofs tied to DA certificates.',
    points: [
      'Sumeragi finalizes non-empty slots in ~1 s with deterministic leader rotation.',
      'FASTPQ proofs aggregate per-data-space execution into verifiable lane receipts.',
      'Two-dimensional erasure coding plus DA sampling keeps data recoverable and auditable.',
    ],
    source: {
      href: '/documents/sora_nexus_whitepaper.pdf',
      label: 'Whitepaper §§8–10 — Consensus, Proofs & DA',
      description: 'PDF: Consensus pipeline, fairness budgets, proof system, DA certificates.',
    },
  },
  {
    eyebrow: 'Governance',
    title: 'SORA Parliament & Governance Surfaces',
    summary: 'Sections 7.2 and 16 outline configuration surfaces, data-space onboarding, and the upcoming SORA Parliament structure.',
    points: [
      'Council, Assembly, and Technical Committee publish Norito manifests with XOR bonds.',
      'Parameter sets (crypto, scheduling, admission caps) are versioned on-chain.',
      'New data spaces require attested certificates; unknown DSIDs are rejected.',
    ],
    source: {
      href: '/documents/sora_nexus_whitepaper.pdf',
      label: 'Whitepaper §§7.2 & 16 — Governance Surfaces & Parliament',
      description: 'PDF: Governance bodies, manifests, bonds, and upgrade flow.',
    },
  },
];

const nexusFaqs = [
  {
    question: 'How do Nexus lanes reach ~1 second finality?',
    answer:
      'Sections 6–8 of the <a href="/documents/sora_nexus_whitepaper.pdf" class="text-brand-500 hover:underline">Nexus whitepaper</a> explain how parallel lanes execute in isolation while the merge ledger orders lane tips into one canonical sequence. The Sumeragi pipeline plus Start-Time Fair Queuing (STFQ) keeps every lane deterministic, so builders never fork history even when throughput spikes.',
  },
  {
    question: 'What are data spaces and why do they matter?',
    answer:
      'Nexus treats each jurisdiction or business unit as a sovereign data space with its own policy, privacy settings, and audit proofs. Governed onboarding (bonds + attestations) ensures private zones stay private while still emitting proofs to the merge ledger. Review §7 of the whitepaper or the <a href="https://wiki.sora.org/sora-v3.html" class="text-brand-500 hover:underline">SORA v3 architecture guide</a> for the latest data-space manifest format.',
  },
  {
    question: 'How is liquidity policy enforced across SORA?',
    answer:
      'The <a href="https://wiki.sora.org/tbc.html" class="text-brand-500 hover:underline">XOR Token Bonding Curve</a> keeps supply elastic and signals mint/burn windows so desks can schedule liquidity programs. Nexus lanes read the same bonding-curve state, meaning liquidity desks, Polkaswap LPs, and Kensetsu vaults all follow the same deterministic policy.',
  },
  {
    question: 'Where do I follow governance cadence and upgrades?',
    answer:
      'Nexus encodes governance manifests in Norito so Council, Assembly, and the Technical Committee enact upgrades without manual intervention. Track the plan via the <a href="https://wiki.sora.org/sora-governance.html" class="text-brand-500 hover:underline">SORA governance wiki</a> or review §16 of the whitepaper for the upcoming SORA Parliament structure.',
  },
];
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Open Polkaswap',
        href: 'https://polkaswap.io/',
        target: '_blank',
        size: 'md',
        icon: 'tabler:external-link',
        rel: 'noopener noreferrer',
      },
      {
        variant: 'secondary',
        text: 'Read Whitepaper',
        href: '/documents/sora_nexus_whitepaper.pdf',
        target: '_blank',
        size: 'md',
        icon: 'tabler:file-text',
        rel: 'noopener noreferrer',
      },
      {
        variant: 'tertiary',
        text: 'Explore Nexus Features',
        href: '#features',
        size: 'md',
        icon: 'tabler:chevrons-right',
      },
    ]}
  >
    <Fragment slot="tagline">
      SORA v3 (Nexus)
    </Fragment>

    <Fragment slot="title">
      SORA v3 (Nexus) delivers deterministic liquidity and accountable governance.
    </Fragment>

    <Fragment slot="subtitle">
      As of November 2025, Hyperledger Iroha “Nexus” lanes finalize cross-domain activity with deterministic guardrails while the Token Bonding Curve keeps liquidity predictable. Polkaswap anchors
      non-custodial markets so treasuries, desks, and builders can orchestrate capital without surrendering custody.
    </Fragment>
  </Hero>

  <section id="features" class="mx-auto mt-8 max-w-6xl px-4 sm:px-6 lg:mt-12 lg:px-8">
    <div class="text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.35em] text-brand-500">Whitepaper Highlights</p>
      <h2 class="mt-4 text-3xl font-bold text-text-main md:text-4xl">What the whitepaper emphasizes.</h2>
      <p class="mt-3 text-base text-text-muted max-w-3xl mx-auto">
        Nexus execution, predictable liquidity, governance cadence, and programmatic guardrails make Soranauts a reliable window into the SORA economy.
      </p>
    </div>
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {nexusHighlights.map(({ eyebrow, title, summary, points, source }) => (
        <article class="flex h-full flex-col rounded-2xl border border-border-subtle bg-soft/80 p-6 shadow-sm">
          <p class="text-xs font-semibold uppercase tracking-[0.35em] text-brand-500">{eyebrow}</p>
          <h3 class="mt-3 text-xl font-semibold text-text-main">{title}</h3>
          {summary && <p class="mt-3 text-sm text-text-muted">{summary}</p>}
          {points && (
            <ul class="mt-3 space-y-2 text-sm text-text-muted">
              {points.map((point) => (
                <li class="flex gap-2">
                  <span class="text-brand-500">•</span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          )}
          {source && (
            <p class="mt-4 text-xs text-text-muted">
              Source:{' '}
              <a href={source.href} class="text-brand-500 hover:text-brand-400 underline decoration-dotted">
                {source.label}
              </a>
              . {source.description}
            </p>
          )}
        </article>
      ))}
    </div>
  </section>

  <!-- Note Widget ******************* -->

  <section class="relative mt-16 px-4 sm:px-6">
    <div class="absolute inset-0 -z-[1] bg-gradient-to-br from-brand-soft/30 via-transparent to-brand-soft/10" aria-hidden="true"></div>
    <div class="mx-auto max-w-5xl rounded-2xl border border-border-subtle/70 bg-[#1b2430] p-6 text-center text-white shadow-lg sm:p-8">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-brand-200">
        Nexus Whitepaper Access
      </p>
      <p class="mt-3 text-base sm:text-lg">
        As of November 2025, the SORA v3 (Nexus) whitepaper remains the authoritative reference for execution lanes, governance cadence, and liquidity safeguards. Grab the PDF or browse the wiki snapshot.
      </p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-center">
        <Button
          variant="primary"
          size="md"
          text="Download PDF"
          href="/documents/sora_nexus_whitepaper.pdf"
          icon="tabler:file-download"
          class="w-full justify-center sm:w-auto"
          target="_blank"
          rel="noopener noreferrer"
        />
        <Button
          variant="secondary"
          size="md"
          text="Open SORA Wiki"
          href="https://wiki.sora.org/"
          icon="tabler:book-2"
          class="w-full justify-center sm:w-auto"
          target="_blank"
          rel="noopener noreferrer"
        />
      </div>
    </div>
  </section>

  <!-- Features Widget *************** -->

  <section class="mt-16 px-4 sm:px-6">
    <div class="mx-auto max-w-5xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.35em] text-brand-500">Architecture & Primitives</p>
        <h2 class="mt-4 text-3xl font-bold text-text-main md:text-4xl">Nexus Architecture & Economic Primitives</h2>
        <p class="mt-3 text-base text-text-muted">
          The Nexus whitepaper frames these primitives as the backbone of execution lanes, monetary policy, governance, and liquidity. Each card summarizes the intent plus the impact on institutions.
        </p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        <article class="rounded-2xl border border-border-subtle bg-soft/70 p-6 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-[0.35em] text-brand-500">Execution</p>
        <h3 class="mt-3 text-xl font-semibold text-text-main">Lanes & Merge Ledger</h3>
        <p class="mt-3 text-sm text-text-muted">
          Iroha v3 lanes finalize independently, then the merge ledger weaves those tips into one canonical order so builders never fork history or lose cross-domain atomicity.
        </p>
          <Button
            variant="tertiary"
            size="md"
            text="See architecture overview"
            href="/documents/sora_nexus_whitepaper.pdf"
            icon="tabler:git-merge"
            class="mt-5 justify-start text-brand-500 hover:text-brand-400"
            target="_blank"
            rel="noopener noreferrer"
          />
      </article>
        <article class="rounded-2xl border border-border-subtle bg-soft/70 p-6 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-[0.35em] text-brand-500">Monetary Policy</p>
        <h3 class="mt-3 text-xl font-semibold text-text-main">XOR Bonding Curve & Credit</h3>
        <p class="mt-3 text-sm text-text-muted">
          The bonding curve keeps XOR supply elastic, signals mint/burn windows, and funds productive credit programs so desks can dial liquidity without surprises.
        </p>
        <Button
          variant="tertiary"
          size="md"
          text="Review bonding curve model"
          href="https://wiki.sora.org/tbc.html"
          icon="tabler:chart-line"
          class="mt-5 justify-start text-brand-500 hover:text-brand-400"
          target="_blank"
          rel="noopener noreferrer"
        />
      </article>
        <article class="rounded-2xl border border-border-subtle bg-soft/70 p-6 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-[0.35em] text-brand-500">Governance</p>
        <h3 class="mt-3 text-xl font-semibold text-text-main">SORA Parliament</h3>
        <p class="mt-3 text-sm text-text-muted">
          Council, Assembly, and Technical Committee publish Norito manifests with XOR bonds so upgrades, lane parameters, and new data spaces activate deterministically.
        </p>
        <Button
          variant="tertiary"
          size="md"
          text="Read governance plan"
          href="https://wiki.sora.org/sora-governance.html"
          icon="tabler:scale"
          class="mt-5 justify-start text-brand-500 hover:text-brand-400"
          target="_blank"
          rel="noopener noreferrer"
        />
      </article>
        <article class="rounded-2xl border border-border-subtle bg-soft/70 p-6 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-[0.35em] text-brand-500">Liquidity</p>
        <h3 class="mt-3 text-xl font-semibold text-text-main">Polkaswap & Supranational Money</h3>
        <p class="mt-3 text-sm text-text-muted">
          Polkaswap routes liquidity across HASHI-connected domains while XOR operates as supranational money so institutions can settle trade, manage reserves, and finance projects on one ledger.
        </p>
        <Button
          variant="tertiary"
          size="md"
          text="Explore Polkaswap rails"
          href="https://wiki.sora.org/polkaswap.html"
          icon="tabler:arrows-exchange"
          class="mt-5 justify-start text-brand-500 hover:text-brand-400"
          target="_blank"
          rel="noopener noreferrer"
        />
        </article>
      </div>
    </div>
  </section>

  <!-- Get Started Widget ****************** -->

  <section class="mt-16 px-4 sm:px-6">
    <div class="mx-auto max-w-6xl rounded-3xl border border-border-subtle bg-soft/70 p-6 sm:p-8 shadow-sm">
      <div class="text-center max-w-3xl mx-auto">
        <p class="text-xs font-semibold uppercase tracking-[0.35em] text-brand-500">Getting started</p>
        <h2 class="mt-4 text-3xl font-bold text-text-main md:text-4xl">Onboard to SORA v3 (Nexus)</h2>
        <p class="mt-3 text-base text-text-muted">
          Follow these steps to connect wallets, study the architecture, collaborate with the community, and reference canonical whitepaper guidance.
        </p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {[
          {
        icon: 'tabler:wallet',
            title: 'Connect your wallet',
            copy:
              'Start with <a href="https://wiki.sora.org/polkaswap-connect-wallet.html" class="text-brand-500 hover:underline" target="_blank" rel="noopener noreferrer">Polkaswap wallet guides</a> or install <a href="https://fearlesswallet.io" class="text-brand-500 hover:underline" target="_blank" rel="noopener noreferrer">Fearless Wallet</a> to manage XOR, VAL, and KUSD.',
      },
      {
        icon: 'tabler:building-bank',
            title: 'Explore the ecosystem',
            copy:
              'Review <a href="https://wiki.sora.org/tokenomics.html" class="text-brand-500 hover:underline" target="_blank" rel="noopener noreferrer">XOR tokenomics</a>, the <a href="https://wiki.sora.org/tbc.html" class="text-brand-500 hover:underline" target="_blank" rel="noopener noreferrer">Token Bonding Curve</a>, and the <a href="https://wiki.sora.org/sora-v3.html" class="text-brand-500 hover:underline" target="_blank" rel="noopener noreferrer">Nexus architecture</a> to see how components interlock.',
      },
      {
        icon: 'tabler:users',
            title: 'Join the community',
            copy:
              'Jump into <a href="https://t.me/sora_xor" class="text-brand-500 hover:underline" target="_blank" rel="noopener noreferrer">Telegram</a>, follow progress on <a href="https://x.com/sora_xor" class="text-brand-500 hover:underline" target="_blank" rel="noopener noreferrer">X</a>, and track proposals via <a href="https://wiki.sora.org/sora-governance.html" class="text-brand-500 hover:underline" target="_blank" rel="noopener noreferrer">governance updates</a>.',
          },
          {
            icon: 'tabler:file-description',
            title: 'Read the whitepaper',
            copy:
              'Download the <a href="/documents/sora_nexus_whitepaper.pdf" class="text-brand-500 hover:underline" target="_blank" rel="noopener noreferrer">SORA v3 (Nexus) whitepaper</a> for canonical definitions, then rely on Soranauts articles for plain-language explainers.',
          },
        ].map(({ icon, title, copy }) => (
          <div class="rounded-2xl border border-border-subtle bg-surface/70 p-4 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-border-subtle bg-soft">
                <Icon name={icon} class="h-5 w-5 text-brand-500" />
              </span>
              <p class="text-base font-semibold text-text-main">{title}</p>
            </div>
            <p class="mt-3 text-sm text-text-muted leading-relaxed" set:html={copy} />
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- Features2 Widget
  
  ************** -->
  
  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts
    classes={{ container: 'mt-20' }}
    title="Follow SORA v3 (Nexus) & Polkaswap Progress"
    information={`As of November 2025, we translate Nexus architecture updates, Polkaswap liquidity improvements, and bonding curve policy signals into plain next steps for builders and policymakers.`}
  />

  <!-- FAQs Widget ******************* -->

  <section class="mt-20 px-4 sm:px-6">
    <div class="mx-auto max-w-5xl rounded-3xl border border-border-subtle bg-soft/70 p-6 sm:p-8 shadow-sm">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.35em] text-brand-500">Nexus FAQs</p>
        <h2 class="mt-4 text-3xl font-bold text-text-main md:text-4xl">Key questions we hear most</h2>
        <p class="mt-3 text-base text-text-muted">
          Answers reference the November 2025 Nexus whitepaper and live wiki sections so you always have canonical context.
        </p>
      </div>
      <div class="mt-8 space-y-4">
        {nexusFaqs.map(({ question, answer }) => (
          <details class="group rounded-2xl border border-border-subtle bg-surface/80 p-5 text-left shadow-sm transition">
            <summary class="flex cursor-pointer items-center justify-between text-base font-semibold text-text-main focus-visible:outline-none">
              {question}
              <Icon
                name="tabler:chevron-down"
                class="h-5 w-5 text-text-muted transition-transform duration-200 group-open:rotate-180"
              />
            </summary>
            <div class="mt-3 text-sm text-text-muted leading-relaxed" set:html={answer} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="px-4 sm:px-6 mt-16 mb-20">
    <div class="mx-auto max-w-5xl rounded-2xl border border-border-subtle bg-soft/70 p-6 sm:p-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-text-main">Engage with the SORA v3 (Nexus) economy.</h2>
      <p class="mt-3 text-base text-text-muted">
        As of November 2025, Polkaswap plus the Token Bonding Curve provide transparent markets and predictable issuance so every Nexus participant sees how liquidity and governance decisions land.
      </p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-center">
        <Button
          variant="primary"
          size="md"
          text="Launch Polkaswap"
          href="https://polkaswap.io/"
          target="_blank"
          icon="tabler:external-link"
          class="w-full justify-center sm:w-auto"
        />
        <Button
          variant="secondary"
          size="md"
          text="Download Whitepaper"
          href="/documents/sora_nexus_whitepaper.pdf"
          icon="tabler:file-download"
          class="w-full justify-center sm:w-auto"
        />
      </div>
    </div>
  </section>
</Layout>
