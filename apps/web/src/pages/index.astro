---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
/** import Features2 from '~/components/widgets/Features2.astro'; **/
import Steps from '~/components/widgets/Steps.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'SORA v3 (Nexus) — DeFi Economy & Polkaswap | Soranauts',
  description:
    'As of November 2025: SORA v3 (Nexus) on Hyperledger Iroha delivers deterministic finality, predictable liquidity via the Token Bonding Curve, and accountable governance. Read the Nexus whitepaper and explore Polkaswap.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Open Polkaswap',
        href: 'https://polkaswap.io/',
        target: '_blank',
      },
      {
        variant: 'secondary',
        text: 'Read Nexus Whitepaper (PDF)',
        href: '/documents/sora_nexus_whitepaper.pdf',
      },
      { text: 'Explore Features', href: '#features' },
    ]}
    image={{
      src: '~/assets/images/polkaswap-sora-blockchain.jpg',
      alt: 'Polkaswap trading interface within the SORA v3 decentralized economy',
    }}
  >
    <Fragment slot="title">
      Build Open Finance with SORA v3 (Nexus)
    </Fragment>

    <Fragment slot="subtitle">
      As of November 2025, Hyperledger Iroha “Nexus” lanes deliver deterministic finality across connected domains while
      the Token Bonding Curve keeps liquidity predictable. Polkaswap anchors these non-custodial markets so builders can
      orchestrate cross-border capital without surrendering custody.
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <section class="bg-[#20262e] dark:bg-[#222C36e6] not-prose">
    <div
      class="max-w-6xl mx-auto px-4 sm:px-6 py-6 text-center text-white dark:text-white space-y-4"
      aria-live="polite"
    >
      <p class="text-base font-medium">
        <span class="font-bold">As of November 2025:</span> The SORA v3 (Nexus) whitepaper is available for download so
        teams can reference canonical definitions while aligning with current governance, execution lanes, and liquidity
        guarantees.
      </p>
      <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          class="inline-flex items-center justify-center rounded-md border border-white/40 px-4 py-2 text-sm font-semibold transition hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          href="/documents/sora_nexus_whitepaper.pdf"
        >
          Download PDF
        </a>
        <a
          class="inline-flex items-center justify-center rounded-md border border-white/40 px-4 py-2 text-sm font-semibold transition hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          href="https://wiki.sora.org/"
        >
          Open SORA Wiki
        </a>
      </div>
    </div>
  </section>

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="Features"
    title="Nexus Architecture & Economic Primitives"
    subtitle="As of November 2025, SORA v3 (Nexus) pairs deterministic Iroha execution, an elastic monetary base, and accountable governance primitives so institutions can rely on transparent rules."
    items={[
      {
        title: 'Nexus Execution & Interop',
        description:
          'Hyperledger Iroha v3 lanes synchronize deterministic finality and bridge messages so assets and logic can move consistently between Nexus hubs and connected domains.',
        icon: 'tabler:building-monument',
      },
      {
        title: 'Token Bonding Curve',
        description:
          'The Token Bonding Curve keeps XOR liquidity continuous while revealing transparent price discovery for treasuries, liquidity desks, and institutions.',
        icon: 'tabler:chart-bar',
      },
      {
        title: 'On-chain Governance',
        description:
          'The Parliament, Council, and Technical Committee coordinate upgrades, treasury flows, and validator accountability without centralized gatekeepers.',
        icon: 'tabler:file-invoice',
      },
      {
        title: 'Credit for Production',
        description:
          'Nexus channels productive credit into new goods and services instead of legacy debt spirals, aligning issuance with measurable output.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'Polkaswap Liquidity Hub',
        description:
          'Polkaswap routes non-custodial liquidity across bridges so LPs and institutions can clear trades and manage reserves while retaining custody.',
        icon: 'tabler:arrows-exchange',
      },
      {
        title: 'Supranational Money',
        description:
          'XOR operates as supranational money so jurisdictions can settle trade, manage reserves, and finance productive projects through the predictable bonding curve.',
        icon: 'tabler:wallet',
      },
    ]}
  />

  <!-- Get Started Widget ****************** -->

  <Steps
    title="Get Started with SORA"
    items={[
      {
        title: 'Connect Your Wallet',
        description:
          'Begin by <a href="https://wiki.sora.org/polkaswap-connect-wallet.html" class="font-medium text-link dark:text-link hover:underline">connecting a wallet</a> to Polkaswap or installing the <a href="https://fearlesswallet.io" class="font-medium text-link dark:text-link hover:underline">Fearless Wallet</a> app to manage XOR, VAL, and KUSD on the go.',
        icon: 'tabler:wallet',
      },
      {
        title: 'Explore the Ecosystem',
        description:
          'Understand how SORA v3, Polkaswap, and Kensetsu connect by reviewing <a href="https://wiki.sora.org/tokenomics.html" class="font-medium text-link dark:text-link hover:underline">XOR tokenomics</a>, the <a href="https://wiki.sora.org/tbc.html" class="font-medium text-link dark:text-link hover:underline">Token Bonding Curve</a>, and the <a href="https://wiki.sora.org/sora-v3.html" class="font-medium text-link dark:text-link hover:underline">SORA v3 architecture</a>.',
        icon: 'tabler:building-bank',
      },
      {
        title: 'Join the Community',
        description:
          'Collaborate with the SORA community on <a href="https://t.me/sora_xor" class="font-medium text-link dark:text-link hover:underline">Telegram</a>, follow ecosystem milestones on <a href="https://x.com/sora_xor" class="font-medium text-link dark:text-link hover:underline">X</a>, and track proposals through <a href="https://wiki.sora.org/sora-governance.html" class="font-medium text-link dark:text-link hover:underline">on-chain governance</a>.',
        icon: 'tabler:users',
      },
      {
        title: 'Read the Whitepaper',
        description:
          'Reference the <a href="/documents/sora_nexus_whitepaper.pdf" class="font-medium text-link dark:text-link hover:underline">SORA v3 (Nexus) whitepaper</a> for canonical definitions, then use Soranauts articles for plain-language takeaways you can share with stakeholders.',
        icon: 'tabler:file-description',
      },
    ]}
    image={{
      src: '~/assets/images/polkaswap-logo-sora-decentralized-exchange.jpg',
      alt: 'Polkaswap logo representing the SORA decentralized exchange',
    }}
  />
  
  <!-- Features2 Widget
  
  ************** -->
  
  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts
    title="Follow SORA v3 (Nexus) & Polkaswap Progress"
    information={`As of November 2025, we translate Nexus architecture updates, Polkaswap liquidity improvements, and bonding curve policy signals into plain next steps for builders and policymakers.`}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="SORA v3 (Nexus) — Key Questions"
    subtitle="As of November 2025, here is how Nexus execution, liquidity, and governance fit together."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'What makes Nexus different?',
        description:
          'SORA v3 (Nexus) runs on Hyperledger Iroha lanes that finalize transactions deterministically and coordinate bridges, so assets can cross permissioned and public domains without guessing finality windows.',
      },
      {
        title: 'How does the Bonding Curve help?',
        description:
          'The Token Bonding Curve mints or burns XOR alongside demand, keeping liquidity continuous for market makers and public treasuries while signaling price in advance of major allocations.',
      },
      {
        title: 'How is execution different from WASM-only chains?',
        description:
          'Nexus optimizes for predictable state machines instead of just smart-contract VMs, giving validators pre-verified instructions, native bridging, and governance-enforced upgrade paths.',
      },
      {
        title: 'Where do I learn the details?',
        description:
          "Start with the <a href='/documents/sora_nexus_whitepaper.pdf' class='font-medium text-link dark:text-link hover:underline'>Nexus whitepaper</a>, then compare it with living documentation on the <a href='https://wiki.sora.org/' class='font-medium text-link dark:text-link hover:underline'>SORA Wiki</a> and Soranauts explainers for plain-language context.",
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Launch Polkaswap',
        href: 'https://polkaswap.io/',
        target: '_blank',
        icon: 'tabler:external-link',
      },
      {
        variant: 'secondary',
        text: 'Download Nexus Whitepaper',
        href: '/documents/sora_nexus_whitepaper.pdf',
        icon: 'tabler:file-download',
      },
    ]}
  >
    <Fragment slot="title">
      Engage with the SORA v3 (Nexus) economy.
    </Fragment>

    <Fragment slot="subtitle">
      As of November 2025, Polkaswap plus the Token Bonding Curve provide transparent markets and predictable issuance so every Nexus participant sees how liquidity and governance decisions land.
    </Fragment>
  </CallToAction>
</Layout>
