{
  "name": "soranauts-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.2",
  "engines": {
    "node": "20.x",
    "pnpm": ">=9.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "preinstall": "node -e \"if (!process.env.npm_execpath || !process.env.npm_execpath.includes('pnpm')) { console.error('Use pnpm to install'); process.exit(1) }\"",
    "prepare": "husky install",
    "build": "pnpm --filter @soranauts/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter ./apps/web dev",
    "dev:web": "pnpm --filter ./apps/web dev",
    "dev:glossary:v3": "FEATURE_GLOSSARY_V3_UI=true pnpm --filter @soranauts/web dev",
    "pre-push": "cd apps/web && pnpm install --frozen-lockfile && pnpm build && pnpm test",
    "release:tag:glossary": "node scripts/release-tag.js",
    "taxonomy:audit": "tsx scripts/glossary-audit.ts",
    "taxonomy:fix": "tsx scripts/glossary-audit.ts --fix",
    "taxonomy:fix:stubs": "tsx scripts/glossary-audit.ts --fix --add-stubs",
    "taxonomy:guard": "bash tools/guard_vercel_glossary.sh",
    "taxonomy:test:snapshot": "tsx scripts/test-glossary-snapshot.ts",
    "glossary:redirects:build": "tsx scripts/generate-vercel-redirects.ts",
    "glossary:build": "tsx scripts/build-nexus-glossary-json.ts",
    "content:lint": "tsx scripts/lint-content.ts",
    "content:validate": "tsx scripts/validate-frontmatter.ts",
    "content:fix": "tsx scripts/fix-frontmatter.ts",
    "author:preview": "tsx scripts/dev/preview-term.ts",
    "og:glossary": "tsx scripts/generate-og.ts",
    "precommit": "pnpm content:fix && pnpm content:lint && pnpm content:validate && git add .",
    "monitor:slugs": "tsx scripts/monitor/slugs-check.ts",
    "monitor:quickview": "tsx scripts/monitor/quickview-smoke.ts",
    "monitor:report": "tsx scripts/monitor/report-insights.ts",
    "audit:features-links": "tsx scripts/audit/features-glossary-links.ts",
    "content:gaps": "tsx scripts/content/find-gaps.ts",
    "ops:snapshot": "tsx scripts/ops/snapshot-glossary.ts",
    "glossary:verify": "tsx scripts/build-nexus-glossary-json.ts && tsx scripts/verify-generator-parity.ts",
    "glossary:verify:live": "tsx scripts/verify-glossary-live.ts",
    "verify:live": "bash tools/verify_glossary_live.sh https://soranauts.com",
    "predeploy:prod": "tsx scripts/deploy/prepare_release.ts",
    "deploy:prod": "pnpm glossary:build && pnpm -w typecheck && pnpm --filter @soranauts/web build",
    "postdeploy:prod": "tsx scripts/deploy/verify_live.ts https://soranauts.com && tsx scripts/deploy/purge_cache.ts https://soranauts.com",
    "release:prod": "pnpm predeploy:prod && pnpm deploy:prod && pnpm postdeploy:prod",
    "rollback:prod": "git revert -m 1 $(git rev-parse HEAD) || true",
    "kb:ingest": "tsx knowledge_base/scripts/ingest.ts",
    "kb:ingest:ci": "CHROMA_STRICT=1 tsx knowledge_base/scripts/ingest.ts",
    "kb:ingest:local": "LOCAL_EMBED_STORE=duckdb tsx knowledge_base/scripts/ingest.ts"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "chromadb": "^1.10.5",
    "commander": "^14.0.2",
    "duckdb": "^1.4.3",
    "glob": "^13.0.0",
    "got": "^14.6.6",
    "minisearch": "^7.2.0",
    "openai": "^4.104.0",
    "p-queue": "^8.1.1",
    "p-retry": "^6.2.1",
    "pdf-parse": "^1.1.4",
    "robots-parser": "^3.0.1",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.17.3",
    "sitemapper": "^4.1.5",
    "tiktoken": "^1.0.22",
    "turndown": "^7.2.2"
  },
  "devDependencies": {
    "diff": "^8.0.3",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "tsx": "^4.21.0"
  },
  "lint-staged": {
    "{apps,packages}/**/*.{ts,tsx}": [],
    "{apps,packages}/**/*.astro": [],
    "*.md": []
  },
  "pnpm": {
    "overrides": {
      "vite": ">=7.3.2 <8.0.0",
      "esbuild@<=0.24.2": ">=0.25.0",
      "mdast-util-to-hast@>=13.0.0 <13.2.1": ">=13.2.1",
      "qs": ">=6.14.2",
      "preact": ">=10.27.3",
      "h3@<=1.15.8": ">=1.15.9",
      "diff@<8.0.3": ">=8.0.3",
      "tar@<7.5.8": ">=7.5.8",
      "fast-xml-parser@<5.5.7": ">=5.5.7",
      "ajv@>=8.0.0 <8.18.0": ">=8.18.0",
      "devalue@<=5.6.2": ">=5.6.3",
      "axios@<1.15.0": ">=1.15.0",
      "minimatch": ">=9.0.5",
      "rollup": ">=4.29.1",
      "svgo": ">=3.3.2",
      "@tootallnate/once": ">=2.0.0",
      "defu@<=6.1.4": ">=6.1.5",
      "picomatch@>=2.0.0 <2.3.2": ">=2.3.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3",
      "smol-toml@<1.6.1": ">=1.6.1",
      "flatted@<3.4.2": ">=3.4.2",
      "undici@>=7.0.0 <7.24.0": ">=7.24.0 <8.0.0"
    },
    "pnpmOverridesNotes": "h3 and diff overrides added 2026-01-15. tar override updated 2026-02-02 to fix CVE-2026-23950 (race condition) and hardlink traversal CVEs. fast-xml-parser override added 2026-02-02 to fix CVE-2026-25128. axios override added 2026-02-14 to fix CVE-2026-25639 (DoS via __proto__); transitive dep from typesense. 2026-04-12: Updated h3, fast-xml-parser, axios ranges. Added overrides for vite 6.x/7.x, defu, picomatch 2.x/4.x, yaml, smol-toml, flatted, undici to resolve 27 Dependabot alerts. Removed stale overrides for lodash and @isaacs/brace-expansion (no longer in dependency tree). Check with: pnpm why h3 diff tar fast-xml-parser axios vite defu picomatch yaml smol-toml flatted undici -r"
  }
}
