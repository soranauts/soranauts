apps/web/src/pages/changelog.astro
apps/web/src/pages/improvements.md

# --- AI assistant / tooling ---
.claude/
docs/claude-reference/00-START-HERE.md
docs/claude-reference/CHECKLIST.md
docs/claude-reference/COMMANDS.md
docs/claude-reference/GENERATION_SUMMARY.md
docs/claude-reference/INDEX.md

# --- Soranauts KB (local artifacts, do not commit) ---
# Build artifacts (reproducible from curated content)
knowledge_base/.kb_index/
knowledge_base/index.baseline/
knowledge_base/**/*.sqlite3
knowledge_base/**/*.bin
knowledge_base/**/*.log
# Raw source mirrors (not ingested directly)
knowledge_base/sources/fearless_github/android/
knowledge_base/sources/fearless_github/ios/
# BCK (Blockchain Kaigi) PDFs and RIS files (raw sources, not ingested)
knowledge_base/sources/bck*/**/*.pdf
knowledge_base/sources/bck*/**/*.ris
# Embedded git repos (handled by sync scripts)
knowledge_base/curated/wiki/
knowledge_base/curated/iroha_docs/
# Metadata files
knowledge_base/scripts/.meta/
# Scraped images (large, can be re-generated)
knowledge_base/curated/soramitsu_site/images/
knowledge_base/curated/ecosystem_updates/images/
knowledge_base/curated/polkaswap_updates/images/
knowledge_base/curated/fearless_updates/images/
knowledge_base/curated/tonswap_site/images/
knowledge_base/curated/tonswap_updates/images/
# Daily synced content (auto-generated, do not commit)
# These directories are populated by nightly sync workflow
knowledge_base/curated/ecosystem_updates/
knowledge_base/curated/polkaswap_updates/
knowledge_base/curated/fearless_updates/
knowledge_base/curated/tonswap_updates/
knowledge_base/curated/soramitsu_site/
knowledge_base/curated/tonswap_site/
knowledge_base/curated/articles/
# Community memos PDFs (large files, markdown versions are committed)
knowledge_base/curated/community-memos/**/*.pdf
# Keep only specific KB files (docs, configs, scripts)
!knowledge_base/README.md
!knowledge_base/KB_STANDARDS.md
!knowledge_base/KB_REFACTOR_REPORT.md
!knowledge_base/**/*.txt
!knowledge_base/**/*.ts
!knowledge_base/**/*.js
!knowledge_base/**/*.json
!knowledge_base/docs/**/*.md
!knowledge_base/scripts/**/*.md
# Keep root-level documentation files
!knowledge_base/*.md
!BACKUP_INFO_*.txt
