# build output
dist/
.output/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

package-lock.json

.astro

# --- Soranauts KB (local artifacts, do not commit) ---
# Auto-generated/synced content (daily sync via GitHub Actions)
knowledge_base/index/
knowledge_base/index.baseline/
knowledge_base/index/.embedding_cache/
knowledge_base/**/*.sqlite3
knowledge_base/**/*.bin
knowledge_base/**/*.log
# Embedded git repos (handled by sync scripts)
knowledge_base/wiki/
knowledge_base/iroha_docs/
# Fearless GitHub cloned repos (handled by sync scripts)
knowledge_base/fearless_github/android/
knowledge_base/fearless_github/ios/
# Metadata files
knowledge_base/scripts/.meta/
# Scraped images (large, can be re-generated)
knowledge_base/soramitsu_site/images/
knowledge_base/ecosystem_updates/images/
knowledge_base/polkaswap_updates/images/
knowledge_base/fearless_updates/images/
knowledge_base/tonswap_site/images/
knowledge_base/tonswap_updates/images/
# Daily synced content (auto-generated, do not commit)
# These directories are populated by nightly sync workflow
knowledge_base/ecosystem_updates/
knowledge_base/polkaswap_updates/
knowledge_base/fearless_updates/
knowledge_base/tonswap_updates/
knowledge_base/soramitsu_site/
knowledge_base/tonswap_site/
knowledge_base/articles/
# Keep only specific KB files (docs, configs, scripts)
!knowledge_base/README.md
!knowledge_base/**/*.txt
!knowledge_base/**/*.ts
!knowledge_base/**/*.js
!knowledge_base/**/*.json
!knowledge_base/docs/**/*.md
!knowledge_base/scripts/**/*.md
# Keep root-level documentation files
!knowledge_base/*.md